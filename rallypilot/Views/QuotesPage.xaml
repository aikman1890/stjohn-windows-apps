<Page
    x:Class="RallyPilot.Views.QuotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RallyPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Quote book" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Tiered quotes with deposit terms and a follow-up clock on every unanswered quote - the corporate pipeline nobody in this category tracks. Win one and it becomes the event file in one press." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="QuoteList" SelectionChanged="QuoteList_SelectionChanged" MaxHeight="250">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Quote">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                            <Ellipse Width="12" Height="12" Fill="{x:Bind FlagBrush}" VerticalAlignment="Center" />
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{x:Bind CompanyLabel}" FontWeight="SemiBold" />
                                <Run Text=" - " />
                                <Run Text="{x:Bind PackageLabel}" />
                                <Run Text=" - " />
                                <Run Text="{x:Bind StatusLine}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="TotalText" FontWeight="SemiBold" />
            <Grid MaxWidth="880" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="CompanyBox" Grid.Row="0" Grid.Column="0" Header="Company" Margin="0,0,8,8" />
                <TextBox x:Name="OrganizerBox" Grid.Row="0" Grid.Column="1" Header="Organizer" Margin="0,0,0,8" />
                <ComboBox x:Name="PackageBox" Grid.Row="1" Grid.Column="0" Header="Package" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                <TextBox x:Name="HeadsBox" Grid.Row="1" Grid.Column="1" Header="Heads (tier)" Margin="0,0,0,8" />
                <CalendarDatePicker x:Name="EventPicker" Grid.Row="2" Grid.Column="0" Header="Event date" Margin="0,0,8,8" />
                <TextBox x:Name="TermsBox" Grid.Row="2" Grid.Column="1" Header="Deposit terms" Margin="0,0,0,8" />
                <ComboBox x:Name="StatusBox" Grid.Row="3" Grid.Column="0" Header="Status" HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button x:Name="SaveButton" Content="Save quote" Click="SaveButton_Click" />
                    <Button x:Name="NewButton" Content="New" Click="NewButton_Click" />
                    <Button x:Name="WinButton" Content="Won - create event file" Click="WinButton_Click" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Quote lines" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListView x:Name="LineList" SelectionMode="None" MaxHeight="160">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:QuoteLine">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="LineLabelBox" Header="Line" Width="300" />
                <TextBox x:Name="LineQtyBox" Header="Qty" Width="90" />
                <TextBox x:Name="LinePriceBox" Header="Unit price" Width="110" />
                <Button x:Name="LineButton" Content="Add line" Click="LineButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
