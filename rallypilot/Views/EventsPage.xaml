<Page
    x:Class="RallyPilot.Views.EventsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RallyPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Event files &amp; balance ledger" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="The won event as one record: organizer, headcount expected vs confirmed, deposit and balance with due-date clocks, special requirements, and the post-event follow-up that feeds next year's pipeline." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="EventList" SelectionChanged="EventList_SelectionChanged" MaxHeight="260">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:RallyEvent">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                            <Ellipse Width="12" Height="12" Fill="{x:Bind FlagBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="LedgerText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <Grid MaxWidth="900" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="CompanyBox" Grid.Row="0" Grid.Column="0" Header="Company" Margin="0,0,8,8" />
                <TextBox x:Name="OrganizerBox" Grid.Row="0" Grid.Column="1" Header="Organizer + contact" Margin="0,0,0,8" />
                <CalendarDatePicker x:Name="DatePicker" Grid.Row="1" Grid.Column="0" Header="Event date" Margin="0,0,8,8" />
                <TextBox x:Name="HeadsBox" Grid.Row="1" Grid.Column="1" Header="Heads: expected,confirmed" Margin="0,0,0,8" />
                <TextBox x:Name="QuotedBox" Grid.Row="2" Grid.Column="0" Header="Quoted total" Margin="0,0,8,8" />
                <TextBox x:Name="DepositBox" Grid.Row="2" Grid.Column="1" Header="Deposit: due,paid" Margin="0,0,0,8" />
                <TextBox x:Name="PaymentsBox" Grid.Row="3" Grid.Column="0" Header="Further payments received" Margin="0,0,8,8" />
                <CalendarDatePicker x:Name="BalancePicker" Grid.Row="3" Grid.Column="1" Header="Balance due date" Margin="0,0,0,8" />
                <TextBox x:Name="ReqBox" Grid.Row="4" Grid.Column="0" Header="Special requirements (dietary, transport, AV, awards)" Margin="0,0,8,8" />
                <ComboBox x:Name="StatusBox" Grid.Row="4" Grid.Column="1" Header="Status" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save event" Click="SaveButton_Click" />
                    <Button x:Name="NewButton" Content="New" Click="NewButton_Click" />
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button x:Name="ThanksButton" Content="Thank-you sent + set rebook prompt (11 months)" Click="ThanksButton_Click" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="FollowText" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
            <TextBlock Text="Day-of add-ons sold (feed the final invoice)" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListView x:Name="SaleList" SelectionMode="None" MaxHeight="150">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AddOnSale">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="SaleLabelBox" Header="Add-on" Width="260" />
                <TextBox x:Name="SaleQtyBox" Header="Qty" Width="80" />
                <TextBox x:Name="SalePriceBox" Header="Unit price" Width="110" />
                <Button x:Name="SaleButton" Content="Record sale" Click="SaleButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
