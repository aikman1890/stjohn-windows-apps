<Page
    x:Class="RallyPilot.Views.OrganizersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RallyPilot.Models">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
            <TextBlock Text="Organizer book" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Corporate clients and organizers across events: who books annually, typical size, lifetime value. The rebooking list, owned by you - not rented from a platform. A record and a rebook list, not a marketing-automation suite." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="OrgList" SelectionChanged="OrgList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Organizer">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="NewButton" Content="New organizer" Click="NewButton_Click" HorizontalAlignment="Left" />
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Organizer file" FontSize="19" FontWeight="SemiBold" />
                <TextBlock x:Name="LtvText" TextWrapping="Wrap" />
                <TextBox x:Name="CompanyBox" Header="Company" />
                <TextBox x:Name="ContactNameBox" Header="Organizer name" />
                <TextBox x:Name="ContactBox" Header="Contact" />
                <TextBox x:Name="SizeBox" Header="Typical size" />
                <TextBox x:Name="AnnualBox" Header="Booking pattern (e.g. books annually - Q4)" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="56" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save organizer" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
