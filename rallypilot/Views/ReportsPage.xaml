<Page
    x:Class="RallyPilot.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Balance close &amp; event report" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Quoted vs final, deposits, add-ons, balance collected, per-head realized revenue - so the final invoice matches what actually happened on the ground." Opacity="0.7" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="EventBox" Header="Event" Width="480" />
                <Button x:Name="ExportButton" Content="Export close report (HTML)" Click="ExportButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="PreviewText" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
