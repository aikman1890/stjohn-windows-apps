<Page
    x:Class="EntityPilot.Views.DocumentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EntityPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Document index" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Where each entity's papers live: formation docs, operating agreement or bylaws, EIN letter, annual filings - as local paths and filed dates. EntityPilot indexes your files; it fetches nothing from any state." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="DocList" SelectionChanged="DocList_SelectionChanged" MaxHeight="300">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DocRef">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid MaxWidth="820" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="EntityBox" Grid.Row="0" Grid.Column="0" Header="Entity" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                <ComboBox x:Name="KindBox" Grid.Row="0" Grid.Column="1" Header="Kind" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                <TextBox x:Name="TitleBox" Grid.Row="1" Grid.Column="0" Header="Title" Margin="0,0,8,8" />
                <CalendarDatePicker x:Name="FiledPicker" Grid.Row="1" Grid.Column="1" Header="Filed / received date" Margin="0,0,0,8" />
                <TextBox x:Name="PathBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Header="Local path or reference" Margin="0,0,0,8" />
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BrowseButton" Content="Browse for file..." Click="BrowseButton_Click" />
                    <Button x:Name="SaveButton" Content="Save index entry" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="NewButton" Content="New" Click="NewButton_Click" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
