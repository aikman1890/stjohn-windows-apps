<Page
    x:Class="EntityPilot.Views.OwnershipPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EntityPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Ownership &amp; officers" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Changes supersede - the old stake stays on the record with its date, so the cap table's history is the record. Active stakes per class should sum to 100%; the view says so when they don't." Opacity="0.7" TextWrapping="Wrap" />
            <ComboBox x:Name="EntityBox" Header="Entity" Width="380" />
            <TextBlock x:Name="SumText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ListView x:Name="StakeList" SelectionChanged="StakeList_SelectionChanged" MaxHeight="200">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:OwnershipStake">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid MaxWidth="820" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="OwnerBox" Grid.Row="0" Grid.Column="0" Header="Owner name" Margin="0,0,8,8" />
                <TextBox x:Name="ClassBox" Grid.Row="0" Grid.Column="1" Header="Class" Margin="0,0,0,8" />
                <TextBox x:Name="PercentBox" Grid.Row="1" Grid.Column="0" Header="Percent (%)" Margin="0,0,8,8" />
                <TextBox x:Name="ContribBox" Grid.Row="1" Grid.Column="1" Header="Capital contribution ($)" Margin="0,0,0,8" />
                <CalendarDatePicker x:Name="EffPicker" Grid.Row="2" Grid.Column="0" Header="Effective date" Margin="0,0,8,8" />
                <TextBox x:Name="StakeNoteBox" Grid.Row="2" Grid.Column="1" Header="Note (admission, transfer...)" Margin="0,0,0,8" />
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveStakeButton" Content="Save stake" Click="SaveStakeButton_Click" />
                    <Button x:Name="SupersedeButton" Content="Supersede selected (dated change)" Click="SupersedeButton_Click" />
                    <Button x:Name="NewStakeButton" Content="New stake" Click="NewStakeButton_Click" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Officers / managers" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ListView x:Name="OfficerList" SelectionMode="None" MaxHeight="140">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="OfficerNameBox" Header="Name" Width="220" />
                <TextBox x:Name="OfficerRoleBox" Header="Role" Width="200" />
                <Button x:Name="OfficerButton" Content="Add officer" Click="OfficerButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
