<Page
    x:Class="EntityPilot.Views.IntercompanyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EntityPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Intercompany ledger" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Loans and transfers between your own entities, with the balance per pair - the spreadsheet page that always goes stale first, made structural. Records only: terms are what you enter; no interest is computed for you." Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock Text="Balances per pair" FontSize="17" FontWeight="SemiBold" />
            <ListView x:Name="BalanceList" SelectionMode="None" MaxHeight="170">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="All entries" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ListView x:Name="EntryList" SelectionChanged="EntryList_SelectionChanged" MaxHeight="220">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:IntercompanyEntry">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid MaxWidth="820" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="FromBox" Grid.Row="0" Grid.Column="0" Header="From entity" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                <ComboBox x:Name="ToBox" Grid.Row="0" Grid.Column="1" Header="To entity" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                <ComboBox x:Name="KindBox" Grid.Row="1" Grid.Column="0" Header="Kind" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                <TextBox x:Name="AmountBox" Grid.Row="1" Grid.Column="1" Header="Amount ($)" Margin="0,0,0,8" />
                <CalendarDatePicker x:Name="DatePicker" Grid.Row="2" Grid.Column="0" Header="Date" Margin="0,0,8,8" />
                <TextBox x:Name="TermsBox" Grid.Row="2" Grid.Column="1" Header="Terms note" Margin="0,0,0,8" />
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save entry" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="NewButton" Content="New entry" Click="NewButton_Click" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
