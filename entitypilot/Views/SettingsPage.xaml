<Page
    x:Class="EntityPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBox x:Name="OwnerBox" Header="Owner / portfolio name (prints on summaries)" />
            <TextBox x:Name="OrangeBox" Header="Orange warning window (days before a deadline)" />
            <TextBlock Text="State starter templates (one per line: ST|Obligation|Typical timing note|Reviewed yyyy-MM-dd)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="TemplatesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="150" />
            <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="SavedText" Opacity="0.75" />
            <TextBlock Text="EntityPilot tracks deadlines and records the confirmations you enter. It does not file anything, touch any state portal, verify any status live, act as a registered agent, do accounting, or give legal or tax advice. Templates are starting points - confirm every date on your state's official portal. Passwords are never stored here; portal fields hold pointers only (e.g. 'password in vault'). EINs stay on this machine, masked by default, and are excluded from exports unless you deliberately opt in." Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
