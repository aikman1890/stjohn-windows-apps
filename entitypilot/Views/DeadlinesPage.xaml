<Page
    x:Class="EntityPilot.Views.DeadlinesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EntityPilot.Models">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
            <TextBlock Text="All deadlines, every entity" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="One calendar for the whole portfolio - the screen that answers 'what is due in the next 90 days, everywhere?'" Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="ObligationList" SelectionChanged="ObligationList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Obligation">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="NewButton" Content="New deadline" Click="NewButton_Click" HorizontalAlignment="Left" />
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Deadline" FontSize="19" FontWeight="SemiBold" />
                <ComboBox x:Name="EntityBox" Header="Entity" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="KindBox" Header="Kind" HorizontalAlignment="Stretch" />
                <TextBox x:Name="TitleBox" Header="Title (e.g. WY annual report)" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CalendarDatePicker x:Name="DuePicker" Grid.Column="0" Header="Due date" Margin="0,0,8,0" />
                    <CheckBox x:Name="RecurCheck" Grid.Column="1" Content="Recurs yearly (marking done rolls it forward)" VerticalAlignment="Bottom" />
                </Grid>
                <TextBox x:Name="NoteBox" Header="Note (portal, fee, confirmation number when done)" AcceptsReturn="True" TextWrapping="Wrap" Height="52" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save deadline" Click="SaveButton_Click" />
                    <Button x:Name="DoneButton" Content="Mark done" Click="DoneButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />

                <TextBlock Text="State starter templates" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,0" />
                <TextBlock Text="Starting points only - each state's own month, portal, and penalty differ. CONFIRM every date against your state's official portal before relying on it; EntityPilot never claims deadline authority." Opacity="0.7" TextWrapping="Wrap" />
                <ListView x:Name="TemplateList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
