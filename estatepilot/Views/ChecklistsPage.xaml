<Page
    x:Class="EstatePilot.Views.ChecklistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EstatePilot.Models">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
            <TextBlock Text="Checklist runs (proof)" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Every run is a dated completion record - the proof ledger for the invisible work." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="RunList">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChecklistRun">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Run a checklist" FontSize="19" FontWeight="SemiBold" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="PropertyBox" Grid.Column="0" Header="Property" HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                    <ComboBox x:Name="TemplateBox" Grid.Column="1" Header="Checklist" HorizontalAlignment="Stretch" Margin="0,0,0,0" />
                </Grid>
                <Button x:Name="LoadButton" Content="Load checklist" Click="LoadButton_Click" HorizontalAlignment="Left" />
                <StackPanel x:Name="ItemsPanel" Spacing="4" />
                <TextBox x:Name="RunNoteBox" Header="Run note (arrival date, guests, anything unusual)" />
                <Button x:Name="SaveRunButton" Content="Save this run (dated proof)" Click="SaveRunButton_Click" HorizontalAlignment="Left" />
                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
