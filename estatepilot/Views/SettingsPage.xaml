<Page
    x:Class="EstatePilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBox x:Name="ManagerBox" Header="Manager / firm name (prints on exports)" />
            <TextBox x:Name="AddressBox" Header="Address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
            <TextBox x:Name="PhoneBox" Header="Phone" />
            <TextBlock Text="Checklist templates (one per line: Name|item; item; item)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="TemplatesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="130" />
            <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="SavedText" Opacity="0.75" />
            <TextBlock Text="EstatePilot is the manager's private book: no staff accounts or messaging, no payroll or HR functions, no financial management, no smart-home or security integration - and by deliberate design it NEVER stores alarm codes, safe combinations, gate codes, or passwords. Access is recorded as pointers only ('keys held by the house manager'). Employment, insurance, and safety compliance remain the responsibility of the household and its advisors." Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
