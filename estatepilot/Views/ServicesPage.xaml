<Page
    x:Class="EstatePilot.Views.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EstatePilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Maintenance clocks" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Recurring services per property. Next due is computed from the last-done entry - completing a service rolls its clock forward by its interval." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="ClockList" SelectionChanged="ClockList_SelectionChanged" MaxHeight="280">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ServiceClock">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                            <Ellipse Width="12" Height="12" Fill="{x:Bind FlagBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid MaxWidth="840" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="PropertyBox" Grid.Row="0" Grid.Column="0" Header="Property" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1" Header="Service (HVAC, generator, pool, chimney, septic, elevator...)" Margin="0,0,0,8" />
                <CalendarDatePicker x:Name="DuePicker" Grid.Row="1" Grid.Column="0" Header="Next due" Margin="0,0,8,8" />
                <TextBox x:Name="IntervalBox" Grid.Row="1" Grid.Column="1" Header="Interval (months)" Margin="0,0,0,8" />
                <TextBox x:Name="NoteBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Header="Note (vendor, contract reference)" Margin="0,0,0,8" />
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save clock" Click="SaveButton_Click" />
                    <Button x:Name="DoneButton" Content="Mark serviced today" Click="DoneButton_Click" />
                    <Button x:Name="NewButton" Content="New clock" Click="NewButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
