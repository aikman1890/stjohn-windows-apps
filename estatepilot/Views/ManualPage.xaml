<Page
    x:Class="EstatePilot.Views.ManualPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
            <TextBlock Text="House manual" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="The artifact that survives staff turnover. Search it, print it for handover - it never sits in a vendor's cloud." Opacity="0.7" TextWrapping="Wrap" />
            <ComboBox x:Name="PropertyFilterBox" Header="Property" HorizontalAlignment="Stretch" />
            <TextBox x:Name="SearchBox" Header="Search the manual" />
            <ListView x:Name="SectionList" SelectionChanged="SectionList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="ExportButton" Content="Export manual (HTML, for print/handover)" Click="ExportButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Manual section" FontSize="19" FontWeight="SemiBold" />
                <ComboBox x:Name="SectionKindBox" Header="Section type" HorizontalAlignment="Stretch" />
                <TextBox x:Name="TitleBox" Header="Title" />
                <TextBox x:Name="BodyBox" Header="Body" AcceptsReturn="True" TextWrapping="Wrap" Height="220" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save section" Click="SaveButton_Click" />
                    <Button x:Name="NewButton" Content="New section" Click="NewButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
