<Page
    x:Class="EstatePilot.Views.JobsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EstatePilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Project &amp; job ledger" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Work done per property, with warranty clocks. The record that answers an owner's 'when was the roof last done and what did it cost?' Costs only - this is not financial management." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="JobList" SelectionChanged="JobList_SelectionChanged" MaxHeight="280">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:JobEntry">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid MaxWidth="860" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="PropertyBox" Grid.Row="0" Grid.Column="0" Header="Property" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                <TextBox x:Name="VendorBox" Grid.Row="0" Grid.Column="1" Header="Vendor" Margin="0,0,0,8" />
                <TextBox x:Name="WorkBox" Grid.Row="1" Grid.Column="0" Header="Work done" Margin="0,0,8,8" />
                <CalendarDatePicker x:Name="DatePicker" Grid.Row="1" Grid.Column="1" Header="Date" Margin="0,0,0,8" />
                <TextBox x:Name="CostBox" Grid.Row="2" Grid.Column="0" Header="Cost" Margin="0,0,8,8" />
                <TextBox x:Name="InvoiceBox" Grid.Row="2" Grid.Column="1" Header="Invoice reference" Margin="0,0,0,8" />
                <CalendarDatePicker x:Name="WarrantyPicker" Grid.Row="3" Grid.Column="0" Header="Warranty expiry (if any)" Margin="0,0,8,8" />
                <TextBox x:Name="CurrencyBox" Grid.Row="3" Grid.Column="1" Header="Currency" Margin="0,0,0,8" />
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save job" Click="SaveButton_Click" />
                    <Button x:Name="NewButton" Content="New job" Click="NewButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ExportButton" Content="Export property ledger (HTML)" Click="ExportButton_Click" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
