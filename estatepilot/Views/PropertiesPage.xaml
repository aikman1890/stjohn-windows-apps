<Page
    x:Class="EstatePilot.Views.PropertiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
            <TextBlock Text="Properties" FontSize="22" FontWeight="SemiBold" />
            <ListView x:Name="PropertyList" SelectionChanged="PropertyList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="NewButton" Content="New property" Click="NewButton_Click" HorizontalAlignment="Left" />
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Property file" FontSize="19" FontWeight="SemiBold" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="0" Header="House label" Margin="0,0,8,8" />
                    <ComboBox x:Name="TypeBox" Grid.Row="0" Grid.Column="1" Header="Type" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                    <TextBox x:Name="AddressBox" Grid.Row="1" Grid.Column="0" Header="Address" Margin="0,0,8,8" />
                    <TextBox x:Name="NotesBox" Grid.Row="1" Grid.Column="1" Header="Notes" Margin="0,0,0,8" />
                </Grid>
                <TextBox x:Name="SystemsBox" Header="Key systems (what exists + who services it)" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                <TextBox x:Name="AccessBox" Header="Access pointers ONLY (e.g. 'keys held by the house manager') - codes and passwords are never recorded in this app" AcceptsReturn="True" TextWrapping="Wrap" Height="48" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save property" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
                <TextBlock Text="Document vault (local paths: manuals, warranties, service contracts, floor plans)" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
                <ListView x:Name="DocList" SelectionMode="None" MaxHeight="140">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="DocKindBox" Header="Kind" Width="170" />
                    <TextBox x:Name="DocTitleBox" Header="Title" Width="220" />
                    <TextBox x:Name="DocPathBox" Header="Local path" Width="280" />
                    <Button x:Name="DocButton" Content="Add" Click="DocButton_Click" VerticalAlignment="Bottom" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
