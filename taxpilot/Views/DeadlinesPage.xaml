<Page
    x:Class="TaxPilot.Views.DeadlinesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Deadline tables" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="These dates are DATA, not authority: federal defaults ship as a starting point labeled with an as-of note, and you confirm and edit them. State dates are yours alone - TaxPilot ships no 50-state table. Filing year is tax year + 1." Opacity="0.8" TextWrapping="Wrap" />
            <TextBox x:Name="AsOfBox" Header="As-of label (shows with the tables)" />
            <TextBlock Text="Federal table - one line per entity: Entity|Due MM-DD|Extension MM-DD" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBox x:Name="TableBox" AcceptsReturn="True" TextWrapping="Wrap" Height="150" />
            <TextBlock Text="Document checklist templates - one line per entity: Entity|Doc|Doc|..." FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBox x:Name="TemplatesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="130" />
            <TextBlock Text="Your state jurisdictions &amp; dates (free text, one per line)" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBox x:Name="StateBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
            <Button x:Name="SaveButton" Content="Save tables" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="SavedText" Opacity="0.75" />
        </StackPanel>
    </ScrollViewer>
</Page>
