<Page
    x:Class="TaxPilot.Views.ClientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Client" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="NameBox" Header="Client name" />
                <ComboBox x:Name="KindCombo" Header="Kind" HorizontalAlignment="Stretch">
                    <x:String>Individual</x:String>
                    <x:String>Business</x:String>
                </ComboBox>
                <ComboBox x:Name="EntityCombo" Header="Entity / return type" HorizontalAlignment="Stretch" />
                <TextBox x:Name="ContactBox" Header="Contact person" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="EmailBox" Header="Email" Width="185" />
                    <TextBox x:Name="PhoneBox" Header="Phone" Width="165" />
                </StackPanel>
                <TextBox x:Name="CarryBox" Header="Carry-forward notes for next season (K-1 expected, rental sold...)" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <Button x:Name="EngageButton" Content="Open engagement for the current tax year" Click="EngageButton_Click" />
                <TextBlock Text="Season rollover &amp; export" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock Text="Rollover copies every client into the target tax year with statuses reset - carry-forward notes ride along. Seasons never overwrite each other." Opacity="0.78" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="RollYearBox" Header="Roll into tax year" Width="150" />
                    <Button x:Name="RollButton" Content="Roll season over" Click="RollButton_Click" VerticalAlignment="Bottom" />
                </StackPanel>
                <Button x:Name="ExportButton" Content="Export season packet (HTML)" Click="ExportButton_Click" />
                <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EntityType}" Opacity="0.75" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
