<Page
    x:Class="TaxPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBox x:Name="OfficeBox" Header="Office name (prints on the season packet)" />
            <TextBox x:Name="AddressBox" Header="Office address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
            <TextBox x:Name="PhoneBox" Header="Office phone" />
            <TextBox x:Name="YearBox" Header="Current tax year (the season on the Dashboard)" />
            <TextBlock Text="Entity / return types (one per line)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="EntitiesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="110" />
            <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="SavedText" Opacity="0.75" />
            <TextBlock Text="Everything is stored locally in this app's folder - no account, no cloud, no telemetry. Your client list never leaves your office." Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
