<Page
    x:Class="TaxPilot.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="TaxPilot" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="OfficeText" Opacity="0.8" TextWrapping="Wrap" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Pipeline (current season)" FontWeight="SemiBold" Opacity="0.75" />
                        <TextBlock x:Name="PipelineText" FontSize="15" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Deadlines, docs &amp; fees" FontWeight="SemiBold" Opacity="0.75" />
                        <TextBlock x:Name="ChaseText" FontSize="15" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="Next deadlines" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ListView x:Name="DueList" SelectionMode="None" MaxHeight="280">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" Foreground="{Binding DueBrush}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
