<Page
    x:Class="TaxPilot.Views.ContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Appointment &amp; contact log" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="ClientPicker" Header="Client" HorizontalAlignment="Stretch" />
                <DatePicker x:Name="DatePickerCtl" Header="Date" />
                <TextBox x:Name="WhoBox" Header="Who (client, spouse, bookkeeper...)" />
                <TextBox x:Name="SummaryBox" Header="What was discussed" AcceptsReturn="True" TextWrapping="Wrap" Height="56" />
                <TextBox x:Name="PromisedBox" Header="What was promised (and by when)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="Saving a contact also stamps the engagement's last-contacted date, which drives the chase view." Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
