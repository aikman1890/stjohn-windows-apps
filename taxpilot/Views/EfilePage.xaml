<Page
    x:Class="TaxPilot.Views.EfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="E-file status log" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="TaxPilot records the status your e-file software reports back - it transmits nothing itself." Opacity="0.75" TextWrapping="Wrap" />
                <ComboBox x:Name="EngagementPicker" Header="Engagement" HorizontalAlignment="Stretch" />
                <TextBox x:Name="MethodBox" Header="Method (prep software, IRS FIRE...)" />
                <ComboBox x:Name="ResultCombo" Header="Result" HorizontalAlignment="Stretch">
                    <x:String>Submitted</x:String>
                    <x:String>Accepted</x:String>
                    <x:String>Rejected</x:String>
                </ComboBox>
                <TextBox x:Name="CodeBox" Header="Rejection code (if rejected)" />
                <TextBox x:Name="NoteBox" Header="Note / fix made" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save entry" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
