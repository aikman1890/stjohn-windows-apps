<Page
    x:Class="TaxPilot.Views.EngagementsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Engagement (one row per client-year)" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="ClientText" Header="Client" IsReadOnly="True" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="YearBox" Header="Tax year" Width="120" />
                    <TextBox x:Name="EntityBox" Header="Return type" Width="120" />
                </StackPanel>
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch">
                    <x:String>Not started</x:String>
                    <x:String>Docs pending</x:String>
                    <x:String>In prep</x:String>
                    <x:String>In review</x:String>
                    <x:String>Ready to file</x:String>
                    <x:String>Filed</x:String>
                    <x:String>Accepted</x:String>
                    <x:String>Rejected-fix</x:String>
                    <x:String>Extended</x:String>
                    <x:String>Done</x:String>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="FeeBox" Header="Fee quoted $" Width="150" />
                    <TextBox x:Name="PaidBox" Header="Fee paid $" Width="150" />
                </StackPanel>
                <CheckBox x:Name="ExtCheck" Content="Extension filed (extended deadline applies)" Checked="ExtCheck_Changed" Unchecked="ExtCheck_Changed" />
                <CheckBox x:Name="PersonalCheck" Content="Use a personal due date for this client" Checked="PersonalCheck_Changed" Unchecked="PersonalCheck_Changed" />
                <DatePicker x:Name="PersonalPicker" Header="Personal due date" IsEnabled="False" />
                <TextBlock x:Name="DueText" TextWrapping="Wrap" Opacity="0.85" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" Foreground="{Binding DueBrush}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
