<Page
    x:Class="TaxPilot.Views.DocsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Document checklist" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="TaxPilot tracks THAT a document arrived and where the office files it - the documents themselves are never stored in the app." Opacity="0.75" TextWrapping="Wrap" />
                <ComboBox x:Name="EngagementPicker" Header="Engagement" HorizontalAlignment="Stretch" SelectionChanged="EngagementPicker_SelectionChanged" />
                <Button x:Name="TemplateButton" Content="Apply the entity checklist template" Click="TemplateButton_Click" HorizontalAlignment="Left" />
                <TextBox x:Name="DocBox" Header="Document label" />
                <TextBox x:Name="RefBox" Header="Filed at (path / folder reference)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddButton" Content="Add document line" Click="AddButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete selected" Click="DeleteButton_Click" />
                </StackPanel>
                <ListView x:Name="ChecklistList" SelectionChanged="ChecklistList_SelectionChanged" MaxHeight="260">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <CheckBox x:Name="ReceivedCheck" Content="Received (stamps today's date)" Checked="ReceivedCheck_Changed" Unchecked="ReceivedCheck_Changed" />
                <TextBlock Text="Chase view - every missing document, oldest engagement contact first" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ChaseList" Grid.Column="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
