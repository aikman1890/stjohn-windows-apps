<Page
    x:Class="HuntPilot.Views.HuntersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HuntPilot.Models">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
            <TextBlock Text="Hunter records" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="One file per hunter across the years - license as recorded by the ranch, party, preferences, and lifetime value from the hunt book. Repeat clients are the business; this is their file." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="HunterList" SelectionChanged="HunterList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Hunter">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                            <Ellipse Width="12" Height="12" Fill="{x:Bind FlagBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="NewButton" Content="New hunter" Click="NewButton_Click" HorizontalAlignment="Left" />
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Hunter file" FontSize="19" FontWeight="SemiBold" />
                <TextBlock x:Name="HistoryText" TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="0" Header="Name" Margin="0,0,8,8" />
                    <TextBox x:Name="ContactBox" Grid.Row="0" Grid.Column="1" Header="Contact" Margin="0,0,0,8" />
                    <TextBox x:Name="LicenseBox" Grid.Row="1" Grid.Column="0" Header="License number (as recorded)" Margin="0,0,8,8" />
                    <TextBox x:Name="StateBox" Grid.Row="1" Grid.Column="1" Header="License state" Margin="0,0,0,8" />
                    <CalendarDatePicker x:Name="ExpiryPicker" Grid.Row="2" Grid.Column="0" Header="License expiry" Margin="0,0,8,0" />
                    <TextBox x:Name="PartyBox" Grid.Row="2" Grid.Column="1" Header="Party members" Margin="0,0,0,0" />
                </Grid>
                <TextBox x:Name="PrefsBox" Header="Preferences (species wishlist, lodging, dietary)" AcceptsReturn="True" TextWrapping="Wrap" Height="56" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="48" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save hunter" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
