<Page
    x:Class="HuntPilot.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Season report" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="The owner's season review and the repeat-marketing list in one artifact: hunts, harvests by species, revenue, balances outstanding, trophies outstanding by stage." Opacity="0.7" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="YearBox" Header="Season year" Width="130" />
                <Button x:Name="ExportButton" Content="Export season report (HTML)" Click="ExportButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="PreviewText" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
