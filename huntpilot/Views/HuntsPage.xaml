<Page
    x:Class="HuntPilot.Views.HuntsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HuntPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Hunt book &amp; balance ledger" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Deposit at booking, trophy fees added as harvested, payments as they land - the balance is always the arithmetic, never a memory. Waiver status is registered here (fact and version of signing), the same gate pattern as the rest of the line." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="HuntList" SelectionChanged="HuntList_SelectionChanged" MaxHeight="270">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:HuntBooking">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid MaxWidth="900" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="HunterBox" Grid.Row="0" Grid.Column="0" Header="Hunter" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                <TextBox x:Name="GuideBox" Grid.Row="0" Grid.Column="1" Header="Guide" Margin="0,0,0,8" />
                <CalendarDatePicker x:Name="StartPicker" Grid.Row="1" Grid.Column="0" Header="Start date" Margin="0,0,8,8" />
                <CalendarDatePicker x:Name="EndPicker" Grid.Row="1" Grid.Column="1" Header="End date" Margin="0,0,0,8" />
                <TextBox x:Name="SpeciesBox" Grid.Row="2" Grid.Column="0" Header="Species targeted" Margin="0,0,8,8" />
                <TextBox x:Name="PackageBox" Grid.Row="2" Grid.Column="1" Header="Package" Margin="0,0,0,8" />
                <TextBox x:Name="PriceBox" Grid.Row="3" Grid.Column="0" Header="Package price" Margin="0,0,8,8" />
                <TextBox x:Name="DepositBox" Grid.Row="3" Grid.Column="1" Header="Deposit received" Margin="0,0,0,8" />
                <TextBox x:Name="ExtraBox" Grid.Row="4" Grid.Column="0" Header="Extra charges" Margin="0,0,8,8" />
                <TextBox x:Name="PaymentsBox" Grid.Row="4" Grid.Column="1" Header="Further payments received" Margin="0,0,0,8" />
                <TextBox x:Name="LodgeBox" Grid.Row="5" Grid.Column="0" Header="Lodging: nights x non-hunter guests x rate/night" Margin="0,0,8,8" />
                <ComboBox x:Name="WaiverBox" Grid.Row="5" Grid.Column="1" Header="Waiver status" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                <TextBox x:Name="ArrivalBox" Grid.Row="6" Grid.Column="0" Header="Arrival note (flight, pickup, ETA)" Margin="0,0,8,0" />
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <ComboBox x:Name="StatusBox" Header="Status" Width="130" />
                    <Button x:Name="SaveButton" Content="Save hunt" Click="SaveButton_Click" />
                    <Button x:Name="NewButton" Content="New" Click="NewButton_Click" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Lodging format: nights,guests,rate - e.g. 2,1,500. Trophy fees are added from the harvest log." Opacity="0.6" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
