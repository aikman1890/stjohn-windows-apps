<Page
    x:Class="HuntPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBox x:Name="NameBox" Header="Ranch name (prints on the season report)" />
            <TextBox x:Name="AddressBox" Header="Address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
            <TextBox x:Name="PhoneBox" Header="Phone" />
            <TextBox x:Name="CurrencyBox" Header="Default currency" />
            <TextBox x:Name="NormBox" Header="Trophy stage norm (days per stage before orange)" />
            <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="SavedText" Opacity="0.75" />
            <TextBlock Text="HuntPilot is the ranch's hunt and trophy book: no online booking, no deposits or payments processed, and no client portal. It records the license details and seasons the ranch enters and offers no hunting-regulation or license advice - records tool, not legal or compliance advice. No herd-management or wildlife-biology suite." Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
