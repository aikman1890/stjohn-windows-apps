<Page
    x:Class="GameVault.Views.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Game library" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="FolderText" Text="No folder chosen yet." TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ChooseFolderButton" Content="Choose games folder" Click="ChooseFolderButton_Click" />
                    <Button x:Name="RescanButton" Content="Rescan" Click="RescanButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />

                <TextBlock Text="Selected game" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox x:Name="TitleBox" Header="Title" />
                <TextBox x:Name="GenreBox" Header="Genre" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save changes" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Remove from catalog" Click="DeleteButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="LaunchButton" Content="Launch selected" Click="LaunchButton_Click" />
                    <Button x:Name="ShowButton" Content="Show in Explorer" Click="ShowButton_Click" />
                </StackPanel>
                <TextBlock Text="Launching runs EXE and HTML builds directly. ZIP builds open in Explorer so you can extract and play."
                           TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubLine}" Opacity="0.75" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
