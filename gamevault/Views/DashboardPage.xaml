<Page
    x:Class="GameVault.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="GameVault" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Your SSJ Sports catalog - every build on this PC, one click to play." Opacity="0.75" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="32" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="TotalText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Games cataloged" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="ExeText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="EXE builds" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="HtmlText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="HTML builds" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="ZipText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="ZIP builds" Opacity="0.7" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Genres" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
            <ListView x:Name="GenreList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
