<?xml version="1.0" encoding="UTF-8"?>
<!--
  GameVault MSI installer - WiX Toolset v5, per-user (no admin / no UAC).
  Installs to %LOCALAPPDATA%\Programs\St. John Pictures\GameVault.
  The <ComponentGroupRef Id="AppFiles" /> is satisfied by Files.wxs, which
  the build workflow generates from the publish output.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="GameVault"
           Language="1033"
           Version="1.0.0"
           Manufacturer="St. John Pictures"
           ProductCode="E62DE188-0230-4C6D-AC56-CC82AB115F99"
           UpgradeCode="6C1A7E06-FE24-45AF-95FA-C4A9ADDEF965"
           Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of GameVault is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPPRODUCTICON" Value="[INSTALLFOLDER]GameVault.exe" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://aikman1890.github.io/stjohn-windows-apps/" />

    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="CompanyDir" Name="St. John Pictures">
          <Directory Id="INSTALLFOLDER" Name="GameVault" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutsDir" Name="GameVault">
        <Component Id="StartMenuShortcut" Guid="D3329147-C9D3-4978-A9FC-360ABA9FBC86" Bitness="always64">
          <Shortcut Id="AppStartMenuShortcut"
                    Name="GameVault"
                    Description="GameVault - SSJ Sports game launcher and catalog for Windows"
                    Target="[INSTALLFOLDER]GameVault.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppShortcutsDir" Directory="AppShortcutsDir" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\St. John Pictures\GameVault"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="GameVault" Level="1">
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
</Wix>
