<Page
    x:Class="RangePilot.Views.MediaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RangePilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Media package ledger" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Who bought photo/video, whether it was captured, and whether it was delivered. Undelivered media turns orange at 2 days and red when overdue - on a high-ticket day, an undelivered video package is a refund and a bad review waiting to happen." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="MediaList" SelectionChanged="MediaList_SelectionChanged" MaxHeight="300">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaItem">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                            <Ellipse Width="12" Height="12" Fill="{x:Bind FlagBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="GuestBox" Header="Guest / party" Width="210" />
                <ComboBox x:Name="KindBox" Header="Package" Width="160" />
                <TextBox x:Name="PriceBox" Header="Price" Width="90" />
                <ComboBox x:Name="CapturedBox" Header="Captured" Width="120" />
                <Button x:Name="AddButton" Content="Add owed media" Click="AddButton_Click" VerticalAlignment="Bottom" />
                <Button x:Name="DeliverButton" Content="Mark delivered today" Click="DeliverButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
