<Page
    x:Class="RangePilot.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12">
            <TextBlock x:Name="TitleText" Text="Day board" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="One board for the operating day: bookings by slot, waiver status per party (green only when every participant is signed), assets up or down, and media owed. Records tool, not compliance advice - this app tracks the operator's own records and never interprets ATF, state, or insurance rules." Opacity="0.75" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CalendarDatePicker x:Name="DayPicker" Header="Operating day" />
                <Button x:Name="RefreshButton" Content="Show the day" Click="RefreshButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Bookings" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="BookingText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Assets &amp; media owed" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="OpsText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
