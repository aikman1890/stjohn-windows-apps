<Page
    x:Class="RangePilot.Views.BookingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RangePilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Bookings &amp; packages" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Keep your booking channel (FareHarbor, Acuity, the phone) - RangePilot is the back-office book that reconciles what was sold against what the operation can run. Source tracking makes discount leakage visible in dollars." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="BookingList" SelectionChanged="BookingList_SelectionChanged" MaxHeight="260">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Booking">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid MaxWidth="880" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="PackageBox" Grid.Row="0" Grid.Column="0" Header="Package" HorizontalAlignment="Stretch" Margin="0,0,8,8" SelectionChanged="PackageBox_SelectionChanged" />
                <TextBox x:Name="GuestBox" Grid.Row="0" Grid.Column="1" Header="Lead guest / party" Margin="0,0,0,8" />
                <CalendarDatePicker x:Name="SlotPicker" Grid.Row="1" Grid.Column="0" Header="Slot date" Margin="0,0,8,8" />
                <TextBox x:Name="TimeBox" Grid.Row="1" Grid.Column="1" Header="Slot time (e.g. 10:00)" Margin="0,0,0,8" />
                <TextBox x:Name="PartyBox" Grid.Row="2" Grid.Column="0" Header="Party size" Margin="0,0,8,8" />
                <ComboBox x:Name="SourceBox" Grid.Row="2" Grid.Column="1" Header="Source" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                <TextBox x:Name="TotalBox" Grid.Row="3" Grid.Column="0" Header="Total price" Margin="0,0,8,8" />
                <TextBox x:Name="DepositBox" Grid.Row="3" Grid.Column="1" Header="Deposit paid" Margin="0,0,0,8" />
                <TextBox x:Name="AssetBox" Grid.Row="4" Grid.Column="0" Header="Asset assigned" Margin="0,0,8,8" />
                <TextBox x:Name="StaffBox" Grid.Row="4" Grid.Column="1" Header="Staff assigned (roles filled)" Margin="0,0,0,8" />
                <ComboBox x:Name="StatusBox" Grid.Row="5" Grid.Column="0" Header="Status" HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button x:Name="SaveButton" Content="Save booking" Click="SaveButton_Click" />
                    <Button x:Name="NewButton" Content="New" Click="NewButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="DownWarningText" Foreground="DarkOrange" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
            <TextBlock Text="Packages (yours to build)" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,0" />
            <ListView x:Name="PackageList" SelectionMode="None" MaxHeight="150">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ExperiencePackage">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="PkgNameBox" Header="Name" Width="230" />
                <TextBox x:Name="PkgPriceBox" Header="Price" Width="100" />
                <TextBox x:Name="PkgCapBox" Header="Capacity" Width="90" />
                <TextBox x:Name="PkgAssetsBox" Header="Assets required" Width="220" />
                <Button x:Name="PkgButton" Content="Add package" Click="PkgButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock Text="Gift cards" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,0" />
            <ListView x:Name="CardList" SelectionMode="None" MaxHeight="130">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GiftCard">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="CardCodeBox" Header="Code" Width="170" />
                <TextBox x:Name="CardToBox" Header="Issued to" Width="200" />
                <TextBox x:Name="CardAmountBox" Header="Amount" Width="100" />
                <TextBox x:Name="CardRedeemBox" Header="Add redemption" Width="120" />
                <Button x:Name="CardButton" Content="Issue / redeem" Click="CardButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
