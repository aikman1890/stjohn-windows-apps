<Page
    x:Class="RangePilot.Views.WaiversPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RangePilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Waiver register" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="The register records the fact and version of signing - paper reference or your existing e-waiver tool's reference. RangePilot captures no signatures; it gates the slot: a party is green only when every participant is signed." Opacity="0.7" TextWrapping="Wrap" />
            <ComboBox x:Name="BookingBox" Header="Booking" Width="460" />
            <TextBlock x:Name="GateText" TextWrapping="Wrap" FontWeight="SemiBold" />
            <ListView x:Name="PartyList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Participant">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="NameBox" Header="Participant" Width="220" />
                <ComboBox x:Name="SignedBox" Header="Waiver" Width="130" />
                <TextBox x:Name="VersionBox" Header="Version" Width="110" />
                <TextBox x:Name="GuardianBox" Header="Guardian (minors)" Width="190" />
                <Button x:Name="AddButton" Content="Add / update" Click="AddButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
