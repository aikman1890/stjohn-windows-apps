<Page
    x:Class="RangePilot.Views.GuestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RangePilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Guest book &amp; win-back list" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Your own list, sorted by days since the last visit - so the next campaign goes to past guests at full price instead of buying the same guest back from a discount channel at a third off." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="GuestList" SelectionChanged="GuestList_SelectionChanged" MaxHeight="320">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:RangeGuest">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid MaxWidth="840" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="0" Header="Guest" Margin="0,0,8,8" />
                <TextBox x:Name="ContactBox" Grid.Row="0" Grid.Column="1" Header="Contact" Margin="0,0,0,8" />
                <TextBox x:Name="OccasionBox" Grid.Row="1" Grid.Column="0" Header="Occasion (birthday, bachelor, corporate...)" Margin="0,0,8,8" />
                <TextBox x:Name="ReferralBox" Grid.Row="1" Grid.Column="1" Header="Loyalty / referral note" Margin="0,0,0,8" />
                <TextBox x:Name="VisitsBox" Grid.Row="2" Grid.Column="0" Header="Total visits" Margin="0,0,8,0" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button x:Name="SaveButton" Content="Save guest" Click="SaveButton_Click" />
                    <Button x:Name="VisitButton" Content="Log a visit today" Click="VisitButton_Click" />
                    <Button x:Name="NewButton" Content="New" Click="NewButton_Click" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
