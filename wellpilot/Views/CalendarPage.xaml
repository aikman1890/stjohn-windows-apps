<Page
    x:Class="WellPilot.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Compliance date" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Your own recurring dates - filings, reconciliations, reports, lease obligations. All dates and requirements are user-maintained; verify them against current state rules." Opacity="0.75" TextWrapping="Wrap" />
                <TextBox x:Name="TitleBox" Header="Title" />
                <TextBox x:Name="CategoryBox" Header="Category (tax, state report, lease...)" />
                <DatePicker x:Name="DuePicker" Header="Due date" />
                <ComboBox x:Name="RecurCombo" Header="Recurrence" HorizontalAlignment="Stretch">
                    <x:String>One-time</x:String>
                    <x:String>Monthly</x:String>
                    <x:String>Quarterly</x:String>
                    <x:String>Annual</x:String>
                </ComboBox>
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <Button x:Name="DoneButton" Content="Mark done (advances recurring dates)" Click="DoneButton_Click" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" Foreground="{Binding DueBrush}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
