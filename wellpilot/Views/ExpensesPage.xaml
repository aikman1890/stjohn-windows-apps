<Page
    x:Class="WellPilot.Views.ExpensesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Operating expenses (LOE)" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="The month's lease operating expenses per well - these are what the JIB engine allocates across working-interest owners." Opacity="0.75" TextWrapping="Wrap" />
                <ComboBox x:Name="WellPicker" Header="Well" HorizontalAlignment="Stretch" />
                <TextBox x:Name="MonthBox" Header="Month (yyyy-MM)" />
                <ComboBox x:Name="CategoryCombo" Header="Category" IsEditable="True" HorizontalAlignment="Stretch" />
                <TextBox x:Name="AmountBox" Header="Amount ($)" InputScope="CurrencyAmount" />
                <TextBox x:Name="VendorBox" Header="Vendor / payee" />
                <TextBox x:Name="NoteBox" Header="Note" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock x:Name="TotalsText" TextWrapping="Wrap" Opacity="0.85" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
