<Page
    x:Class="WellPilot.Views.SuspensePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Suspense" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Amounts held back, with the reason in your own words. A suspense balance never silently disappears - it stays here until you release it." Opacity="0.75" TextWrapping="Wrap" />
                <ComboBox x:Name="OwnerPicker" Header="Owner" HorizontalAlignment="Stretch" />
                <DatePicker x:Name="DatePickerCtl" Header="Date held" />
                <TextBox x:Name="AmountBox" Header="Amount ($)" InputScope="CurrencyAmount" />
                <TextBox x:Name="ReasonBox" Header="Reason (unleased, minimum royalty, title...)" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <Button x:Name="ReleaseButton" Content="Release selected hold today" Click="ReleaseButton_Click" />
                <TextBlock x:Name="TotalsText" TextWrapping="Wrap" Opacity="0.85" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
