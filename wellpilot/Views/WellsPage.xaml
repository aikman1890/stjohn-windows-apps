<Page
    x:Class="WellPilot.Views.WellsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Well / lease file" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="LeaseBox" Header="Lease / property name" />
                <TextBox x:Name="WellBox" Header="Well name" />
                <TextBox x:Name="ApiBox" Header="API number (as you record it)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="CountyBox" Header="County" Width="170" />
                    <TextBox x:Name="StateBox" Header="State" Width="90" />
                </StackPanel>
                <TextBox x:Name="OperatorBox" Header="Operator" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch">
                    <x:String>Producing</x:String>
                    <x:String>Shut-in</x:String>
                    <x:String>Plugged</x:String>
                </ComboBox>
                <CheckBox x:Name="FirstCheck" Content="First production date known" Checked="FirstCheck_Changed" Unchecked="FirstCheck_Changed" />
                <DatePicker x:Name="FirstPicker" Header="First production" IsEnabled="False" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
