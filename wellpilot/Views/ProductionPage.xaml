<Page
    x:Class="WellPilot.Views.ProductionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Production &amp; revenue" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Entered from the purchaser statement - WellPilot records what the statement says; it fetches nothing." Opacity="0.75" TextWrapping="Wrap" />
                <ComboBox x:Name="WellPicker" Header="Well" HorizontalAlignment="Stretch" />
                <TextBox x:Name="MonthBox" Header="Month (yyyy-MM)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="OilBox" Header="Oil (bbl)" Width="150" />
                    <TextBox x:Name="GasBox" Header="Gas (MCF)" Width="150" />
                </StackPanel>
                <TextBox x:Name="GrossBox" Header="Gross revenue ($)" InputScope="CurrencyAmount" />
                <TextBox x:Name="SevBox" Header="Severance tax withheld ($, as entered)" InputScope="CurrencyAmount" />
                <TextBox x:Name="DedBox" Header="Other deductions ($, as entered)" InputScope="CurrencyAmount" />
                <TextBox x:Name="PurchaserBox" Header="Purchaser reference" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
