<Page
    x:Class="WellPilot.Views.ClosePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Monthly close" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Pick a well and month. The engine distributes net revenue by the ACTIVE deck and allocates the month's expenses across working-interest owners pro-rata to their WI share. Rounding is half-even to cents; any remainder lands on the largest-interest owner - the rule is printed on every statement. A run is immutable: re-running a month creates a new run record; delete a run explicitly if it was a mistake." Opacity="0.78" TextWrapping="Wrap" />
                <ComboBox x:Name="WellPicker" Header="Well" HorizontalAlignment="Stretch" />
                <TextBox x:Name="MonthBox" Header="Month (yyyy-MM)" />
                <Button x:Name="PreviewButton" Content="Preview the close" Click="PreviewButton_Click" HorizontalAlignment="Left" />
                <TextBlock x:Name="PreviewText" TextWrapping="Wrap" />
                <Button x:Name="RunButton" Content="Run distribution" Click="RunButton_Click" HorizontalAlignment="Left" />
                <TextBlock Text="Exports (selected run)" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="StatementsButton" Content="Owner statements (HTML)" Click="StatementsButton_Click" />
                    <Button x:Name="PacketButton" Content="Close packet (HTML)" Click="PacketButton_Click" />
                </StackPanel>
                <Button x:Name="DeleteRunButton" Content="Delete selected run (mistake only)" Click="DeleteRunButton_Click" />
                <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="2" Spacing="8">
            <TextBlock Text="Runs" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="RunsList" SelectionChanged="RunsList_SelectionChanged" MaxHeight="240">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Statement lines (selected run)" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="LinesList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
