<Page
    x:Class="WellPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBox x:Name="OperatorBox" Header="Operator name (prints on statements &amp; packets)" />
            <TextBox x:Name="AddressBox" Header="Operator address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
            <TextBox x:Name="PhoneBox" Header="Phone" />
            <TextBlock Text="Expense (LOE) categories (one per line)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="CatsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="100" />
            <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="SavedText" Opacity="0.75" />
            <TextBlock Text="Severance and tax figures are entered by you from purchaser statements and verified against current state requirements - WellPilot ships no tax-rate authority and gives no tax advice. Everything is stored locally in this app's folder - no account, no cloud, no telemetry." Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
