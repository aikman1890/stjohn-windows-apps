<Page
    x:Class="WellPilot.Views.DecksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Interest deck (division order)" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="WellPicker" Header="Well" HorizontalAlignment="Stretch" SelectionChanged="WellPicker_SelectionChanged" />
                <TextBlock x:Name="ValidationText" TextWrapping="Wrap" FontWeight="SemiBold" />
                <ComboBox x:Name="OwnerPicker" Header="Owner" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="TypeCombo" Header="Interest type" HorizontalAlignment="Stretch">
                    <x:String>Royalty</x:String>
                    <x:String>Overriding royalty</x:String>
                    <x:String>Working interest</x:String>
                </ComboBox>
                <TextBox x:Name="DecimalBox" Header="Decimal interest (8 places, e.g. 0.12500000)" />
                <DatePicker x:Name="EffPicker" Header="Effective date" />
                <TextBox x:Name="NoteBox" Header="Note (division order ref, conveyance...)" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddButton" Content="Add deck line (new version)" Click="AddButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="Editing a deck never rewrites history: changing an owner's decimal supersedes their old line (kept below, marked) and starts a new version. Every distribution run snapshots the decimals it used." Opacity="0.75" TextWrapping="Wrap" />
                <Button x:Name="SupersedeButton" Content="Supersede selected line (retire it)" Click="SupersedeButton_Click" />
                <Button x:Name="DeleteButton" Content="Delete selected line (only for mistakes)" Click="DeleteButton_Click" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="2" Spacing="8">
            <TextBlock Text="Active deck" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="ActiveList" SelectionChanged="ActiveList_SelectionChanged" MaxHeight="380">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Superseded history" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="HistoryList" SelectionMode="None" MaxHeight="260">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" Opacity="0.65" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
