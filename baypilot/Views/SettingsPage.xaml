<Page
    x:Class="BayPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Shop Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="These values print on estimates and invoices and preset your labor lines. They are yours - BayPilot ships with no rates, no labor guide, and no OEM data." Opacity="0.75" TextWrapping="Wrap" />
            <TextBox x:Name="ShopNameBox" Header="Shop name" />
            <TextBox x:Name="AddressBox" Header="Shop address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
            <TextBox x:Name="PhoneBox" Header="Shop phone" />
            <TextBox x:Name="LaborRateBox" Header="Labor rate ($/hr preset)" />
            <TextBox x:Name="TaxBox" Header="Tax rate %" />
            <TextBox x:Name="SuppliesBox" Header="Shop supplies fee ($ per RO)" />
            <TextBox x:Name="MarkupBox" Header="Default parts markup %" />
            <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
