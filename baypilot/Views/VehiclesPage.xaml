<Page
    x:Class="BayPilot.Views.VehiclesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Vehicle file" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="CustomerPicker" Header="Owner" HorizontalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="YearBox" Header="Year" Width="90" />
                    <TextBox x:Name="MakeBox" Header="Make" Width="120" />
                    <TextBox x:Name="ModelBox" Header="Model" Width="120" />
                </StackPanel>
                <TextBox x:Name="VinBox" Header="VIN (stored as text - never decoded)" />
                <TextBox x:Name="PlateBox" Header="Plate" />
                <TextBox x:Name="MileageBox" Header="Current mileage" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="IntervalMonthsBox" Header="Service interval (months, shop estimate)" Width="170" />
                    <TextBox x:Name="IntervalMilesBox" Header="Service interval (miles, shop estimate)" Width="170" />
                </StackPanel>
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="2" Spacing="8">
            <ListView x:Name="ItemsList" MaxHeight="300" SelectionChanged="ItemsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="2" Padding="4,6">
                            <TextBlock Text="{Binding FullLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SubLine}" Opacity="0.75" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Full service history for the selected vehicle" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="HistoryList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
