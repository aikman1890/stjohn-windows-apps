<Page
    x:Class="BayPilot.Views.ApprovalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Approval log" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Decide each estimate line, then record it. Every decision lands in the log with the date, method, and who approved - the shop's dispute record." TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                <ComboBox x:Name="RoPicker" Header="Repair order" HorizontalAlignment="Stretch"
                          SelectionChanged="RoPicker_SelectionChanged" />
                <ComboBox x:Name="MethodCombo" Header="Approval method" HorizontalAlignment="Stretch" />
                <TextBox x:Name="ApproverBox" Header="Approved by (name)" />
                <TextBox x:Name="ReasonBox" Header="Decline reason (for declined lines)" />
                <DatePicker x:Name="FollowUpPicker" Header="Declined-work follow-up date" />
                <CheckBox x:Name="FollowUpCheck" Content="Set a follow-up date for declined lines" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ApproveButton" Content="Approve selected line" Click="ApproveButton_Click" />
                    <Button x:Name="DeclineButton" Content="Decline selected line" Click="DeclineButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                <TextBlock Text="Estimate lines for the selected RO:" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ListView x:Name="LinesList" MaxHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLine}" Padding="4,4" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="2" Spacing="8">
            <TextBlock Text="Log for this RO" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="LogList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="2" Padding="4,6">
                            <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SubLine}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
