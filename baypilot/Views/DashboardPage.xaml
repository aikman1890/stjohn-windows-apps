<Page
    x:Class="BayPilot.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="BayPilot - End of Day" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="The shop's day at a glance: what opened, what closed, what is owed, and what is due back - on this PC only." Opacity="0.75" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="32" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="OpenedText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="ROs opened today" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="ClosedText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Picked up (all time)" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="InvoicedText" FontSize="32" FontWeight="SemiBold" Text="$0" />
                    <TextBlock Text="Invoiced today" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="CollectedText" FontSize="32" FontWeight="SemiBold" Text="$0" />
                    <TextBlock Text="Collected (all open invoices)" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="PendingText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Approvals pending" Opacity="0.7" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="In the shop now" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
            <ListView x:Name="BoardList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Due back tomorrow" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
            <ListView x:Name="TomorrowList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
