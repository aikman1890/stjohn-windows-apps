<Page
    x:Class="BayPilot.Views.RemindersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Reminders" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Promised-time risk, declined-work follow-ups that are due, and service-due estimates. Service intervals are the shop's own settings on each vehicle - estimates, not manufacturer data." Opacity="0.75" TextWrapping="Wrap" />
            <TextBlock Text="Past promised time, still open" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ListView x:Name="PromisedList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Follow-ups due" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ListView x:Name="FollowUpList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Service possibly due (shop-estimate intervals)" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ListView x:Name="ServiceList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
