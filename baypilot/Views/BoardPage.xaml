<Page
    x:Class="BayPilot.Views.BoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Repair order" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="RoNumberBox" Header="RO number" />
                <ComboBox x:Name="VehiclePicker" Header="Vehicle (customer - vehicle)" HorizontalAlignment="Stretch"
                          SelectionChanged="VehiclePicker_SelectionChanged" />
                <TextBlock x:Name="CarriedText" TextWrapping="Wrap" Opacity="0.85" FontSize="12" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch" />
                <DatePicker x:Name="PromisedDatePicker" Header="Promised date" />
                <TimePicker x:Name="PromisedTimePicker" Header="Promised time" />
                <CheckBox x:Name="PromisedCheck" Content="Set a promised time" />
                <TextBox x:Name="TechBox" Header="Tech assigned" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="MileageInBox" Header="Mileage in" Width="150" />
                    <TextBox x:Name="MileageOutBox" Header="Mileage out" Width="150" />
                </StackPanel>
                <TextBox x:Name="ComplaintBox" Header="Customer complaint / reason for visit" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                <TextBox x:Name="RecommendBox" Header="Tech notes / recommendations (carry forward)" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="Estimate lines, approvals, and invoicing live on their own pages - pick this RO there after saving it here."
                           TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubLine}" Opacity="0.75" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
