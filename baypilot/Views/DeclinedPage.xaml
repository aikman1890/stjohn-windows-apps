<Page
    x:Class="BayPilot.Views.DeclinedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Declined-work register" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Work the customer said no to - the call-back list paper shops lose. Sorted by follow-up pressure: overdue first, then by value." TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                <TextBlock x:Name="TotalText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <DatePicker x:Name="FollowUpPicker" Header="Follow-up date for the selected item" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SetFollowUpButton" Content="Set follow-up" Click="SetFollowUpButton_Click" />
                    <Button x:Name="DoneButton" Content="Mark followed up" Click="DoneButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
