<Page
    x:Class="PlatePilot.Views.ImpactPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Price-change impact" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="A supplier raises a price - which dishes blow their target? Pick the ingredient, type the NEW purchase price, and see every plate that uses it, re-costed instantly. Nothing is saved until you record the price on the Ingredients page." TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="IngredientPicker" Header="Ingredient" Width="260" SelectionChanged="IngredientPicker_SelectionChanged" />
                <TextBox x:Name="NewPriceBox" Header="New purchase price ($)" Width="170" TextChanged="NewPriceBox_TextChanged" />
            </StackPanel>
            <TextBlock x:Name="CurrentText" TextWrapping="Wrap" Opacity="0.85" />
            <ListView x:Name="RowsList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
