<Page
    x:Class="PlatePilot.Views.RecipesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Recipe / plate" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="NameBox" Header="Dish name" />
                <TextBox x:Name="CategoryBox" Header="Category (mains, brunch, catering...)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="MenuPriceBox" Header="Menu price ($)" Width="130" />
                    <TextBox x:Name="TargetBox" Header="Target food cost %" Text="30" Width="130" />
                </StackPanel>
                <TextBlock x:Name="CostText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save dish" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                    <Button x:Name="ExportButton" Content="Cost sheet (.html)" Click="ExportButton_Click" />
                </StackPanel>

                <TextBlock Text="Recipe lines" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="Quantity is as-purchased (AP) in the ingredient's base unit. Yield % is the edible-portion yield you measured (100 = nothing lost); the plate cost divides by yield, so trimming loss is priced in." TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                <ComboBox x:Name="IngredientPicker" Header="Ingredient" HorizontalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="QtyBox" Header="Qty (AP)" Text="0" Width="100" />
                    <TextBox x:Name="YieldBox" Header="Yield %" Text="100" Width="100" />
                    <Button x:Name="AddLineButton" Content="Add line" Click="AddLineButton_Click" VerticalAlignment="Bottom" />
                    <Button x:Name="RemoveLineButton" Content="Remove" Click="RemoveLineButton_Click" VerticalAlignment="Bottom" />
                </StackPanel>
                <ListView x:Name="LinesList" MaxHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
