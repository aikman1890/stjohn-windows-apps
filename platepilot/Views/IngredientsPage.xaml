<Page
    x:Class="PlatePilot.Views.IngredientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Ingredient price book" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="NameBox" Header="Ingredient name" />
                <TextBox x:Name="PurchaseUnitBox" Header="Purchase unit (e.g. 50 lb bag, case of 12)" />
                <TextBox x:Name="PriceBox" Header="Purchase price ($)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="AmountBox" Header="Base units in the purchase unit" Width="180" />
                    <ComboBox x:Name="BaseUnitCombo" Header="Base unit" Width="120" />
                </StackPanel>
                <TextBlock x:Name="CostPreviewText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBox x:Name="SupplierBox" Header="Supplier" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="Price changes" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="Editing the price above and saving appends a dated history point. To record a jump without editing anything else:" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="NewPriceBox" Header="New price ($)" Width="130" />
                    <TextBox x:Name="NewPriceNoteBox" Header="Note" Width="170" />
                    <Button x:Name="RecordPriceButton" Content="Record price" Click="RecordPriceButton_Click" VerticalAlignment="Bottom" />
                </StackPanel>
                <ListView x:Name="HistoryList" MaxHeight="180" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
