<Page
    x:Class="PlatePilot.Views.QuotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Catering quote" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="ClientBox" Header="Client name" />
                <DatePicker x:Name="EventPicker" Header="Event date" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch" />
                <TextBox x:Name="OtherBox" Header="Other charges ($) - rentals, delivery, service" Text="0" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <TextBlock Text="Per-guest lines" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock x:Name="MarginHintText" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                <ComboBox x:Name="RecipePicker" Header="Dish" HorizontalAlignment="Stretch" SelectionChanged="RecipePicker_SelectionChanged" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="GuestsBox" Header="Guests" Text="50" Width="90" />
                    <TextBox x:Name="PerGuestBox" Header="Price per guest ($)" Width="140" />
                    <Button x:Name="AddLineButton" Content="Add line" Click="AddLineButton_Click" VerticalAlignment="Bottom" />
                    <Button x:Name="RemoveLineButton" Content="Remove" Click="RemoveLineButton_Click" VerticalAlignment="Bottom" />
                </StackPanel>
                <ListView x:Name="LinesList" MaxHeight="160">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="TotalText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save quote" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                    <Button x:Name="ExportButton" Content="Export (.html)" Click="ExportButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
