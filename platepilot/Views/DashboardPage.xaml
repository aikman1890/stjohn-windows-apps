<Page
    x:Class="PlatePilot.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="PlatePilot" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" Opacity="0.85" TextWrapping="Wrap" />
            <TextBlock Text="Off-target dishes (worst first)" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListView x:Name="OffTargetList" SelectionMode="None" MaxHeight="240">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Recent price movers" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListView x:Name="MoversList" SelectionMode="None" MaxHeight="240">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Every cost in this app comes from the prices YOU enter. PlatePilot fetches nothing, assumes nothing, and never touches a supplier system - when an invoice changes, record the new price and the whole menu re-costs instantly." Opacity="0.7" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
