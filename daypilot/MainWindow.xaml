<Window
    x:Class="DayPilot.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DayPilot">

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        SelectionChanged="NavView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="BriefingNavItem" Content="Briefing" Tag="briefing">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NotesNavItem" Content="Notes" Tag="notes">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Edit" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="RemindersNavItem" Content="Reminders" Tag="reminders">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Clock" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="SettingsNavItem" Content="Settings" Tag="settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <TextBlock
                Text="{x:Bind ViewModel.Ai.StatusMessage, Mode=OneWay}"
                FontSize="11"
                Opacity="0.7"
                TextWrapping="Wrap"
                Margin="12,0,12,12" />
        </NavigationView.PaneFooter>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
