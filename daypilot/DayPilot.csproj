<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <DefaultLanguage>en</DefaultLanguage>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DayPilot</RootNamespace>
    <AssemblyName>DayPilot</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared offline-licensing code (single source of truth). -->
    <Compile Include="..\Licensing\LicenseCore.cs" Link="Licensing\LicenseCore.cs" />
    <Compile Include="..\Licensing\LicenseSecrets.cs" Link="Licensing\LicenseSecrets.cs" />
    <Compile Include="..\Licensing\LicenseManager.cs" Link="Licensing\LicenseManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shaun's encrypted voice bundle (AES-256-CBC) + the license text.
         vd.dat is decrypted in memory only, hash-verified at startup. -->
    <Content Include="Assets\Voice\vd.dat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="License.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
