<Page
    x:Class="DayPilot.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DayPilot.Models"
    xmlns:views="using:DayPilot.Views">

    <Pivot x:Name="NotesPivot">
        <PivotItem x:Uid="NotesPage_TextNotes">
            <Grid Padding="24" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="8">
            <Button x:Uid="NotesPage_NewNote" Command="{x:Bind ViewModel.NewNoteCommand}" HorizontalAlignment="Stretch" />
            <ListView
                ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedNote, Mode=TwoWay}"
                SelectionMode="Single"
                MinHeight="200">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Note">
                        <StackPanel Padding="0,6">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind UpdatedAt.ToString('g')}" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="12" MaxWidth="800">
                <TextBox x:Uid="NotesPage_TitleBox"
                    x:Name="TitleBox"
                    Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox x:Uid="NotesPage_TagsCommaSeparated"
                    Text="{x:Bind ViewModel.Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox x:Uid="NotesPage_BodyBox"
                    x:Name="BodyBox"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="240"
                    Text="{x:Bind ViewModel.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="NotesPage_Save" Command="{x:Bind ViewModel.SaveNoteCommand}" />
                    <Button x:Uid="NotesPage_Delete" Command="{x:Bind ViewModel.DeleteNoteCommand}" />
                    <Button x:Name="DictateButton" Click="DictateButton_Click"
                            AutomationProperties.Name="Dictate note by voice"
                            ToolTipService.ToolTip="Dictate into the note body using your microphone">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE720;" FontSize="14" />
                            <TextBlock Text="Dictate" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="DictationStatusText" Opacity="0.8" TextWrapping="Wrap" Visibility="Collapsed" />

                <TextBlock x:Uid="NotesPage_OnDeviceAI" Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Uid="NotesPage_Summarize"
                        Command="{x:Bind ViewModel.SummarizeCommand}"
                        IsEnabled="{x:Bind ViewModel.Ai.IsAvailable, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Ai.StatusMessage, Mode=OneWay}" />
                    <Button x:Uid="NotesPage_Rewrite"
                        Command="{x:Bind ViewModel.RewriteCommand}"
                        IsEnabled="{x:Bind ViewModel.Ai.IsAvailable, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Ai.StatusMessage, Mode=OneWay}" />
                    <Button x:Uid="NotesPage_ExtractActionItems"
                        Command="{x:Bind ViewModel.ActionItemsCommand}"
                        IsEnabled="{x:Bind ViewModel.Ai.IsAvailable, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Ai.StatusMessage, Mode=OneWay}" />
                    <ProgressRing x:Uid="NotesPage_AIWorking"
                        IsActive="{x:Bind ViewModel.AiBusy, Mode=OneWay}"
                        Width="24" Height="24" />
                </StackPanel>

                <TextBlock
                    Text="{x:Bind ViewModel.ResultText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
            </Grid>
        </PivotItem>
        <PivotItem x:Uid="NotesPage_InkNotes">
            <TextBlock Text="Ink notes (coming soon)" Opacity="0.6" Margin="12"/>
        </PivotItem>
    </Pivot>
</Page>
