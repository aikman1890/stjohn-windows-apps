<Page
    x:Class="DayPilot.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DayPilot.Models">

    <Grid Padding="24" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="8">
            <Button Content="New note" Command="{x:Bind ViewModel.NewNoteCommand}" HorizontalAlignment="Stretch" />
            <ListView
                ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedNote, Mode=TwoWay}"
                SelectionMode="Single"
                MinHeight="200">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Note">
                        <StackPanel Padding="0,6">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind UpdatedAt.ToString('g')}" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="12" MaxWidth="800">
                <TextBox
                    x:Name="TitleBox"
                    Header="Title"
                    PlaceholderText="Note title"
                    Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Header="Tags (comma separated)"
                    PlaceholderText="work, ideas"
                    Text="{x:Bind ViewModel.Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Header="Body"
                    PlaceholderText="Write your note here..."
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="240"
                    Text="{x:Bind ViewModel.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save" Command="{x:Bind ViewModel.SaveNoteCommand}" />
                    <Button Content="Delete" Command="{x:Bind ViewModel.DeleteNoteCommand}" />
                </StackPanel>

                <TextBlock Text="On-device AI" Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        Content="Summarize"
                        Command="{x:Bind ViewModel.SummarizeCommand}"
                        IsEnabled="{x:Bind ViewModel.Ai.IsAvailable, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Ai.StatusMessage, Mode=OneWay}" />
                    <Button
                        Content="Rewrite"
                        Command="{x:Bind ViewModel.RewriteCommand}"
                        IsEnabled="{x:Bind ViewModel.Ai.IsAvailable, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Ai.StatusMessage, Mode=OneWay}" />
                    <Button
                        Content="Extract action items"
                        Command="{x:Bind ViewModel.ActionItemsCommand}"
                        IsEnabled="{x:Bind ViewModel.Ai.IsAvailable, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Ai.StatusMessage, Mode=OneWay}" />
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.AiBusy, Mode=OneWay}"
                        Width="24" Height="24" />
                </StackPanel>

                <TextBlock
                    Text="{x:Bind ViewModel.ResultText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
