<UserControl
    x:Class="DayPilot.Views.InkNotesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnSpacing="16" Padding="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Named ink pages -->
        <StackPanel Grid.Column="0" Spacing="8">
            <TextBlock x:Uid="InkNotesControl_InkPages" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Uid="InkNotesControl_InkPages_2"
                ItemsSource="{x:Bind ViewModel.PageNames, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedPageName, Mode=TwoWay}"
                SelectionMode="Single"
                MinHeight="180"
                />
            <TextBox x:Uid="InkNotesControl_NewPageName"
                Text="{x:Bind ViewModel.NewPageName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button x:Uid="InkNotesControl_AddPage" Command="{x:Bind ViewModel.AddPageCommand}" HorizontalAlignment="Stretch" />
            <Button x:Uid="InkNotesControl_DeletePage" Click="DeletePageButton_Click" HorizontalAlignment="Stretch" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- Ink surface -->
        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Framework default tools: ballpoint pen, pencil, highlighter, eraser, ruler. -->
            <InkToolbar x:Uid="InkNotesControl_InkToolbarControl"
                x:Name="InkToolbarControl"
                Grid.Row="0"
                TargetInkCanvas="{x:Bind InkCanvasControl}"
                />

            <Border
                Grid.Row="1"
                CornerRadius="8"
                Padding="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <InkCanvas x:Uid="InkNotesControl_InkCanvasControl"
                    x:Name="InkCanvasControl"
                    IsTabStop="True"
                    />
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button x:Uid="InkNotesControl_Save" Click="SaveButton_Click" />
                <Button x:Uid="InkNotesControl_Undo" Click="UndoButton_Click" />
                <Button x:Uid="InkNotesControl_Redo" Click="RedoButton_Click" />
                <Button x:Uid="InkNotesControl_Clear" Click="ClearButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
