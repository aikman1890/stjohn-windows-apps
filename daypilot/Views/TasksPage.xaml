<Page
    x:Class="DayPilot.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DayPilot.Models"
    xmlns:converters="using:DayPilot.Converters">
    <Page.Resources>
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter" />
    </Page.Resources>

    <ScrollViewer Padding="24">
        <StackPanel Spacing="12" MaxWidth="900">
            <TextBlock x:Uid="TasksPage_Title" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBox
                x:Name="NewTaskBox"
                x:Uid="TasksPage_NewTaskBox"
                KeyDown="NewTaskBox_KeyDown"
                Text="{x:Bind ViewModel.NewTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                x:Uid="TasksPage_AddTaskButton"
                Command="{x:Bind ViewModel.AddTaskCommand}"
                HorizontalAlignment="Left" />

            <ListView
                x:Uid="TasksPage_TaskList"
                ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TodoItem">
                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                Grid.Column="0"
                                x:Uid="TasksPage_DoneCheck"
                                VerticalAlignment="Center"
                                IsChecked="{x:Bind IsDone, Mode=TwoWay}"
                                Click="TaskCheckBox_Click" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind CreatedAt, Converter={StaticResource DateTimeFormatConverter}}" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                x:Uid="TasksPage_DeleteButton"
                                VerticalAlignment="Center"
                                Click="DeleteTask_Click" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
