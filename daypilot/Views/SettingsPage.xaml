<Page
    x:Class="DayPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" MaxWidth="800">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="On-device AI" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border CornerRadius="8" Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.AiStateText, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.AiStateDetail, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" />
                    <Button Content="Check again" Command="{x:Bind ViewModel.RecheckAiCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <TextBlock Text="Global hotkey" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.HotkeyHint, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" />

            <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.VersionText, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" />
        </StackPanel>
    </ScrollViewer>
</Page>
