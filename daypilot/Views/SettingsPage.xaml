<Page
    x:Class="DayPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" MaxWidth="800">
            <TextBlock x:Uid="SettingsPage_Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock x:Uid="SettingsPage_OnDeviceAI" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border CornerRadius="8" Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.AiStateText, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.AiStateDetail, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" />
                    <Button x:Uid="SettingsPage_CheckAgain" Command="{x:Bind ViewModel.RecheckAiCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <TextBlock Text="Voice" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border CornerRadius="8" Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Assistant voice" FontWeight="SemiBold" />
                    <ComboBox x:Name="VoicePicker" HorizontalAlignment="Stretch"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="VoicePicker_SelectionChanged"
                              AutomationProperties.Name="Assistant voice" />
                    <TextBlock Text="DayPilot speaks confirmations and answers in a warm, friendly voice. Pick any voice installed on your PC — your choice is remembered." TextWrapping="Wrap" Opacity="0.8" />
                    <TextBlock Text="VoiceStudio voice profile name" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox x:Name="VoiceProfileBox" PlaceholderText="shaun2"
                             MaxWidth="320" HorizontalAlignment="Left"
                             TextChanged="VoiceProfileBox_TextChanged" />
                    <TextBlock Text="When set, DayPilot speaks in Shaun's cloned voice through VoiceStudio, which is installed and set up automatically on first launch. Clear this box to use the Windows voice picker above instead." TextWrapping="Wrap" Opacity="0.8" />
                </StackPanel>
            </Border>

            <TextBlock x:Uid="SettingsPage_GlobalHotkey" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.HotkeyHint, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" />

            <TextBlock x:Uid="SettingsPage_About" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.VersionText, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" />
            <TextBlock Text="Have an idea for a new feature? That's the way to get it built — the only legitimate path to new features." TextWrapping="Wrap" Opacity="0.8" />
            <HyperlinkButton Content="Request a feature" NavigateUri="https://github.com/aikman1890/stjohn-windows-apps/issues/new?template=feature_request.md&amp;title=%5BDayPilot%5D%20" />
            <HyperlinkButton Content="or email us instead" NavigateUri="mailto:aikman1892@gmail.com?subject=Feature%20request%20-%20DayPilot" />

            <TextBlock Text="License" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border CornerRadius="8" Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="LicenseStatusText" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBox x:Name="LicenseKeyBox" Header="License key" PlaceholderText="XXXXX-XXXXX-XXXXX-XXXXX" />
                    <TextBox x:Name="LicenseEmailBox" Header="Purchase email" PlaceholderText="you@example.com" InputScope="EmailSmtpAddress" />
                    <Button Content="Activate" Click="ActivateLicense_Click" HorizontalAlignment="Left" />
                    <TextBlock x:Name="LicenseResultText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
