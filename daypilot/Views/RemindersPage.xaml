<Page
    x:Class="DayPilot.Views.RemindersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DayPilot.Models">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="12" MaxWidth="900">
            <TextBlock Text="Reminders" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBox
                Header="Add a reminder in plain language"
                PlaceholderText="remind me to call Mom tomorrow at 3pm"
                Text="{x:Bind ViewModel.NlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Text="{x:Bind ViewModel.ParsePreview, Mode=OneWay}"
                Opacity="0.8"
                TextWrapping="Wrap" />
            <Button
                Content="Add reminder"
                Command="{x:Bind ViewModel.AddReminderCommand}"
                HorizontalAlignment="Left" />

            <ListView
                ItemsSource="{x:Bind ViewModel.Reminders, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ReminderItem">
                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                IsChecked="{x:Bind IsDone, Mode=TwoWay}"
                                Click="ReminderCheckBox_Click" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind DueAt.ToString('g')}" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Content="Delete"
                                VerticalAlignment="Center"
                                Click="DeleteReminder_Click" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
