<Page
    x:Class="GuardPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBox x:Name="CompanyBox" Header="Company name (prints on post orders &amp; summaries)" />
            <TextBox x:Name="AddressBox" Header="Company address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
            <TextBox x:Name="PhoneBox" Header="Company phone" />
            <TextBox x:Name="OtBox" Header="Overtime warning threshold (scheduled hours per guard per week)" />
            <TextBlock Text="Incident types (one per line)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="TypesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="110" />
            <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="SavedText" Opacity="0.75" />
            <TextBlock Text="GuardPilot is the office system of record. It does not do GPS patrol verification, checkpoint scanning, or live tracking - if you need proof-of-presence in the field, that is a different tool, and this one will not pretend otherwise. Everything is stored locally in this app's folder - no account, no cloud, no telemetry." Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
