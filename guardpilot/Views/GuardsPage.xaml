<Page
    x:Class="GuardPilot.Views.GuardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Guard roster" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Licence fields are your own records - GuardPilot warns as expiries approach; it verifies nothing with any state." Opacity="0.75" TextWrapping="Wrap" />
                <TextBox x:Name="NameBox" Header="Guard name" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="PhoneBox" Header="Phone" Width="180" />
                    <TextBox x:Name="EmailBox" Header="Email" Width="180" />
                </StackPanel>
                <TextBox x:Name="LicenseBox" Header="Licence number (as recorded)" />
                <CheckBox x:Name="ExpiryCheck" Content="Licence expiry recorded" Checked="ExpiryCheck_Changed" Unchecked="ExpiryCheck_Changed" />
                <DatePicker x:Name="ExpiryPicker" Header="Licence expiry" IsEnabled="False" />
                <TextBox x:Name="CertsBox" Header="Certifications (free text)" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch">
                    <x:String>Active</x:String>
                    <x:String>Inactive</x:String>
                </ComboBox>
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" Foreground="{Binding LicenseBrush}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
