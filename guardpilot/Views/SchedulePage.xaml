<Page
    x:Class="GuardPilot.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Shift" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="PostPicker" Header="Post" HorizontalAlignment="Stretch" />
                <DatePicker x:Name="DatePickerCtl" Header="Shift date" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="StartBox" Header="Start (24h, 18.5 = 18:30)" Width="180" />
                    <TextBox x:Name="EndBox" Header="End (30 = 06:00 next day)" Width="180" />
                </StackPanel>
                <ComboBox x:Name="GuardPicker" Header="Guard (leave unselected = unfilled)" HorizontalAlignment="Stretch" />
                <TextBox x:Name="ActualBox" Header="Actual hours (from the guard's report)" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="40" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PrevWeekButton" Content="Previous week" Click="PrevWeekButton_Click" />
                    <Button x:Name="NextWeekButton" Content="Next week" Click="NextWeekButton_Click" />
                </StackPanel>
                <TextBlock x:Name="WeekText" FontWeight="SemiBold" />
                <TextBlock Text="Problems in the visible week" FontWeight="SemiBold" Margin="0,6,0,0" />
                <ListView x:Name="ProblemList" SelectionMode="None" MaxHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
