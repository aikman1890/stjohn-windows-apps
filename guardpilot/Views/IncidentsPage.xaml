<Page
    x:Class="GuardPilot.Views.IncidentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Incident" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="PostPicker" Header="Post" HorizontalAlignment="Stretch" />
                <TextBox x:Name="GuardBox" Header="Guard on post" />
                <ComboBox x:Name="TypeCombo" Header="Type" IsEditable="True" HorizontalAlignment="Stretch" />
                <TextBox x:Name="NarrativeBox" Header="Narrative" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
                <TextBox x:Name="FollowBox" Header="Follow-up action" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="OwnerBox" Header="Follow-up owner" Width="180" />
                    <DatePicker x:Name="DuePicker" Header="Follow-up due" />
                </StackPanel>
                <CheckBox x:Name="DoneCheck" Content="Follow-up done" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="Filter the log" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox x:Name="FilterBox" Header="Contains (site, guard, type, narrative)" />
                <Button x:Name="FilterButton" Content="Apply filter" Click="FilterButton_Click" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding DisplayLine}" Foreground="{Binding FlagBrush}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Narrative}" TextWrapping="Wrap" Opacity="0.85" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
