<Page
    x:Class="GuardPilot.Views.DarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Daily activity report (DAR) intake" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Logged at the office from whatever the guard submitted - paper, text, call-in. Entered once here, searchable forever, instead of lost in a chat thread." Opacity="0.75" TextWrapping="Wrap" />
                <ComboBox x:Name="PostPicker" Header="Post" HorizontalAlignment="Stretch" />
                <TextBox x:Name="GuardBox" Header="Guard" />
                <DatePicker x:Name="DatePickerCtl" Header="Date" />
                <TextBox x:Name="SummaryBox" Header="Summary" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
