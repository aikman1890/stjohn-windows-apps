<Page
    x:Class="GuardPilot.Views.BillingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Hours &amp; billing ledger" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Scheduled vs. actual hours per site for a month, at each site's contract rate - the invoice-ready summary. Issue the invoice itself in InvoicePilot or your accounting tool; this is the verified hours it stands on." Opacity="0.8" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="MonthBox" Header="Month (yyyy-MM)" Width="160" />
                <Button x:Name="CalcButton" Content="Calculate" Click="CalcButton_Click" VerticalAlignment="Bottom" />
                <Button x:Name="ExportButton" Content="Export summary (HTML)" Click="ExportButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="TotalsText" FontSize="15" TextWrapping="Wrap" />
            <TextBlock Text="Per site" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ListView x:Name="SiteList" SelectionMode="None" MaxHeight="260">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Guard pay hours (for payroll prep)" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ListView x:Name="GuardList" SelectionMode="None" MaxHeight="240">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
