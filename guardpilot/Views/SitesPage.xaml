<Page
    x:Class="GuardPilot.Views.SitesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Client site" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="ClientBox" Header="Client" />
                <TextBox x:Name="SiteBox" Header="Site name" />
                <TextBox x:Name="AddressBox" Header="Site address" AcceptsReturn="True" TextWrapping="Wrap" Height="48" />
                <TextBox x:Name="ContractBox" Header="Contract reference" />
                <TextBox x:Name="RateBox" Header="Bill rate ($/hour, your contract figure)" InputScope="CurrencyAmount" />
                <TextBox x:Name="TermsBox" Header="Billing terms" />
                <TextBox x:Name="ContactBox" Header="Site contact" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="Posts at this site" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
                <ListView x:Name="PostsList" SelectionMode="None" MaxHeight="160">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLine}" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBox x:Name="PostBox" Header="New post name" />
                <Button x:Name="PostButton" Content="Add post to this site" Click="PostButton_Click" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Address}" Opacity="0.75" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
