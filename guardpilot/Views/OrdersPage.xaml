<Page
    x:Class="GuardPilot.Views.OrdersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Post orders" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Orders change; the revision history doesn't. Publishing a new revision supersedes the old one - the version in force on any past night stays retrievable here." Opacity="0.75" TextWrapping="Wrap" />
                <ComboBox x:Name="PostPicker" Header="Post" HorizontalAlignment="Stretch" SelectionChanged="PostPicker_SelectionChanged" />
                <TextBox x:Name="OrdersBox" Header="Standing orders" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
                <TextBox x:Name="InstructionsBox" Header="Site instructions" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                <TextBox x:Name="EmergencyBox" Header="Emergency contacts" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <TextBox x:Name="EscalationBox" Header="Escalation chain" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PublishButton" Content="Publish as new revision" Click="PublishButton_Click" />
                    <Button x:Name="PrintButton" Content="Export in-force orders (HTML)" Click="PrintButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="2" Spacing="8">
            <TextBlock Text="Revision history" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="HistoryList" SelectionChanged="HistoryList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="DetailText" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
