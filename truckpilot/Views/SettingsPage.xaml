<Page
    x:Class="TruckPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Operator profile" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Your IFTA identity, printed on every worksheet and audit export. Stored only on this PC." Opacity="0.75" TextWrapping="Wrap" />
            <TextBox x:Name="LegalNameBox" Header="Legal name" />
            <TextBox x:Name="DbaBox" Header="DBA (if any)" />
            <TextBox x:Name="AccountBox" Header="IFTA account number" />
            <TextBox x:Name="BaseBox" Header="Base jurisdiction" />
            <TextBox x:Name="UnitBox" Header="Unit / truck number" />
            <TextBox x:Name="VinBox" Header="VIN (stored as text)" />
            <ComboBox x:Name="FuelTypeCombo" Header="Fuel type" HorizontalAlignment="Stretch" />
            <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
            <Button x:Name="SaveButton" Content="Save profile" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
