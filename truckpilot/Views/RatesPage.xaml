<Page
    x:Class="TruckPilot.Views.RatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Rate table" FontSize="20" FontWeight="SemiBold" />
                <Border Background="#33FFA500" CornerRadius="6" Padding="10">
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Text="TruckPilot ships with NO tax rates on purpose. Copy each rate from the official IFTA rate chart for the quarter, enter it here, and confirm it. Only rates YOU confirm are ever used. Rates change quarterly - last quarter's rate is never carried forward automatically." />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="YearBox" Header="Year" Width="100" />
                    <ComboBox x:Name="QuarterCombo" Header="Quarter" Width="110" />
                </StackPanel>
                <TextBox x:Name="JurisdictionBox" Header="Jurisdiction" />
                <TextBox x:Name="RateBox" Header="Rate per gallon ($) - exactly as published" />
                <TextBox x:Name="SourceBox" Header="Source (e.g. IFTA rate chart Q3 2026)" />
                <CheckBox x:Name="ConfirmCheck" Content="I confirm this rate matches the official published chart" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" Padding="4,4" TextWrapping="Wrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
