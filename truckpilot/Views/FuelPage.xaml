<Page
    x:Class="TruckPilot.Views.FuelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Fuel purchase" FontSize="20" FontWeight="SemiBold" />
                <DatePicker x:Name="DatePicker" Header="Date" />
                <TextBox x:Name="JurisdictionBox" Header="Jurisdiction (where purchased)" />
                <TextBox x:Name="GallonsBox" Header="Gallons (3 decimals, as on the receipt)" />
                <TextBox x:Name="CostBox" Header="Total cost ($)" />
                <TextBox x:Name="ReceiptBox" Header="Receipt reference" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <ComboBox x:Name="QuarterFilter" Header="Show" HorizontalAlignment="Stretch" SelectionChanged="QuarterFilter_SelectionChanged" />
                <TextBlock x:Name="TotalText" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" Padding="4,4" TextWrapping="Wrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
