<Page
    x:Class="TruckPilot.Views.WorksheetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Quarterly IFTA worksheet" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Standard worksheet arithmetic on YOUR records: total miles, total gallons, average MPG (2 decimals), taxable gallons per jurisdiction (whole gallons), less tax-paid gallons, times YOUR confirmed rate for that quarter. Nothing is filed from here - this produces the numbers you transcribe onto your base jurisdiction's return." TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="YearBox" Header="Year" Width="100" />
                <ComboBox x:Name="QuarterCombo" Header="Quarter" Width="120" />
                <Button x:Name="ComputeButton" Content="Compute" Click="ComputeButton_Click" VerticalAlignment="Bottom" />
                <Button x:Name="ExportButton" Content="Export worksheet (.html)" Click="ExportButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ListView x:Name="RowsList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="MissingText" TextWrapping="Wrap" Foreground="Orange" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
