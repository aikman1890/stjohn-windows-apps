<?xml version="1.0" encoding="UTF-8"?>
<!--
  StablePilot MSI installer - WiX Toolset v5, per-user (no admin / no UAC).
  Installs to %LOCALAPPDATA%\Programs\St. John Pictures\StablePilot.
  The <ComponentGroupRef Id="AppFiles" /> is satisfied by Files.wxs, which
  the build workflow generates from the publish output.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="StablePilot"
           Language="1033"
           Version="1.0.0"
           Manufacturer="St. John Pictures"
           ProductCode="8EA69BD9-2AAC-4F24-A225-70BF42736ADA"
           UpgradeCode="DDD0020B-9982-40F6-9E6F-FD09D441C1BF"
           Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of StablePilot is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPPRODUCTICON" Value="[INSTALLFOLDER]StablePilot.exe" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://aikman1890.github.io/stjohn-windows-apps/" />

    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="CompanyDir" Name="St. John Pictures">
          <Directory Id="INSTALLFOLDER" Name="StablePilot" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutsDir" Name="StablePilot">
        <Component Id="StartMenuShortcut" Guid="AA9A5A18-244D-4A17-B194-F1D56E76182F" Bitness="always64">
          <Shortcut Id="AppStartMenuShortcut"
                    Name="StablePilot"
                    Description="StablePilot - boarding and training barn horse book for Windows"
                    Target="[INSTALLFOLDER]StablePilot.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppShortcutsDir" Directory="AppShortcutsDir" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\St. John Pictures\StablePilot"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="StablePilot" Level="1">
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
</Wix>
