<Page
    x:Class="WheelPilot.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WheelPilot.Models">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
            <TextBlock Text="Week board" FontSize="22" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PrevButton" Content="&lt; Prev week" Click="PrevButton_Click" />
                <TextBlock x:Name="WeekText" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button x:Name="NextButton" Content="Next week &gt;" Click="NextButton_Click" />
            </StackPanel>
            <TextBlock Text="Problems in the visible week (double-bookings and out-of-service cars are hard blocks on save)" FontWeight="SemiBold" Margin="0,6,0,0" />
            <ListView x:Name="ProblemList" SelectionMode="None" MaxHeight="170">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ListView x:Name="LessonList" SelectionChanged="LessonList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Lesson">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="NewButton" Content="New lesson" Click="NewButton_Click" HorizontalAlignment="Left" />
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Lesson" FontSize="19" FontWeight="SemiBold" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="StudentBox" Grid.Row="0" Grid.Column="0" Header="Student" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                    <ComboBox x:Name="StatusBox" Grid.Row="0" Grid.Column="1" Header="Status" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                    <ComboBox x:Name="InstructorBox" Grid.Row="1" Grid.Column="0" Header="Instructor" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                    <ComboBox x:Name="CarBox" Grid.Row="1" Grid.Column="1" Header="Car" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                    <CalendarDatePicker x:Name="DatePicker" Grid.Row="2" Grid.Column="0" Header="Date" Margin="0,0,8,8" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="StartBox" Header="Start (24h)" Width="110" />
                        <TextBox x:Name="DurationBox" Header="Hours" Width="90" />
                    </StackPanel>
                    <TextBlock x:Name="BalanceHintText" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Opacity="0.8" TextWrapping="Wrap" />
                </Grid>
                <TextBox x:Name="PickupBox" Header="Pickup location (home / school / meet point)" />
                <TextBox x:Name="SkillsBox" Header="Skills covered (completed lessons)" />
                <TextBox x:Name="NotesBox" Header="Instructor notes" AcceptsReturn="True" TextWrapping="Wrap" Height="56" />
                <TextBox x:Name="NextBox" Header="Next-lesson recommendation" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save lesson (conflict-checked)" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
