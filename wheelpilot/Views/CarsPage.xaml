<Page
    x:Class="WheelPilot.Views.CarsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WheelPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Cars" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="An out-of-service car cannot be scheduled. Inspection / registration / insurance dates are the school's own records with expiry warnings - records, not verification." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="CarList" SelectionChanged="CarList_SelectionChanged" MaxHeight="180">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Car">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                            <Ellipse Width="12" Height="12" Fill="{x:Bind FlagBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid MaxWidth="760" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="CarNameBox" Grid.Row="0" Grid.Column="0" Header="Car label" Margin="0,0,8,8" />
                <TextBox x:Name="PlateBox" Grid.Row="0" Grid.Column="1" Header="Plate (as recorded)" Margin="0,0,0,8" />
                <CalendarDatePicker x:Name="InspPicker" Grid.Row="1" Grid.Column="0" Header="Inspection expiry" Margin="0,0,8,8" />
                <CalendarDatePicker x:Name="RegPicker" Grid.Row="1" Grid.Column="1" Header="Registration expiry" Margin="0,0,0,8" />
                <CalendarDatePicker x:Name="InsPicker" Grid.Row="2" Grid.Column="0" Header="Insurance / dual-control record expiry" Margin="0,0,8,8" />
                <CheckBox x:Name="OosCheck" Grid.Row="2" Grid.Column="1" Content="Out of service (blocks scheduling)" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                <TextBox x:Name="OosNoteBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Header="Out-of-service note" Margin="0,0,0,8" />
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveCarButton" Content="Save car" Click="SaveCarButton_Click" />
                    <Button x:Name="NewCarButton" Content="New car" Click="NewCarButton_Click" />
                    <Button x:Name="DeleteCarButton" Content="Delete" Click="DeleteCarButton_Click" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Maintenance log" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListView x:Name="MaintList" SelectionMode="None" MaxHeight="150">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="WorkBox" Header="Work done / scheduled" Width="300" />
                <TextBox x:Name="CostBox" Header="Cost ($)" Width="110" />
                <Button x:Name="MaintButton" Content="Add for selected car" Click="MaintButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>

            <TextBlock Text="Instructors" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,0" />
            <ListView x:Name="InstructorList" SelectionChanged="InstructorList_SelectionChanged" MaxHeight="140">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="InstNameBox" Header="Name" Width="220" />
                <TextBox x:Name="InstPhoneBox" Header="Phone" Width="160" />
                <TextBox x:Name="InstLicenseBox" Header="Licence note (school's record)" Width="240" />
                <CheckBox x:Name="InstActiveCheck" Content="Active" IsChecked="True" VerticalAlignment="Bottom" />
                <Button x:Name="SaveInstButton" Content="Save instructor" Click="SaveInstButton_Click" VerticalAlignment="Bottom" />
                <Button x:Name="NewInstButton" Content="New" Click="NewInstButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
