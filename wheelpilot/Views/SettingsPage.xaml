<Page
    x:Class="WheelPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBox x:Name="SchoolBox" Header="School name" />
            <TextBox x:Name="AddressBox" Header="Address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
            <TextBox x:Name="PhoneBox" Header="Phone" />
            <TextBlock Text="Packages (one per line: Name|Hours|Price)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="PackagesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
            <TextBlock Text="Milestone skills (one per line)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="SkillsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
            <TextBlock Text="Courses (one per line: Course|Session|Session|...)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="CoursesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
            <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="SavedText" Opacity="0.75" />
            <TextBlock Text="WheelPilot is the school's book of record: no online booking, no parent portal, no text reminders, no DMV or state reporting, no payment processing, no curriculum. Student records — much of them minors' — never leave this computer." Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
