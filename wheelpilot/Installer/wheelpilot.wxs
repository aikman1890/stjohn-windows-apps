<?xml version="1.0" encoding="UTF-8"?>
<!--
  WheelPilot MSI installer - WiX Toolset v5, per-user (no admin / no UAC).
  Installs to %LOCALAPPDATA%\Programs\St. John Pictures\WheelPilot.
  The <ComponentGroupRef Id="AppFiles" /> is satisfied by Files.wxs, which
  the build workflow generates from the publish output.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="WheelPilot"
           Language="1033"
           Version="1.0.0"
           Manufacturer="St. John Pictures"
           ProductCode="1D8C21EA-7E1B-4171-A90E-F39B1CFB0934"
           UpgradeCode="0FE99B4D-4075-4D67-9E3D-43ABD9D245F3"
           Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of WheelPilot is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPPRODUCTICON" Value="[INSTALLFOLDER]WheelPilot.exe" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://aikman1890.github.io/stjohn-windows-apps/" />

    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="CompanyDir" Name="St. John Pictures">
          <Directory Id="INSTALLFOLDER" Name="WheelPilot" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutsDir" Name="WheelPilot">
        <Component Id="StartMenuShortcut" Guid="A67A5541-8208-4CF0-BE8F-B0C9FD3393AA" Bitness="always64">
          <Shortcut Id="AppStartMenuShortcut"
                    Name="WheelPilot"
                    Description="WheelPilot - driving school day book for Windows"
                    Target="[INSTALLFOLDER]WheelPilot.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppShortcutsDir" Directory="AppShortcutsDir" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\St. John Pictures\WheelPilot"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="WheelPilot" Level="1">
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
</Wix>
