<Page
    x:Class="LienPilot.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="LienPilot" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="FacilityText" Opacity="0.8" TextWrapping="Wrap" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Delinquency dollars by stage" FontWeight="SemiBold" Opacity="0.75" />
                        <TextBlock x:Name="DollarsText" FontSize="15" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Units by status" FontWeight="SemiBold" Opacity="0.75" />
                        <TextBlock x:Name="UnitsText" FontSize="15" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="Steps due this week" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ListView x:Name="StepsList" SelectionMode="None" MaxHeight="260">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Sales scheduled" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ListView x:Name="SalesList" SelectionMode="None" MaxHeight="200">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border Background="#33FFA500" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                <TextBlock TextWrapping="Wrap"
                           Text="LienPilot computes timelines from YOUR state profile and YOUR ledger. It ships no law and gives no legal advice: profiles are entered and confirmed by you, and every computed date shows the basis it came from. A wrong profile makes wrong dates - verify yours against your statute and your counsel." />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
