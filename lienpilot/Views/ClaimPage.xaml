<Page
    x:Class="LienPilot.Views.ClaimPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Itemized claim statement" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="The notices must state the claim itemized - so the statement is built itemized: rent balance plus your fee lines, from YOUR fee schedule in Settings. The same statement prints for the file and the tenant." TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                <ComboBox x:Name="UnitPicker" Header="Unit" HorizontalAlignment="Stretch" SelectionChanged="UnitPicker_SelectionChanged" />
                <TextBlock x:Name="StatementText" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="Add a fee line" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                <ComboBox x:Name="PresetCombo" Header="Fee preset (from Settings)" HorizontalAlignment="Stretch" SelectionChanged="PresetCombo_SelectionChanged" />
                <TextBox x:Name="DescBox" Header="Description" />
                <TextBox x:Name="AmountBox" Header="Amount ($)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddLineButton" Content="Add line" Click="AddLineButton_Click" />
                    <Button x:Name="RemoveLineButton" Content="Remove selected" Click="RemoveLineButton_Click" />
                </StackPanel>
                <Button x:Name="ExportButton" Content="Export statement (.html, printable)" Click="ExportButton_Click" HorizontalAlignment="Left" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="LinesList" Grid.Column="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
