<Page
    x:Class="LienPilot.Views.ClockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Delinquency clock" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="ProfileText" TextWrapping="Wrap" Opacity="0.8" />
            <ComboBox x:Name="UnitPicker" Header="Delinquent unit" Width="520" SelectionChanged="UnitPicker_SelectionChanged" />
            <ListView x:Name="MilestonesList" SelectionMode="None" MaxHeight="320">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="SaleText" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="16" />
            <TextBlock x:Name="BlockText" TextWrapping="Wrap" Foreground="Orange" />
            <TextBlock Text="The clock runs on your profile and your ledger entries. Change either and the dates move - that is the point: the file, not memory, drives the sale. Nothing here is a legal opinion." Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
