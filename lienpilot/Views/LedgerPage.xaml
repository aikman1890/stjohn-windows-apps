<Page
    x:Class="LienPilot.Views.LedgerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Notice proof ledger" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Every statutory step, logged when it happens, with the delivery method and tracking. This ledger is what the sale-ready check reads - and what defends the sale later." TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                <ComboBox x:Name="UnitPicker" Header="Unit" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="StepCombo" Header="Step" HorizontalAlignment="Stretch" />
                <DatePicker x:Name="DatePicker" Header="Date" />
                <ComboBox x:Name="MethodCombo" Header="Delivery method" HorizontalAlignment="Stretch" />
                <TextBox x:Name="TrackingBox" Header="Tracking / certificate number" />
                <TextBox x:Name="NoteBox" Header="Proof note (where the receipt lives)" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding UnitLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DisplayLine}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
