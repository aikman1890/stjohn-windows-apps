<Page
    x:Class="LienPilot.Views.TemplatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Notice &amp; ad templates" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Working text merged from the unit file. These are starting drafts, not legal forms - have your counsel approve your versions, and keep the approved text here. Recording a send writes it into the proof ledger." TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                <ComboBox x:Name="UnitPicker" Header="Unit" HorizontalAlignment="Stretch" SelectionChanged="Pickers_SelectionChanged" />
                <ComboBox x:Name="TemplatePicker" Header="Template" HorizontalAlignment="Stretch" SelectionChanged="Pickers_SelectionChanged" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveTextButton" Content="Save edited text" Click="SaveTextButton_Click" />
                    <Button x:Name="ResetButton" Content="Reset to default" Click="ResetButton_Click" />
                </StackPanel>
                <ComboBox x:Name="MethodCombo" Header="Delivery method (for the ledger entry)" HorizontalAlignment="Stretch" />
                <TextBox x:Name="TrackingBox" Header="Tracking / certificate number" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RecordButton" Content="Record as sent today" Click="RecordButton_Click" />
                    <Button x:Name="ExportButton" Content="Export (.txt)" Click="ExportButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <TextBox x:Name="BodyBox" Grid.Column="2" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Consolas" FontSize="13" />
    </Grid>
</Page>
