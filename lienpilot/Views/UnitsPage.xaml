<Page
    x:Class="LienPilot.Views.UnitsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Unit / tenancy" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="UnitBox" Header="Unit number" />
                <TextBox x:Name="TenantBox" Header="Tenant name" />
                <TextBox x:Name="PhoneBox" Header="Tenant phone" />
                <TextBox x:Name="EmailBox" Header="Tenant email" />
                <TextBox x:Name="AddressBox" Header="Tenant address (as in the rental agreement)" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="RateBox" Header="Monthly rate ($)" Width="130" />
                    <TextBox x:Name="BalanceBox" Header="Balance owed ($)" Width="130" />
                </StackPanel>
                <DatePicker x:Name="PaidThroughPicker" Header="Paid through" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch" />
                <DatePicker x:Name="DefaultPicker" Header="Default date (first missed due date)" />
                <CheckBox x:Name="DefaultCheck" Content="This tenancy is in default (set the date)" />
                <DatePicker x:Name="SalePicker" Header="Sale date (when scheduled)" />
                <CheckBox x:Name="SaleCheck" Content="A sale date is scheduled" />
                <TextBlock Text="Hold flags - while any of these stands, the sale-ready check fails on purpose:" FontWeight="SemiBold" Margin="0,4,0,0" />
                <CheckBox x:Name="BankruptcyCheck" Content="Bankruptcy flag (tenant filed - user-set)" />
                <CheckBox x:Name="MilitaryCheck" Content="Military-status flag (user-set)" />
                <CheckBox x:Name="DisputeCheck" Content="Dispute flag (tenant disputes the claim - user-set)" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock x:Name="HistoryText" TextWrapping="Wrap" Opacity="0.85" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" Foreground="{Binding BalanceBrush}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
