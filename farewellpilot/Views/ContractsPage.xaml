<Page
    x:Class="FarewellPilot.Views.ContractsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Contract &amp; payments" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="CasePicker" Header="Case" HorizontalAlignment="Stretch" SelectionChanged="CasePicker_SelectionChanged" />
                <TextBlock x:Name="BalanceText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Contract line" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                <ComboBox x:Name="CategoryCombo" Header="Category" HorizontalAlignment="Stretch" />
                <TextBox x:Name="LineDescBox" Header="Description" />
                <TextBox x:Name="LineAmountBox" Header="Amount ($)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddLineButton" Content="Add line" Click="AddLineButton_Click" />
                    <Button x:Name="RemoveLineButton" Content="Remove selected line" Click="RemoveLineButton_Click" />
                </StackPanel>
                <TextBlock Text="Payment received" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="PayAmountBox" Header="Amount ($)" Width="120" />
                    <TextBox x:Name="PayMethodBox" Header="Method" Width="120" />
                    <TextBox x:Name="PayNoteBox" Header="Note" Width="110" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddPayButton" Content="Record payment" Click="AddPayButton_Click" />
                    <Button x:Name="RemovePayButton" Content="Remove selected payment" Click="RemovePayButton_Click" />
                </StackPanel>
                <TextBlock Text="Insurance assignment" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="InsurerBox" Header="Insurer" Width="150" />
                    <TextBox x:Name="PolicyBox" Header="Policy ref" Width="110" />
                    <TextBox x:Name="AssignAmountBox" Header="Amount ($)" Width="100" />
                </StackPanel>
                <ComboBox x:Name="AssignStatusCombo" Header="Assignment status" HorizontalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddAssignButton" Content="Add assignment" Click="AddAssignButton_Click" />
                    <Button x:Name="AdvanceAssignButton" Content="Advance selected status" Click="AdvanceAssignButton_Click" />
                </StackPanel>
                <Button x:Name="StatementButton" Content="Export family statement (.html)" Click="StatementButton_Click" HorizontalAlignment="Left" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="2" Spacing="8">
            <TextBlock Text="Contract lines" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="LinesList" MaxHeight="200">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Payments" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="PaymentsList" MaxHeight="160">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Assignments on this case" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="AssignList" MaxHeight="140">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Receivables aging (all cases)" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="AgingList" SelectionMode="None" MaxHeight="180">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
