<Page
    x:Class="FarewellPilot.Views.CasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Case file" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="DecedentBox" Header="Decedent name" />
                <DatePicker x:Name="DodPicker" Header="Date of death" />
                <CheckBox x:Name="DodCheck" Content="Date of death recorded" />
                <TextBox x:Name="KinBox" Header="Next of kin / decision maker" />
                <TextBox x:Name="KinRelBox" Header="Relationship" />
                <TextBox x:Name="KinPhoneBox" Header="Kin phone" />
                <TextBox x:Name="KinEmailBox" Header="Kin email" />
                <ComboBox x:Name="TypeCombo" Header="Service type" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch" />
                <DatePicker x:Name="ServicePicker" Header="Service date" />
                <CheckBox x:Name="ServiceCheck" Content="Service scheduled (set date)" />
                <TextBox x:Name="LocationBox" Header="Service location" />
                <CheckBox x:Name="VeteranCheck" Content="Veteran (discharge papers belong in Documents)" />
                <DatePicker x:Name="DcPicker" Header="Death certificate filed" />
                <CheckBox x:Name="DcCheck" Content="Death certificate filed (set date)" />
                <TextBox x:Name="PermitBox" Header="Permit note" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save case" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>

                <TextBlock Text="Arrangement checklist" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox x:Name="InitialsBox" Header="Your name / initials (for checklist sign-off)" />
                <ListView x:Name="ChecklistList" MaxHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ToggleItemButton" Content="Toggle done" Click="ToggleItemButton_Click" />
                    <TextBox x:Name="CustomItemBox" Header="Add custom item" Width="180" />
                    <Button x:Name="AddItemButton" Content="Add" Click="AddItemButton_Click" VerticalAlignment="Bottom" />
                </StackPanel>

                <TextBlock Text="Documents (local paths)" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="DocKindBox" Header="Kind" Width="140" />
                    <TextBox x:Name="DocPathBox" Header="File path" Width="200" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PickDocButton" Content="Pick file..." Click="PickDocButton_Click" />
                    <Button x:Name="AddDocButton" Content="Attach path" Click="AddDocButton_Click" />
                    <Button x:Name="RemoveDocButton" Content="Remove" Click="RemoveDocButton_Click" />
                </StackPanel>
                <ListView x:Name="DocsList" MaxHeight="140">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="Documents are recorded by path and stay where they live on this PC - FarewellPilot never copies or uploads family paperwork." TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
