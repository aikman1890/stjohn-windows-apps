<Page
    x:Class="FarewellPilot.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="FarewellPilot" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="HomeText" Opacity="0.8" TextWrapping="Wrap" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Open cases" FontWeight="SemiBold" Opacity="0.75" />
                        <TextBlock x:Name="CasesText" FontSize="15" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Receivables &amp; preneed" FontWeight="SemiBold" Opacity="0.75" />
                        <TextBlock x:Name="MoneyText" FontSize="15" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="Paperwork clocks - overdue and due this week" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ListView x:Name="ClocksList" SelectionMode="None" MaxHeight="240">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Aftercare due this week" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ListView x:Name="AftercareList" SelectionMode="None" MaxHeight="200">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Family information in this app never leaves this computer. Clocks run on the windows you set in Settings from your own state rules - FarewellPilot ships no law and gives no legal advice." Opacity="0.7" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
