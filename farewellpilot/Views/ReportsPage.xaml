<Page
    x:Class="FarewellPilot.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="900">
            <TextBlock Text="Reports" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="ReportText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" />
            <Button x:Name="ExportButton" Content="Export report (.html)" Click="ExportButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
            <TextBlock Text="The accountant summary: cases by type and month, receivables aging, preneed totals, and cash advances outstanding - straight from the case book, no re-typing." Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
