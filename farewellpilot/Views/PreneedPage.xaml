<Page
    x:Class="FarewellPilot.Views.PreneedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Preneed contract" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="PurchaserBox" Header="Purchaser" />
                <TextBox x:Name="BeneficiaryBox" Header="Beneficiary (the person the plan is for)" />
                <DatePicker x:Name="DatePicker" Header="Contract date" />
                <TextBox x:Name="TotalBox" Header="Total amount ($)" />
                <ComboBox x:Name="FundingCombo" Header="Funded by" HorizontalAlignment="Stretch" />
                <TextBox x:Name="FundingRefBox" Header="Trust / policy reference" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch" />
                <TextBox x:Name="NotesBox" Header="Notes (transfers, cancellations)" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="Deposit log (selected contract)" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock x:Name="DepositSummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="DepAmountBox" Header="Amount ($)" Width="120" />
                    <TextBox x:Name="DepDestBox" Header="Destination" Width="180" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddDepButton" Content="Log deposit" Click="AddDepButton_Click" />
                    <Button x:Name="RemoveDepButton" Content="Remove selected deposit" Click="RemoveDepButton_Click" />
                </StackPanel>
                <TextBlock Text="Every preneed dollar must have a deposit entry - that is the reconciliation an examiner asks for. Deposits are recorded here, never moved; FarewellPilot touches no bank." TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="2" Spacing="8">
            <TextBlock Text="Contracts" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="ItemsList" MaxHeight="300" SelectionChanged="ItemsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Deposits for the selected contract" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="DepositsList" MaxHeight="200">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Reconciliation (all active contracts)" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="ReconList" SelectionMode="None" MaxHeight="220">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
