<Page
    x:Class="FarewellPilot.Views.AftercarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Aftercare" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Follow-ups are scheduled automatically when a case completes its service: a week, a month, the anniversary. Add custom ones here. The referral engine, written down so it survives a busy week." TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                <ComboBox x:Name="CasePicker" Header="Case (for a custom follow-up)" HorizontalAlignment="Stretch" />
                <TextBox x:Name="KindBox" Header="Kind (e.g. Holiday check-in)" />
                <DatePicker x:Name="DuePicker" Header="Due date" />
                <TextBox x:Name="NoteBox" Header="Note" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddButton" Content="Add follow-up" Click="AddButton_Click" />
                    <Button x:Name="DoneButton" Content="Mark selected done" Click="DoneButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="2" Spacing="8">
            <TextBlock Text="Due this week and overdue" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="DueList" MaxHeight="260">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="All follow-ups" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="AllList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
