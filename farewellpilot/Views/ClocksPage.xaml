<Page
    x:Class="FarewellPilot.Views.ClocksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Paperwork clocks" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="BasisText" TextWrapping="Wrap" Opacity="0.8" />
            <TextBlock Text="Death certificate filing" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListView x:Name="DcList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Preneed deposit clocks" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListView x:Name="DepositList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Permits &amp; other tracked items" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListView x:Name="PermitList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
