<Window
    x:Class="SreToolbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SRE Toolbox">

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        SelectionChanged="NavView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Subnet Calculator" Tag="subnet">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Calculator" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="CIDR Reference" Tag="cidr">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Document" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Cron Explainer" Tag="cron">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Calendar" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Common Ports" Tag="ports">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="List" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <TextBlock
                Text="St. John Pictures - computed locally, nothing leaves this PC"
                FontSize="11"
                Opacity="0.7"
                TextWrapping="Wrap"
                Margin="12,0,12,12" />
        </NavigationView.PaneFooter>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
