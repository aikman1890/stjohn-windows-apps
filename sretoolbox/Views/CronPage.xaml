<Page
    x:Class="SreToolbox.Views.CronPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Cron Expression Explainer" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Paste a standard 5-field cron expression (minute hour day-of-month month day-of-week) to read it in plain language." Opacity="0.75" TextWrapping="Wrap" />
            <TextBox x:Name="CronBox" Header="Cron expression" Text="0 2 * * 1-5" FontFamily="Consolas" />
            <Button x:Name="ExplainButton" Content="Explain" Click="ExplainButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
            <TextBlock x:Name="OutputText" FontSize="14" TextWrapping="Wrap" />
            <TextBlock Text="Examples: */15 * * * * (every 15 minutes) - 30 4 1 * * (04:30 on day 1) - 0 0 * * 0 (midnight on Sundays)"
                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
