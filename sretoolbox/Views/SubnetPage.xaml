<Page
    x:Class="SreToolbox.Views.SubnetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="IPv4 Subnet Calculator" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Enter an IPv4 address and a prefix length. Everything is computed locally." Opacity="0.75" TextWrapping="Wrap" />
            <TextBox x:Name="IpBox" Header="IPv4 address" Text="192.168.1.10" />
            <TextBox x:Name="PrefixBox" Header="Prefix length (0-32)" Text="24" />
            <Button x:Name="CalcButton" Content="Calculate" Click="CalcButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
            <TextBlock x:Name="ResultsText" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
