<Page
    x:Class="SreToolbox.Views.CidrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="10">
        <TextBlock Text="CIDR Reference" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Prefix length, netmask, address count, and usable hosts for common IPv4 subnet sizes." Opacity="0.75" TextWrapping="Wrap" />
        <ListView x:Name="RowsList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13" Padding="4,3" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</Page>
