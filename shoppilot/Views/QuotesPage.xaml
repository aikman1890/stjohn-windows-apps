<Page
    x:Class="ShopPilot.Views.QuotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Quote" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="CustomerPicker" Header="Customer" HorizontalAlignment="Stretch" />
                <TextBox x:Name="PartBox" Header="Part description" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="PartNoBox" Header="Part #" Width="180" />
                    <TextBox x:Name="QtyBox" Header="Quantity" Width="110" />
                </StackPanel>
                <TextBox x:Name="MaterialBox" Header="Material" />
                <TextBox x:Name="BreaksBox" Header="Quantity breaks quoted (e.g. 10 / 50 / 100)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="PriceBox" Header="Quoted price $" Width="170" />
                    <TextBox x:Name="LeadBox" Header="Lead time (days)" Width="140" />
                </StackPanel>
                <TextBlock Text="Your cost estimate (drives the margin views)" FontWeight="SemiBold" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="EstMatBox" Header="Material $" Width="120" />
                    <TextBox x:Name="EstHoursBox" Header="Labor hrs" Width="110" />
                    <TextBox x:Name="EstOutBox" Header="Outside $" Width="120" />
                </StackPanel>
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch">
                    <x:String>Open</x:String>
                    <x:String>Won</x:String>
                    <x:String>Lost</x:String>
                    <x:String>No-bid</x:String>
                </ComboBox>
                <TextBox x:Name="LossBox" Header="Loss reason (price, lead time, incumbent...)" />
                <DatePicker x:Name="DatePickerCtl" Header="Quote date" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <Button x:Name="JobButton" Content="Create job from this quote (won)" Click="JobButton_Click" />
                <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
