<Page
    x:Class="ShopPilot.Views.JobsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Job card" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="CustomerPicker" Header="Customer" HorizontalAlignment="Stretch" />
                <TextBox x:Name="PartBox" Header="Part description" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="PartNoBox" Header="Part #" Width="150" />
                    <TextBox x:Name="QtyBox" Header="Qty ordered" Width="110" />
                    <TextBox x:Name="ShipQtyBox" Header="Qty shipped" Width="110" />
                </StackPanel>
                <TextBox x:Name="MaterialBox" Header="Material" />
                <TextBox x:Name="CertBox" Header="Material cert reference (that a cert exists &amp; where filed - free text)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="MatCostBox" Header="Material cost $" Width="150" />
                    <TextBox x:Name="PriceBox" Header="Quoted price $" Width="150" />
                </StackPanel>
                <DatePicker x:Name="DuePicker" Header="Due date" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="PoBox" Header="Customer PO" Width="170" />
                    <TextBox x:Name="PriorityBox" Header="Priority (1=first)" Width="130" />
                </StackPanel>
                <ComboBox x:Name="CenterPicker" Header="Current work center" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch">
                    <x:String>Open</x:String>
                    <x:String>In process</x:String>
                    <x:String>Complete</x:String>
                    <x:String>Shipped</x:String>
                    <x:String>Closed</x:String>
                </ComboBox>
                <TextBox x:Name="InvoiceBox" Header="Invoice reference (InvoicePilot / your accounting)" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="40" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ShipButton" Content="Mark shipped today" Click="ShipButton_Click" />
                    <Button x:Name="TravelerButton" Content="Export traveler (HTML)" Click="TravelerButton_Click" />
                </StackPanel>
                <TextBlock x:Name="CostText" FontSize="14" TextWrapping="Wrap" />

                <TextBlock Text="Operations (the route)" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" />
                <ComboBox x:Name="OpPicker" Header="Operation library" HorizontalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="PlannedBox" Header="Planned hrs" Width="120" />
                    <Button x:Name="AddOpButton" Content="Add operation" Click="AddOpButton_Click" VerticalAlignment="Bottom" />
                </StackPanel>
                <ListView x:Name="OpsList" MaxHeight="220" SelectionChanged="OpsList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="ActualBox" Header="Actual hrs" Width="110" />
                    <TextBox x:Name="SignBox" Header="Sign-off" Width="110" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveOpButton" Content="Save op / sign off" Click="SaveOpButton_Click" />
                    <Button x:Name="RemoveOpButton" Content="Remove op" Click="RemoveOpButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" Foreground="{Binding DueBrush}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
