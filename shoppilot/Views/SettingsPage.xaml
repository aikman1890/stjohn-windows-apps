<Page
    x:Class="ShopPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBox x:Name="ShopBox" Header="Shop name (prints on travelers)" />
            <TextBox x:Name="AddressBox" Header="Shop address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
            <TextBox x:Name="PhoneBox" Header="Shop phone" />
            <TextBox x:Name="RateBox" Header="Labor rate ($/hr - turns traveler hours into labor cost)" />
            <TextBlock Text="Work centers (one per line)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="CentersBox" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
            <TextBlock Text="Operation library - one per line: Name|WorkCenter" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="OpsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="130" />
            <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="SavedText" Opacity="0.75" />
            <TextBlock Text="Everything is stored locally in this app's folder - no account, no cloud, no telemetry. One flat membership: every seat in the shop is included, always." Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
