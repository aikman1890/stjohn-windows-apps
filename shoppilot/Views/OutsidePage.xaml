<Page
    x:Class="ShopPilot.Views.OutsidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Outside service PO" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Plating, heat treat, coating - with promised vs. actual return dates. Cert references are recorded as free text (ShopPilot notes that a cert exists and where it is filed; it is not a QMS)." Opacity="0.75" TextWrapping="Wrap" />
                <ComboBox x:Name="JobPicker" Header="Job" HorizontalAlignment="Stretch" />
                <TextBox x:Name="VendorBox" Header="Vendor" />
                <TextBox x:Name="ServiceBox" Header="Service" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="PoBox" Header="PO number" Width="160" />
                    <TextBox x:Name="CostBox" Header="Cost $" Width="140" />
                </StackPanel>
                <DatePicker x:Name="SentPicker" Header="Sent date" />
                <DatePicker x:Name="PromisedPicker" Header="Promised return" />
                <CheckBox x:Name="ReturnedCheck" Content="Returned (set return date)" Checked="ReturnedCheck_Changed" Unchecked="ReturnedCheck_Changed" />
                <DatePicker x:Name="ReturnedPicker" Header="Returned date" IsEnabled="False" />
                <TextBox x:Name="CertBox" Header="Cert reference" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
