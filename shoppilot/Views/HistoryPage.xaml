<Page
    x:Class="ShopPilot.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Customers &amp; part history" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Every quote and job for a customer in one view - and the repeat-part question answered: what did we charge for this part last time, and did we make money?" Opacity="0.8" TextWrapping="Wrap" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBox x:Name="NameBox" Header="Customer name" />
                    <TextBox x:Name="ContactBox" Header="Contact" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="EmailBox" Header="Email" Width="170" />
                        <TextBox x:Name="PhoneBox" Header="Phone" Width="150" />
                    </StackPanel>
                    <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveCustButton" Content="Add / Save customer" Click="SaveCustButton_Click" />
                        <Button x:Name="DeleteCustButton" Content="Delete" Click="DeleteCustButton_Click" />
                    </StackPanel>
                    <ComboBox x:Name="CustomerPicker" Header="View history for" HorizontalAlignment="Stretch" SelectionChanged="CustomerPicker_SelectionChanged" />
                    <TextBox x:Name="PartSearchBox" Header="Repeat-part lookup (part # or description contains)" />
                    <Button x:Name="SearchButton" Content="Search part history" Click="SearchButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
                <ListView x:Name="HistoryList" Grid.Column="2" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
