<Page
    x:Class="ClientPilot.Views.ProspectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Prospect details" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="CompanyBox" Header="Company" />
                <TextBox x:Name="EmailBox" Header="Contact email" />
                <ComboBox x:Name="PitchTypeCombo" Header="Pitch type" HorizontalAlignment="Stretch" />
                <DatePicker x:Name="PitchDatePicker" Header="Pitch date" />
                <ComboBox x:Name="StatusCombo" Header="Reply status" HorizontalAlignment="Stretch" />
                <DatePicker x:Name="FollowUpPicker" Header="Follow-up date" />
                <CheckBox x:Name="FollowUpCheck" Content="Set a follow-up date" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubLine}" Opacity="0.75" FontSize="12" />
                        <TextBlock Text="{Binding FollowUpText}" FontSize="12" Opacity="0.75" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
