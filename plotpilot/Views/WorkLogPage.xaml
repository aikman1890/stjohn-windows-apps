<Page
    x:Class="PlotPilot.Views.WorkLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Work log entry" FontSize="20" FontWeight="SemiBold" />
                <DatePicker x:Name="DatePickerCtl" Header="Date" />
                <ComboBox x:Name="KindCombo" Header="Kind" HorizontalAlignment="Stretch">
                    <x:String>Opening</x:String>
                    <x:String>Closing</x:String>
                    <x:String>Marker setting</x:String>
                    <x:String>Maintenance</x:String>
                    <x:String>Other</x:String>
                </ComboBox>
                <TextBox x:Name="SpaceBox" Header="Space (address, if tied to one)" />
                <TextBox x:Name="NoteBox" Header="Note" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                <TextBox x:Name="ByBox" Header="By whom" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
