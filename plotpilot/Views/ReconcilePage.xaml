<Page
    x:Class="PlotPilot.Views.ReconcilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Reconciliation" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Where the plat, the notebooks, and the register disagree - listed for the board to work through deliberately, instead of being discovered during a burial. PlotPilot flags conflicts; it never settles them, and it makes no determination of burial rights." Opacity="0.8" TextWrapping="Wrap" />
            <TextBlock x:Name="CountText" FontWeight="SemiBold" />
            <ListView x:Name="ConflictList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,4" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
