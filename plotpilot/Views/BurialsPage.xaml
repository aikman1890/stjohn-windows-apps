<Page
    x:Class="PlotPilot.Views.BurialsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Burial record" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="SpacePicker" Header="Space" HorizontalAlignment="Stretch" />
                <TextBox x:Name="NameBox" Header="Decedent name" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <DatePicker x:Name="BirthPicker" Header="Born" />
                    <CheckBox x:Name="BirthCheck" Content="Known" VerticalAlignment="Bottom" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <DatePicker x:Name="DeathPicker" Header="Died" />
                    <CheckBox x:Name="DeathCheck" Content="Known" VerticalAlignment="Bottom" />
                </StackPanel>
                <DatePicker x:Name="InterPicker" Header="Interment date" />
                <TextBox x:Name="FuneralBox" Header="Funeral home" />
                <TextBox x:Name="MarkerBox" Header="Marker notes" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <CheckBox x:Name="VeteranCheck" Content="Veteran (as recorded by the office)" />
                <TextBox x:Name="SourceBox" Header="Source (which notebook/page this came from)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="Saving a burial marks its space Occupied." Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
