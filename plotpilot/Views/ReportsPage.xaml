<Page
    x:Class="PlotPilot.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Reports &amp; export" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Available inventory by section" FontSize="17" FontWeight="SemiBold" />
            <ListView x:Name="InventoryList" SelectionMode="None" MaxHeight="220">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Burials by year" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ListView x:Name="BurialList" SelectionMode="None" MaxHeight="220">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Sales by year (from the ownership chain)" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ListView x:Name="SalesList" SelectionMode="None" MaxHeight="220">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="CsvButton" Content="Export the full register (CSV - spaces + burials)" Click="CsvButton_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
            <TextBlock Text="The export is plain and complete on purpose: the cemetery's records must outlive any vendor, including this one. Print an archival copy for the office safe." Opacity="0.75" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
