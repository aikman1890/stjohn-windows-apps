<Page
    x:Class="PlotPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBox x:Name="NameBox" Header="Cemetery name" />
            <TextBox x:Name="AddressBox" Header="Cemetery address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
            <TextBox x:Name="PhoneBox" Header="Office phone" />
            <TextBlock Text="Sections (one per line - blocks, lots, and spaces stay free text per space, matching your plat)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="SectionsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
            <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="SavedText" Opacity="0.75" />
            <TextBlock Text="Everything is stored locally in this app's folder - no account, no cloud, no telemetry. The records live in plain local files the cemetery owns outright." Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
