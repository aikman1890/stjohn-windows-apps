<Page
    x:Class="PlotPilot.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Plot space" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Addressing is your cemetery's own scheme - section / block / lot / space, exactly as your plat names them." Opacity="0.75" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="SectionBox" Header="Section" Width="190" />
                    <TextBox x:Name="BlockBox" Header="Block" Width="190" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="LotBox" Header="Lot" Width="190" />
                    <TextBox x:Name="SpaceBox" Header="Space" Width="190" />
                </StackPanel>
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch">
                    <x:String>Available</x:String>
                    <x:String>Sold</x:String>
                    <x:String>Reserved</x:String>
                    <x:String>Occupied</x:String>
                    <x:String>Unknown</x:String>
                </ComboBox>
                <TextBox x:Name="OwnerBox" Header="Owner of record" />
                <TextBox x:Name="DeedBox" Header="Deed reference" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="PriceBox" Header="Price as recorded $" Width="180" />
                    <TextBox x:Name="CareBox" Header="Care contribution $" Width="180" />
                </StackPanel>
                <CheckBox x:Name="PurchaseCheck" Content="Purchase date recorded" Checked="PurchaseCheck_Changed" Unchecked="PurchaseCheck_Changed" />
                <DatePicker x:Name="PurchasePicker" Header="Purchase date" IsEnabled="False" />
                <TextBox x:Name="SourceBox" Header="Source (notebook/page, deed book, plat...)" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>

                <TextBlock Text="Ownership chain for this space" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
                <ListView x:Name="ChainList" SelectionMode="None" MaxHeight="200">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ComboBox x:Name="ChainKindCombo" Header="New chain entry" HorizontalAlignment="Stretch">
                    <x:String>Sale</x:String>
                    <x:String>Transfer</x:String>
                    <x:String>Inheritance</x:String>
                    <x:String>Reservation</x:String>
                    <x:String>Note</x:String>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="FromBox" Header="From" Width="180" />
                    <TextBox x:Name="ToBox" Header="To" Width="180" />
                </StackPanel>
                <Button x:Name="ChainButton" Content="Append chain entry (today)" Click="ChainButton_Click" HorizontalAlignment="Left" />
                <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
