<Page
    x:Class="ClaimPilot.Views.CaseBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClaimPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12" MaxWidth="980">
            <TextBlock x:Uid="CaseBuilderPage_CaseBuilder" Style="{StaticResource TitleTextBlockStyle}" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <TextBlock Text="{x:Bind ViewModel.DisclaimerText}" TextWrapping="Wrap" />
            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Visibility="{x:Bind ViewModel.LockedVisibility, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Locked" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.AddOnBlurb}" TextWrapping="Wrap" />
                    <Button Content="Buy Legal Matters — $25.99/month" Click="BuyButton_Click" />
                    <TextBox x:Name="LegalMattersKeyBox" Header="Legal Matters license key" PlaceholderText="XXXXX-XXXXX-XXXXX-XXXXX" />
                    <TextBox x:Name="LegalMattersEmailBox" Header="Purchase email" PlaceholderText="Email used at purchase" InputScope="EmailSmtpAddress" />
                    <Button Content="Activate key" Click="ActivateKey_Click" HorizontalAlignment="Left" />
                    <TextBlock x:Name="KeyStatusText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.UnlockedVisibility, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.IntroText}" TextWrapping="Wrap" />

                <TextBlock x:Uid="CaseBuilderPage_TheCase" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox x:Uid="CaseBuilderPage_CaseName" Text="{x:Bind ViewModel.CaseFile.CaseName, Mode=TwoWay}" />
                <ComboBox x:Uid="CaseBuilderPage_CaseType" ItemsSource="{x:Bind ViewModel.CaseTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.CaseFile.CaseType, Mode=TwoWay}" />

                <TextBlock x:Uid="CaseBuilderPage_PartiesInvolved" Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Uid="CaseBuilderPage_PersonCompanyOrAgency" Text="{x:Bind ViewModel.NewParty, Mode=TwoWay}" MinWidth="280" />
                    <Button x:Uid="CaseBuilderPage_AddParty" Command="{x:Bind ViewModel.AddPartyCommand}" />
                </StackPanel>
                <ListView ItemsSource="{x:Bind ViewModel.CaseFile.Parties, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button x:Uid="CaseBuilderPage_Remove" Grid.Column="1" Click="RemovePartyButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Uid="CaseBuilderPage_TimelineOfEvents" Style="{StaticResource SubtitleTextBlockStyle}" />
                <DatePicker x:Uid="CaseBuilderPage_Date" Date="{x:Bind ViewModel.NewEventDate, Mode=TwoWay}" />
                <TextBox x:Uid="CaseBuilderPage_EventTitle" Text="{x:Bind ViewModel.NewEventTitle, Mode=TwoWay}" />
                <TextBox x:Uid="CaseBuilderPage_Details" Text="{x:Bind ViewModel.NewEventDetails, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                <Button x:Uid="CaseBuilderPage_AddEvent" Command="{x:Bind ViewModel.AddTimelineEventCommand}" />
                <ListView ItemsSource="{x:Bind ViewModel.CaseFile.Timeline, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TimelineEvent">
                            <Grid Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind EventDateDisplay}" Opacity="0.75" />
                                    <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" Opacity="0.9" />
                                </StackPanel>
                                <Button x:Uid="CaseBuilderPage_Remove_2" Grid.Column="1" Click="RemoveEventButton_Click" VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Uid="CaseBuilderPage_ClaimsIssues" Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Uid="CaseBuilderPage_EGFDCPAViolationFalse" Text="{x:Bind ViewModel.NewClaim, Mode=TwoWay}" MinWidth="280" />
                    <Button x:Uid="CaseBuilderPage_AddClaim" Command="{x:Bind ViewModel.AddClaimCommand}" />
                </StackPanel>
                <ListView ItemsSource="{x:Bind ViewModel.CaseFile.Claims, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button x:Uid="CaseBuilderPage_Remove_3" Grid.Column="1" Click="RemoveClaimButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Uid="CaseBuilderPage_EvidenceChecklist" Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Uid="CaseBuilderPage_EGCopyOfThe" Text="{x:Bind ViewModel.NewEvidenceText, Mode=TwoWay}" MinWidth="280" />
                    <Button x:Uid="CaseBuilderPage_AddItem" Command="{x:Bind ViewModel.AddEvidenceCommand}" />
                </StackPanel>
                <ListView ItemsSource="{x:Bind ViewModel.CaseFile.EvidenceChecklist, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ChecklistItem">
                            <Grid Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button x:Uid="CaseBuilderPage_Remove_4" Grid.Column="2" Click="RemoveEvidenceButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Uid="CaseBuilderPage_DeadlinesAlsoSavedToThe" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox x:Uid="CaseBuilderPage_DeadlineTitle" Text="{x:Bind ViewModel.NewDeadlineTitle, Mode=TwoWay}" />
                <DatePicker x:Uid="CaseBuilderPage_DueDate" Date="{x:Bind ViewModel.NewDeadlineDate, Mode=TwoWay}" />
                <Button x:Uid="CaseBuilderPage_AddDeadline" Command="{x:Bind ViewModel.AddDeadlineCommand}" />

                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />

                <Button x:Uid="CaseBuilderPage_ClearCaseFile" Command="{x:Bind ViewModel.ClearCaseCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
