<Page
    x:Class="ClaimPilot.Views.EvidenceVaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClaimPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="980">
            <TextBlock x:Uid="EvidenceVaultPage_EvidenceVault" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.IntroText}" TextWrapping="Wrap" />

            <!-- Civil-rights incident template -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="EvidenceVaultPage_CivilRightsIncidentTemplate" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <CalendarDatePicker x:Uid="EvidenceVaultPage_IncidentDate" Date="{x:Bind ViewModel.IncidentDate, Mode=TwoWay}" />
                    <TextBox x:Uid="EvidenceVaultPage_Location" Text="{x:Bind ViewModel.IncidentLocation, Mode=TwoWay}" />
                    <TextBox x:Uid="EvidenceVaultPage_OfficersInvolvedNamesBadgeNu" Text="{x:Bind ViewModel.IncidentOfficers, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                    <TextBox x:Uid="EvidenceVaultPage_WitnessesNamesContactInfo" Text="{x:Bind ViewModel.IncidentWitnesses, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                    <TextBox x:Uid="EvidenceVaultPage_ComplaintReportNumbers" Text="{x:Bind ViewModel.IncidentComplaintNumbers, Mode=TwoWay}" />
                    <ListView ItemsSource="{x:Bind ViewModel.IncidentChecklist, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ChecklistItem">
                                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}">
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                </CheckBox>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:Uid="EvidenceVaultPage_AddIncidentToTimeline" Command="{x:Bind ViewModel.AddIncidentToTimelineCommand}" />
                </StackPanel>
            </Border>

            <!-- Evidence items -->
            <TextBlock x:Uid="EvidenceVaultPage_EvidenceItems" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <TextBox x:Uid="EvidenceVaultPage_Title" Text="{x:Bind ViewModel.NewEvidenceTitle, Mode=TwoWay}" />
                    <ComboBox x:Uid="EvidenceVaultPage_Category"
                        ItemsSource="{x:Bind ViewModel.EvidenceCategories, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.NewEvidenceCategory, Mode=TwoWay}"
                        MinWidth="200" />
                    <TextBox x:Uid="EvidenceVaultPage_Description" Text="{x:Bind ViewModel.NewEvidenceDescription, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                    <Button x:Uid="EvidenceVaultPage_AttachFileSave" Command="{x:Bind ViewModel.AddEvidenceCommand}" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <ListView ItemsSource="{x:Bind ViewModel.EvidenceItems, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:EvidenceItem">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,6"
                            MinWidth="600">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ItemDateDisplay}" Opacity="0.85" />
                                    <TextBlock Text="{x:Bind Category}" Opacity="0.7" FontStyle="Italic" />
                                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind FilePath}" TextWrapping="Wrap" FontSize="11" Opacity="0.7" />
                                </StackPanel>
                                <Button x:Uid="EvidenceVaultPage_Delete" Grid.Column="1" Click="DeleteEvidence_Click" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Timeline -->
            <TextBlock x:Uid="EvidenceVaultPage_TimelineSortedByDate" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <TextBox x:Uid="EvidenceVaultPage_EventTitle" Text="{x:Bind ViewModel.NewEventTitle, Mode=TwoWay}" />
                    <CalendarDatePicker x:Uid="EvidenceVaultPage_EventDate" Date="{x:Bind ViewModel.NewEventDate, Mode=TwoWay}" />
                    <TextBox x:Uid="EvidenceVaultPage_Category_2" Text="{x:Bind ViewModel.NewEventCategory, Mode=TwoWay}" />
                    <TextBox x:Uid="EvidenceVaultPage_Details" Text="{x:Bind ViewModel.NewEventDetails, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="EvidenceVaultPage_AddTimelineEvent" Command="{x:Bind ViewModel.AddTimelineEventCommand}" />
                        <Button x:Uid="EvidenceVaultPage_SummarizeMyTimelineAI" Command="{x:Bind ViewModel.SummarizeTimelineCommand}" IsEnabled="{x:Bind ViewModel.IsAiAvailable, Mode=OneWay}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="{x:Bind ViewModel.AiButtonTooltip, Mode=OneWay}" />
                            </ToolTipService.ToolTip>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ListView ItemsSource="{x:Bind ViewModel.TimelineEvents, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TimelineEvent">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,6"
                            MinWidth="600">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind EventDateDisplay}" Opacity="0.85" />
                                    <TextBlock Text="{x:Bind Category}" Opacity="0.7" FontStyle="Italic" />
                                    <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Uid="EvidenceVaultPage_Delete_2" Grid.Column="1" Click="DeleteTimelineEvent_Click" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Visibility="{x:Bind ViewModel.SummaryVisibility, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="EvidenceVaultPage_TimelineSummaryOnDeviceAI" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.TimelineSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="EvidenceVaultPage_AIGeneratedSummaryGeneralInf"
                        TextWrapping="Wrap"
                        FontStyle="Italic"
                        Opacity="0.85" />
                </StackPanel>
            </Border>

            <Button x:Uid="EvidenceVaultPage_ExportEvidencePacketPDF" Command="{x:Bind ViewModel.ExportPacketCommand}" Style="{StaticResource AccentButtonStyle}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" FontStyle="Italic" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <TextBlock Text="{x:Bind ViewModel.DisclaimerText}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
