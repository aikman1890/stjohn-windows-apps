<Page
    x:Class="ClaimPilot.Views.EvidenceVaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClaimPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="980">
            <TextBlock Text="Evidence Vault" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.IntroText}" TextWrapping="Wrap" />

            <!-- Civil-rights incident template -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Civil-rights incident template" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <CalendarDatePicker Header="Incident date" Date="{x:Bind ViewModel.IncidentDate, Mode=TwoWay}" />
                    <TextBox Header="Location" Text="{x:Bind ViewModel.IncidentLocation, Mode=TwoWay}" />
                    <TextBox Header="Officers involved (names / badge numbers)" Text="{x:Bind ViewModel.IncidentOfficers, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                    <TextBox Header="Witnesses (names / contact info)" Text="{x:Bind ViewModel.IncidentWitnesses, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                    <TextBox Header="Complaint / report numbers" Text="{x:Bind ViewModel.IncidentComplaintNumbers, Mode=TwoWay}" />
                    <ListView ItemsSource="{x:Bind ViewModel.IncidentChecklist, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ChecklistItem">
                                <CheckBox Content="{x:Bind Text}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}">
                                    <CheckBox.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </CheckBox.ContentTemplate>
                                </CheckBox>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="Add incident to timeline" Command="{x:Bind ViewModel.AddIncidentToTimelineCommand}" />
                </StackPanel>
            </Border>

            <!-- Evidence items -->
            <TextBlock Text="Evidence items" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <TextBox Header="Title" Text="{x:Bind ViewModel.NewEvidenceTitle, Mode=TwoWay}" />
                    <ComboBox
                        Header="Category"
                        ItemsSource="{x:Bind ViewModel.EvidenceCategories, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.NewEvidenceCategory, Mode=TwoWay}"
                        MinWidth="200" />
                    <TextBox Header="Description" Text="{x:Bind ViewModel.NewEvidenceDescription, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                    <Button Content="Attach file &amp; save" Command="{x:Bind ViewModel.AddEvidenceCommand}" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <ListView ItemsSource="{x:Bind ViewModel.EvidenceItems, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:EvidenceItem">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,6"
                            MinWidth="600">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ItemDateDisplay}" Opacity="0.85" />
                                    <TextBlock Text="{x:Bind Category}" Opacity="0.7" FontStyle="Italic" />
                                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind FilePath}" TextWrapping="Wrap" FontSize="11" Opacity="0.7" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Delete" Click="DeleteEvidence_Click" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Timeline -->
            <TextBlock Text="Timeline (sorted by date)" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <TextBox Header="Event title" Text="{x:Bind ViewModel.NewEventTitle, Mode=TwoWay}" />
                    <CalendarDatePicker Header="Event date" Date="{x:Bind ViewModel.NewEventDate, Mode=TwoWay}" />
                    <TextBox Header="Category" Text="{x:Bind ViewModel.NewEventCategory, Mode=TwoWay}" />
                    <TextBox Header="Details" Text="{x:Bind ViewModel.NewEventDetails, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add timeline event" Command="{x:Bind ViewModel.AddTimelineEventCommand}" />
                        <Button Content="Summarize my timeline (AI)" Command="{x:Bind ViewModel.SummarizeTimelineCommand}" IsEnabled="{x:Bind ViewModel.IsAiAvailable, Mode=OneWay}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="{x:Bind ViewModel.AiButtonTooltip, Mode=OneWay}" />
                            </ToolTipService.ToolTip>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ListView ItemsSource="{x:Bind ViewModel.TimelineEvents, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TimelineEvent">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,6"
                            MinWidth="600">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind EventDateDisplay}" Opacity="0.85" />
                                    <TextBlock Text="{x:Bind Category}" Opacity="0.7" FontStyle="Italic" />
                                    <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Delete" Click="DeleteTimelineEvent_Click" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Visibility="{x:Bind ViewModel.SummaryVisibility, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Timeline summary (on-device AI)" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.TimelineSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock
                        Text="AI-generated summary. General information only — not legal advice."
                        TextWrapping="Wrap"
                        FontStyle="Italic"
                        Opacity="0.85" />
                </StackPanel>
            </Border>

            <Button Content="Export evidence packet (PDF)" Command="{x:Bind ViewModel.ExportPacketCommand}" Style="{StaticResource AccentButtonStyle}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" FontStyle="Italic" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <TextBlock Text="{x:Bind ViewModel.DisclaimerText}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
