<Page
    x:Class="ClaimPilot.Views.BankruptcyPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClaimPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12" MaxWidth="980">
            <TextBlock Text="Bankruptcy — Chapters 7 &amp; 13" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.IntroText}" TextWrapping="Wrap" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <TextBlock Text="{x:Bind ViewModel.DisclaimerText}" TextWrapping="Wrap" />
            </Border>

            <!-- Bankruptcy Plus unlock gate -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Visibility="{x:Bind ViewModel.LockedVisibility, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Bankruptcy Plus" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.UnlockBlurb}" TextWrapping="Wrap" />
                    <TextBlock>
                        <Run Text="One-time purchase: " />
                        <Run Text="{x:Bind ViewModel.UnlockPriceDisplay}" FontWeight="SemiBold" />
                        <Run Text=" (base ClaimPilot app is separate)." />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Unlock Bankruptcy Plus" Command="{x:Bind ViewModel.PurchaseCommand}" />
                        <Button Content="I already own it — check again" Command="{x:Bind ViewModel.CheckOwnershipCommand}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingOwnership, Mode=OneWay}" Width="24" Height="24" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" FontStyle="Italic" />
                </StackPanel>
            </Border>

            <!-- Unlocked content -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.UnlockedVisibility, Mode=OneWay}">

                <TextBlock Text="{x:Bind ViewModel.Chapter7Guide.Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Chapter7Guide.Intro}" TextWrapping="Wrap" />
                <ListView ItemsSource="{x:Bind ViewModel.Chapter7Guide.Sections, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:BankruptcySection">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,6">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Body}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="{x:Bind ViewModel.Chapter13Guide.Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Chapter13Guide.Intro}" TextWrapping="Wrap" />
                <ListView ItemsSource="{x:Bind ViewModel.Chapter13Guide.Sections, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:BankruptcySection">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,6">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Body}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Chapter 7 document checklist" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="An organizational checklist — not legal advice. Your trustee or attorney may ask for more."
                    TextWrapping="Wrap"
                    FontStyle="Italic"
                    Opacity="0.85" />
                <ListView ItemsSource="{x:Bind ViewModel.Chapter7Checklist, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ChecklistItem">
                            <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" Content="{x:Bind Text}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Chapter 13 document checklist" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="An organizational checklist — not legal advice. Your trustee or attorney may ask for more."
                    TextWrapping="Wrap"
                    FontStyle="Italic"
                    Opacity="0.85" />
                <ListView ItemsSource="{x:Bind ViewModel.Chapter13Checklist, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ChecklistItem">
                            <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" Content="{x:Bind Text}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Required courses tracker" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.CourseHonestyText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <HyperlinkButton Content="Official list: approved credit counseling agencies (U.S. Trustee)" Click="CreditCounselingLink_Click" />
                        <HyperlinkButton Content="Official list: approved debtor education providers (U.S. Trustee)" Click="DebtorEducationLink_Click" />
                    </StackPanel>
                </Border>

                <TextBlock Text="180-day credit counseling calculator" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Planned filing date:" VerticalAlignment="Center" />
                    <DatePicker Date="{x:Bind ViewModel.PlannedFilingDate, Mode=TwoWay}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.CounselingWindowText, Mode=OneWay}" TextWrapping="Wrap" />

                <TextBlock Text="Chapter 7 courses" FontWeight="SemiBold" />
                <ListView ItemsSource="{x:Bind ViewModel.Chapter7Courses, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CourseRecord">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,6">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind StatusDisplay, Mode=OneWay}" />
                                    <ComboBox
                                        Header="Status"
                                        SelectedItem="{x:Bind StatusLabel, Mode=TwoWay}"
                                        SelectionChanged="CourseStatus_Changed">
                                        <x:String>Not started</x:String>
                                        <x:String>Scheduled</x:String>
                                        <x:String>Completed</x:String>
                                    </ComboBox>
                                    <DatePicker Header="Scheduled date" Date="{x:Bind ScheduledDateOffset, Mode=TwoWay}" DateChanged="CourseDate_Changed" />
                                    <DatePicker Header="Completed date" Date="{x:Bind CompletedDateOffset, Mode=TwoWay}" DateChanged="CourseDate_Changed" />
                                    <TextBox
                                        Header="Provider name (must be U.S. Trustee-approved)"
                                        Text="{x:Bind ProviderName, Mode=TwoWay}"
                                        LostFocus="CourseText_LostFocus" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Attach certificate (PDF/image)" Click="AttachCertificate_Click" />
                                        <Button
                                            Content="Open certificate"
                                            Click="OpenCertificate_Click"
                                            Visibility="{x:Bind CertificateVisibility, Mode=OneWay}" />
                                        <Button Content="Reset" Click="ResetCourse_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Chapter 13 courses" FontWeight="SemiBold" />
                <ListView ItemsSource="{x:Bind ViewModel.Chapter13Courses, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CourseRecord">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,6">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind StatusDisplay, Mode=OneWay}" />
                                    <ComboBox
                                        Header="Status"
                                        SelectedItem="{x:Bind StatusLabel, Mode=TwoWay}"
                                        SelectionChanged="CourseStatus_Changed">
                                        <x:String>Not started</x:String>
                                        <x:String>Scheduled</x:String>
                                        <x:String>Completed</x:String>
                                    </ComboBox>
                                    <DatePicker Header="Scheduled date" Date="{x:Bind ScheduledDateOffset, Mode=TwoWay}" DateChanged="CourseDate_Changed" />
                                    <DatePicker Header="Completed date" Date="{x:Bind CompletedDateOffset, Mode=TwoWay}" DateChanged="CourseDate_Changed" />
                                    <TextBox
                                        Header="Provider name (must be U.S. Trustee-approved)"
                                        Text="{x:Bind ProviderName, Mode=TwoWay}"
                                        LostFocus="CourseText_LostFocus" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Attach certificate (PDF/image)" Click="AttachCertificate_Click" />
                                        <Button
                                            Content="Open certificate"
                                            Click="OpenCertificate_Click"
                                            Visibility="{x:Bind CertificateVisibility, Mode=OneWay}" />
                                        <Button Content="Reset" Click="ResetCourse_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Add bankruptcy deadlines to the tracker" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="Pick your filing date, then add the standard deadlines for a chapter. They land in the Deadlines section with reminders. Presets are estimates — verify every date against your actual case."
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Filing date:" VerticalAlignment="Center" />
                    <DatePicker Date="{x:Bind ViewModel.DeadlineSeedFilingDate, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Add Chapter 7 deadlines" Command="{x:Bind ViewModel.AddChapterDeadlinesCommand}" CommandParameter="7" />
                    <Button Content="Add Chapter 13 deadlines" Command="{x:Bind ViewModel.AddChapterDeadlinesCommand}" CommandParameter="13" />
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" FontStyle="Italic" />
            </StackPanel>

            <TextBlock Text="Read this first — honest notes" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.HonestNotes, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:HonestNote">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,6">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Body}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
