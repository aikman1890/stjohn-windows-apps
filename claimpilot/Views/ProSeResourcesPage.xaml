<Page
    x:Class="ClaimPilot.Views.ProSeResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12" MaxWidth="900">
            <TextBlock Text="Pro Se Resources" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="{x:Bind ViewModel.IfpTitle}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.IfpBody}" TextWrapping="Wrap" />

            <TextBlock Text="Find your court's website" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ComboBox
                ItemsSource="{x:Bind ViewModel.Districts, Mode=OneWay}"
                DisplayMemberPath="DistrictName"
                SelectedItem="{x:Bind ViewModel.SelectedDistrict, Mode=TwoWay}"
                PlaceholderText="Choose a federal district…"
                MinWidth="320" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <HyperlinkButton
                    NavigateUri="{x:Bind ViewModel.SelectedCourtUrl, Mode=OneWay}"
                    Content="Open the selected court's official website" />
                <HyperlinkButton
                    NavigateUri="{x:Bind ViewModel.CourtLocatorUrl}"
                    Content="uscourts.gov court locator" />
            </StackPanel>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.FeeNote}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.LocalRulesNote}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <TextBlock Text="{x:Bind ViewModel.DisclaimerText}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
