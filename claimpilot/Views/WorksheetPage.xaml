<Page
    x:Class="ClaimPilot.Views.WorksheetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClaimPilot.Models">

    <TabView IsAddTabButtonVisible="False" Padding="12">
        <TabViewItem Header="Small Claims Worksheet" IsClosable="False">
            <ScrollViewer>
                <StackPanel Padding="12" Spacing="12" MaxWidth="900">
                    <TextBlock Text="Small Claims Worksheet" Style="{StaticResource TitleTextBlockStyle}" />

                    <TextBox Header="Plaintiff name (you)" Text="{x:Bind ViewModel.PlaintiffName, Mode=TwoWay}" />
                    <TextBox Header="Plaintiff address" Text="{x:Bind ViewModel.PlaintiffAddress, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                    <TextBox Header="Defendant name" Text="{x:Bind ViewModel.DefendantName, Mode=TwoWay}" />
                    <TextBox Header="Defendant address" Text="{x:Bind ViewModel.DefendantAddress, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                    <TextBox Header="Amount sought" Text="{x:Bind ViewModel.AmountSought, Mode=TwoWay}" PlaceholderText="e.g. 2,500.00" />

                    <TextBlock Text="Facts timeline" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ListView ItemsSource="{x:Bind ViewModel.FactsRows, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FactRow">
                                <Grid ColumnSpacing="8" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="Date" Text="{x:Bind Date, Mode=TwoWay}" PlaceholderText="2026-01-15" />
                                    <TextBox Grid.Column="1" Header="What happened" Text="{x:Bind Description, Mode=TwoWay}" TextWrapping="Wrap" />
                                    <Button Grid.Column="2" Content="Remove" Click="RemoveFactRow_Click" VerticalAlignment="Bottom" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="Add timeline row" Command="{x:Bind ViewModel.AddFactRowCommand}" />

                    <TextBlock Text="{x:Bind ViewModel.FilingFeeNote}" TextWrapping="Wrap" FontStyle="Italic" />

                    <TextBlock Text="What a petition generally includes" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ListView ItemsSource="{x:Bind ViewModel.PetitionChecklist, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ChecklistItem">
                                <CheckBox Content="{x:Bind Text}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}">
                                    <CheckBox.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </CheckBox.ContentTemplate>
                                </CheckBox>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Content="Export worksheet PDF" Command="{x:Bind ViewModel.ExportWorksheetPdfCommand}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" FontStyle="Italic" />
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <TabViewItem Header="Federal Complaint Checklist" IsClosable="False">
            <ScrollViewer>
                <StackPanel Padding="12" Spacing="12" MaxWidth="900">
                    <TextBlock Text="Federal Complaint — Educational Checklist" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.FederalChecklistIntro}" TextWrapping="Wrap" />

                    <ListView ItemsSource="{x:Bind ViewModel.FederalChecklist, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ChecklistItem">
                                <CheckBox Content="{x:Bind Text}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}">
                                    <CheckBox.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </CheckBox.ContentTemplate>
                                </CheckBox>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <TextBlock Text="{x:Bind ViewModel.IfpNote}" TextWrapping="Wrap" />
                    </Border>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <TextBlock Text="{x:Bind ViewModel.DisclaimerText}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>
    </TabView>
</Page>
