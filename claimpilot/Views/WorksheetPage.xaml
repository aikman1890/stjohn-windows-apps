<Page
    x:Class="ClaimPilot.Views.WorksheetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClaimPilot.Models">

    <TabView IsAddTabButtonVisible="False" Padding="12">
        <TabViewItem x:Uid="WorksheetPage_SmallClaimsWorksheet" IsClosable="False">
            <ScrollViewer>
                <StackPanel Padding="12" Spacing="12" MaxWidth="900">
                    <TextBlock x:Uid="WorksheetPage_SmallClaimsWorksheet_2" Style="{StaticResource TitleTextBlockStyle}" />

                    <TextBox x:Uid="WorksheetPage_PlaintiffNameYou" Text="{x:Bind ViewModel.PlaintiffName, Mode=TwoWay}" />
                    <TextBox x:Uid="WorksheetPage_PlaintiffAddress" Text="{x:Bind ViewModel.PlaintiffAddress, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                    <TextBox x:Uid="WorksheetPage_DefendantName" Text="{x:Bind ViewModel.DefendantName, Mode=TwoWay}" />
                    <TextBox x:Uid="WorksheetPage_DefendantAddress" Text="{x:Bind ViewModel.DefendantAddress, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                    <TextBox x:Uid="WorksheetPage_AmountSought" Text="{x:Bind ViewModel.AmountSought, Mode=TwoWay}" />

                    <TextBlock x:Uid="WorksheetPage_FactsTimeline" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ListView ItemsSource="{x:Bind ViewModel.FactsRows, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FactRow">
                                <Grid ColumnSpacing="8" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Uid="WorksheetPage_Date" Grid.Column="0" Text="{x:Bind Date, Mode=TwoWay}" />
                                    <TextBox x:Uid="WorksheetPage_WhatHappened" Grid.Column="1" Text="{x:Bind Description, Mode=TwoWay}" TextWrapping="Wrap" />
                                    <Button x:Uid="WorksheetPage_Remove" Grid.Column="2" Click="RemoveFactRow_Click" VerticalAlignment="Bottom" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:Uid="WorksheetPage_AddTimelineRow" Command="{x:Bind ViewModel.AddFactRowCommand}" />

                    <TextBlock Text="{x:Bind ViewModel.FilingFeeNote}" TextWrapping="Wrap" FontStyle="Italic" />

                    <TextBlock x:Uid="WorksheetPage_WhatAPetitionGenerallyInclud" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ListView ItemsSource="{x:Bind ViewModel.PetitionChecklist, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ChecklistItem">
                                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}">
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                </CheckBox>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button x:Uid="WorksheetPage_ExportWorksheetPDF" Command="{x:Bind ViewModel.ExportWorksheetPdfCommand}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" FontStyle="Italic" />
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <TabViewItem x:Uid="WorksheetPage_FederalComplaintChecklist" IsClosable="False">
            <ScrollViewer>
                <StackPanel Padding="12" Spacing="12" MaxWidth="900">
                    <TextBlock x:Uid="WorksheetPage_FederalComplaintEducationalC" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.FederalChecklistIntro}" TextWrapping="Wrap" />

                    <ListView ItemsSource="{x:Bind ViewModel.FederalChecklist, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ChecklistItem">
                                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}">
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                </CheckBox>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <TextBlock Text="{x:Bind ViewModel.IfpNote}" TextWrapping="Wrap" />
                    </Border>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <TextBlock Text="{x:Bind ViewModel.DisclaimerText}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>
    </TabView>
</Page>
