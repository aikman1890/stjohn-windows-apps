<Page
    x:Class="ClaimPilot.Views.ViolationSpotterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClaimPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12" MaxWidth="900">
            <TextBlock Text="Violation Spotter" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.IntroText}" TextWrapping="Wrap" />

            <CheckBox Content="Calls before 8:00 a.m. or after 9:00 p.m. my time" IsChecked="{x:Bind ViewModel.CallsBefore8amOrAfter9pm, Mode=TwoWay}" />
            <CheckBox Content="Threats of arrest, violence, or harm" IsChecked="{x:Bind ViewModel.ThreatsOfArrestViolenceHarm, Mode=TwoWay}" />
            <CheckBox Content="False or inflated amounts (wrong balance, debt is not mine)" IsChecked="{x:Bind ViewModel.FalseOrInflatedAmounts, Mode=TwoWay}" />
            <CheckBox Content="Continued collection after I disputed in writing" IsChecked="{x:Bind ViewModel.ContinuedCollectionAfterDispute, Mode=TwoWay}" />
            <CheckBox Content="Contacted my employer or family about the debt" IsChecked="{x:Bind ViewModel.ContactedEmployerFamilyAboutDebt, Mode=TwoWay}" />
            <CheckBox Content="Never sent the required written validation notice" IsChecked="{x:Bind ViewModel.NeverSentWrittenValidation, Mode=TwoWay}" />
            <CheckBox Content="Added fees I never agreed to" IsChecked="{x:Bind ViewModel.AddedUnauthorizedFees, Mode=TwoWay}" />

            <Button Content="Analyze" Command="{x:Bind ViewModel.AnalyzeCommand}" Style="{StaticResource AccentButtonStyle}" />

            <ListView
                ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ViolationCard">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,6">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="{x:Bind LawName}"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind Explanation}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind AppliesNote}"
                                    TextWrapping="Wrap"
                                    FontStyle="Italic"
                                    Opacity="0.85" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <TextBlock Text="{x:Bind ViewModel.DisclaimerText}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
