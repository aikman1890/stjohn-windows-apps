<Page
    x:Class="ClaimPilot.Views.ViolationSpotterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClaimPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12" MaxWidth="900">
            <TextBlock x:Uid="ViolationSpotterPage_ViolationSpotter" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.IntroText}" TextWrapping="Wrap" />

            <CheckBox x:Uid="ViolationSpotterPage_CallsBefore800A" IsChecked="{x:Bind ViewModel.CallsBefore8amOrAfter9pm, Mode=TwoWay}" />
            <CheckBox x:Uid="ViolationSpotterPage_ThreatsOfArrestViolenceOr" IsChecked="{x:Bind ViewModel.ThreatsOfArrestViolenceHarm, Mode=TwoWay}" />
            <CheckBox x:Uid="ViolationSpotterPage_FalseOrInflatedAmountsWrong" IsChecked="{x:Bind ViewModel.FalseOrInflatedAmounts, Mode=TwoWay}" />
            <CheckBox x:Uid="ViolationSpotterPage_ContinuedCollectionAfterIDis" IsChecked="{x:Bind ViewModel.ContinuedCollectionAfterDispute, Mode=TwoWay}" />
            <CheckBox x:Uid="ViolationSpotterPage_ContactedMyEmployerOrFamily" IsChecked="{x:Bind ViewModel.ContactedEmployerFamilyAboutDebt, Mode=TwoWay}" />
            <CheckBox x:Uid="ViolationSpotterPage_NeverSentTheRequiredWritten" IsChecked="{x:Bind ViewModel.NeverSentWrittenValidation, Mode=TwoWay}" />
            <CheckBox x:Uid="ViolationSpotterPage_AddedFeesINeverAgreed" IsChecked="{x:Bind ViewModel.AddedUnauthorizedFees, Mode=TwoWay}" />

            <Button x:Uid="ViolationSpotterPage_Analyze" Command="{x:Bind ViewModel.AnalyzeCommand}" Style="{StaticResource AccentButtonStyle}" />

            <ListView
                ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ViolationCard">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,6">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="{x:Bind LawName}"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind Explanation}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind AppliesNote}"
                                    TextWrapping="Wrap"
                                    FontStyle="Italic"
                                    Opacity="0.85" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <TextBlock Text="{x:Bind ViewModel.DisclaimerText}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
