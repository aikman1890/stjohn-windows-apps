<Page
    x:Class="ClaimPilot.Views.CourtFinderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClaimPilot.Models">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Court Finder" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.IntroText}" TextWrapping="Wrap" Margin="0,0,0,8" />

        <TextBox
            Grid.Row="2"
            x:Name="SearchBox"
            PlaceholderText="Search by state, territory, or district name…"
            TextChanged="SearchBox_TextChanged"
            Margin="0,0,0,8"
            MaxWidth="900"
            HorizontalAlignment="Left"
            MinWidth="320" />

        <StackPanel Grid.Row="3" Spacing="2" Margin="0,0,0,8">
            <TextBlock Text="{x:Bind ViewModel.DistrictCountText, Mode=OneWay}" FontStyle="Italic" />
            <TextBlock Text="{x:Bind ViewModel.CountNote}" FontStyle="Italic" Opacity="0.8" />
        </StackPanel>

        <ListView
            Grid.Row="4"
            ItemsSource="{x:Bind ViewModel.FilteredDistricts, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DistrictInfo">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,6"
                        MinWidth="600">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind DistrictName}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind StateOrTerritory}" Opacity="0.8" />
                            <TextBlock Text="Court locations:" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind DivisionCities}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Note}" TextWrapping="Wrap" FontStyle="Italic" />
                            <HyperlinkButton NavigateUri="{x:Bind WebsiteUrl}" Content="Official court website" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border
            Grid.Row="5"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,8,0,0">
            <TextBlock Text="{x:Bind ViewModel.DisclaimerText}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Page>
