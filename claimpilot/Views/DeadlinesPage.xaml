<Page
    x:Class="ClaimPilot.Views.DeadlinesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClaimPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12" MaxWidth="900">
            <TextBlock x:Uid="DeadlinesPage_Deadlines" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.IntroText}" TextWrapping="Wrap" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="DeadlinesPage_AddADeadline" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox x:Uid="DeadlinesPage_Title" Text="{x:Bind ViewModel.NewTitle, Mode=TwoWay}" />
                    <CalendarDatePicker x:Uid="DeadlinesPage_DueDate" Date="{x:Bind ViewModel.NewDueDate, Mode=TwoWay}" />
                    <ComboBox x:Uid="DeadlinesPage_Category"
                        ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.NewCategory, Mode=TwoWay}"
                        MinWidth="200" />
                    <TextBox x:Uid="DeadlinesPage_Notes" Text="{x:Bind ViewModel.NewNotes, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                    <Button x:Uid="DeadlinesPage_SaveDeadline" Command="{x:Bind ViewModel.AddDeadlineCommand}" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" FontStyle="Italic" />

            <TextBlock x:Uid="DeadlinesPage_YourDeadlinesSortedByDue" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.Deadlines, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DeadlineItem">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,6"
                            MinWidth="560">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Grid.Column="0"
                                    IsChecked="{x:Bind IsDone, Mode=TwoWay}"
                                    Click="DoneCheck_Click"
                                    VerticalAlignment="Top">
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Uid="DeadlinesPage_MarkDone" />
                                    </ToolTipService.ToolTip>
                                </CheckBox>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind DueDateDisplay, Mode=OneWay}" Opacity="0.85" />
                                    <TextBlock Text="{x:Bind Category, Mode=OneWay}" Opacity="0.7" FontStyle="Italic" />
                                    <TextBlock Text="{x:Bind Notes, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock x:Uid="DeadlinesPage_OVERDUE"
                                        Foreground="Red"
                                        FontWeight="Bold"
                                        Visibility="{x:Bind OverdueVisibility, Mode=OneWay}" />
                                </StackPanel>
                                <Button x:Uid="DeadlinesPage_Delete" Grid.Column="2" Click="DeleteDeadline_Click" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <TextBlock Text="{x:Bind ViewModel.DisclaimerText}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
