<Page
    x:Class="ClaimPilot.Views.LetterBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12" MaxWidth="900">
            <TextBlock x:Uid="LetterBuilderPage_LetterBuilder" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.IntroText}" TextWrapping="Wrap" />

            <TextBox x:Uid="LetterBuilderPage_YourName" Text="{x:Bind ViewModel.UserName, Mode=TwoWay}" />
            <TextBox x:Uid="LetterBuilderPage_YourAddress" Text="{x:Bind ViewModel.UserAddress, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
            <TextBox x:Uid="LetterBuilderPage_CollectorCreditorBureauName" Text="{x:Bind ViewModel.RecipientName, Mode=TwoWay}" />
            <TextBox x:Uid="LetterBuilderPage_CollectorCreditorBureauAddre" Text="{x:Bind ViewModel.RecipientAddress, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
            <TextBox x:Uid="LetterBuilderPage_AccountNumber" Text="{x:Bind ViewModel.AccountNumber, Mode=TwoWay}" />

            <ComboBox x:Uid="LetterBuilderPage_Template"
                ItemsSource="{x:Bind ViewModel.TemplateNames, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.SelectedTemplateIndex, Mode=TwoWay}"
                MinWidth="320" />

            <Button x:Uid="LetterBuilderPage_GenerateLetter" Command="{x:Bind ViewModel.GenerateLetterCommand}" Style="{StaticResource AccentButtonStyle}" />

            <TextBlock x:Uid="LetterBuilderPage_Preview" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox
                Text="{x:Bind ViewModel.GeneratedLetter, Mode=OneWay}"
                IsReadOnly="True"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                MinHeight="320"
                FontFamily="Consolas" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="LetterBuilderPage_SaveAsTXT" Command="{x:Bind ViewModel.SaveTxtCommand}" />
                <Button x:Uid="LetterBuilderPage_ExportPDF" Command="{x:Bind ViewModel.ExportPdfCommand}" />
                <Button x:Uid="LetterBuilderPage_Copy" Command="{x:Bind ViewModel.CopyLetterCommand}" />
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" FontStyle="Italic" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <TextBlock Text="{x:Bind ViewModel.DisclaimerText}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
