<Page
    x:Class="ClaimPilot.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClaimPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="ClaimPilot" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="{x:Bind ViewModel.Tagline}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextWrapping="Wrap" />

            <GridView
                ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}"
                SelectionMode="None">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:NavCard">
                        <Button
                            Click="CardButton_Click"
                            Tag="{x:Bind Tag}"
                            Width="300"
                            Height="176"
                            Margin="4">
                            <StackPanel Spacing="6" Padding="8">
                                <SymbolIcon Symbol="{x:Bind IconSymbol}" />
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <TextBlock
                    Text="{x:Bind ViewModel.DisclaimerText}"
                    TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
