<?xml version="1.0" encoding="UTF-8"?>
<!--
  ClaimPilot MSI installer — WiX Toolset v5, per-user (no admin / no UAC).
  Installs to %LOCALAPPDATA%\Programs\St. John Pictures\ClaimPilot.

  The <ComponentGroupRef Id="AppFiles" /> below is satisfied by Files.wxs,
  which the build workflow generates from publish\claimpilot\\** (one component
  per file, deterministic GUIDs) so EVERY published file ships in the MSI:
  exe, dlls, Assets, resources.pri (100 languages), Assets\Voice\vd.dat
  (wuse/DayPilot), integrity.manifest, License.txt.

  Build (on Windows):
    wix build claimpilot.wxs Files.wxs -arch x64 -ext WixToolset.UI.wixext -o ..\..\claimpilot-Setup.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="ClaimPilot"
           Language="1033"
           Version="1.0.0"
           Manufacturer="St. John Pictures"
           ProductCode="16FC83C8-1386-45F0-B7A6-995B9D249F96"
           UpgradeCode="1AB615A8-F1FF-44F7-A3DC-42B93096C63F"
           Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of ClaimPilot is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs entries -->
    <Property Id="ARPPRODUCTICON" Value="[INSTALLFOLDER]ClaimPilot.exe" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://aikman1890.github.io/stjohn-windows-apps/claimpilot.html" />

    <!-- Minimal wizard UI (welcome / progress / finish). Silent install: msiexec /i claimpilot-Setup.msi /quiet -->
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- Per-user install folder: %LOCALAPPDATA%\Programs\St. John Pictures\ClaimPilot -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="CompanyDir" Name="St. John Pictures">
          <Directory Id="INSTALLFOLDER" Name="ClaimPilot" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Start Menu shortcut (per-user, non-advertised) -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutsDir" Name="ClaimPilot">
        <Component Id="StartMenuShortcut" Guid="4E371D74-7FA0-4F98-A489-9D690B595041" Bitness="always64">
          <Shortcut Id="AppStartMenuShortcut"
                    Name="ClaimPilot"
                    Description="ClaimPilot — bankruptcy assistant"
                    Target="[INSTALLFOLDER]ClaimPilot.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppShortcutsDir" Directory="AppShortcutsDir" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\St. John Pictures\ClaimPilot"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="ClaimPilot" Level="1">
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
</Wix>
