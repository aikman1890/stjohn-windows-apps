<Page
    x:Class="DenialPilot.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="DenialPilot" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Every denial, deadline, call, and document - one campaign board, on this PC only." Opacity="0.75" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="32" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="OpenText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Open fights" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="DollarsText" FontSize="32" FontWeight="SemiBold" Text="$0" />
                    <TextBlock Text="Dollars in dispute" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="WonText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Resolved won / paid" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="LostText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Resolved lost" Opacity="0.7" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Deadline pressure, soonest first" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
            <ListView x:Name="PressureList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="DenialPilot organizes, reminds, and documents. It is general information and document tools only - not medical or legal advice, and it never promises an outcome."
                       Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
