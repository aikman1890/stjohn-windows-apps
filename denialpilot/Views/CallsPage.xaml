<Page
    x:Class="DenialPilot.Views.CallsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Insurer call log" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="CasePicker" Header="Case" HorizontalAlignment="Stretch" />
                <DatePicker x:Name="CallDatePicker" Header="Call date" />
                <TimePicker x:Name="CallTimePicker" Header="Call time" />
                <TextBox x:Name="RepBox" Header="Representative name" />
                <TextBox x:Name="RefBox" Header="Call reference number" />
                <TextBox x:Name="PromisedBox" Header="What was promised" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                <DatePicker x:Name="FollowUpPicker" Header="Follow-up date" />
                <CheckBox x:Name="FollowUpCheck" Content="Set a follow-up date" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="Always ask for the representative's name and a call reference number - this log is built to capture both."
                           TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubLine}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FollowUpText}" FontSize="12" Opacity="0.75" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
