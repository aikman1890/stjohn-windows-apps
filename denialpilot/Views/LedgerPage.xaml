<Page
    x:Class="DenialPilot.Views.LedgerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Proof ledger" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="The chronological record of everything sent, received, and promised - the artifact that wins escalations and DOI complaints." TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                <ComboBox x:Name="FilterPicker" Header="Show entries for" HorizontalAlignment="Stretch"
                          SelectionChanged="FilterPicker_SelectionChanged" />
                <ComboBox x:Name="KindCombo" Header="Entry kind" HorizontalAlignment="Stretch" />
                <TextBox x:Name="DetailBox" Header="Detail" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                <ComboBox x:Name="MethodCombo" Header="Method" HorizontalAlignment="Stretch" />
                <TextBox x:Name="TrackingBox" Header="Tracking / confirmation number" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add entry" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete selected" Click="DeleteButton_Click" />
                </StackPanel>
                <Button x:Name="ExportButton" Content="Export case packet (.html, printable)" Click="ExportButton_Click" HorizontalAlignment="Left" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubLine}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
