<Page
    x:Class="DenialPilot.Views.CasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:DenialPilot.Converters">

    <Page.Resources>
        <conv:DaysRemainingBrushConverter x:Key="DaysBrush" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Denial case file" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="PatientBox" Header="Patient name" />
                <TextBox x:Name="InsurerBox" Header="Insurer" />
                <TextBox x:Name="PlanBox" Header="Plan" />
                <TextBox x:Name="ClaimBox" Header="Claim number" />
                <DatePicker x:Name="ServiceDatePicker" Header="Date of service" />
                <TextBox x:Name="ProviderBox" Header="Provider" />
                <TextBox x:Name="AmountBox" Header="Amount denied" />
                <DatePicker x:Name="DenialDatePicker" Header="Denial date" />
                <ComboBox x:Name="ReasonCombo" Header="Denial reason category" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch" />

                <TextBlock Text="Deadline engine" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ComboBox x:Name="ClockCombo" Header="Appeal filing clock (from your denial letter)" HorizontalAlignment="Stretch" />
                <TextBox x:Name="CustomDaysBox" Header="Custom window (days, when Custom is chosen)" Text="180" />
                <DatePicker x:Name="AppealSentPicker" Header="Appeal sent date" />
                <CheckBox x:Name="AppealSentCheck" Content="Appeal has been sent (starts the response clock)" />
                <CheckBox x:Name="UrgentCheck" Content="Urgent case - 72-hour response clock (otherwise 30 days)" />

                <TextBlock Text="Documents (local paths)" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox x:Name="DocumentsBox" Header="Attached document paths" AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
                <Button x:Name="AddDocButton" Content="Attach a document (stores its path)" Click="AddDocButton_Click" HorizontalAlignment="Left" />

                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="Deadline colors: green while comfortable, orange within 5 days, red once overdue. Every computed date shows its basis - no silent math."
                           TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubLine}" Opacity="0.75" FontSize="12" />
                        <TextBlock Text="{Binding AppealText}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{Binding AppealDaysRemaining, Converter={StaticResource DaysBrush}}" />
                        <TextBlock Text="{Binding ResponseText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
