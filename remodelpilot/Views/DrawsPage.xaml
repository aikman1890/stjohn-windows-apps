<Page
    x:Class="RemodelPilot.Views.DrawsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Draw schedule" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="JobPicker" Header="Job" HorizontalAlignment="Stretch" SelectionChanged="JobPicker_SelectionChanged" />
                <TextBlock x:Name="JobTotalsText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBox x:Name="LabelBox" Header="Draw label (e.g. Deposit, Framing complete)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="AmountBox" Header="Amount ($)" Width="130" />
                    <TextBox x:Name="PercentBox" Header="or % of contract" Width="130" />
                </StackPanel>
                <TextBox x:Name="TriggerBox" Header="Trigger note" />
                <DatePicker x:Name="DuePicker" Header="Due / trigger date" />
                <CheckBox x:Name="DueCheck" Content="This draw has a due date" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddButton" Content="Add draw" Click="AddButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete selected" Click="DeleteButton_Click" />
                </StackPanel>
                <TextBlock Text="Selected draw" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="InvoiceButton" Content="Mark invoiced today" Click="InvoiceButton_Click" />
                    <Button x:Name="PaidButton" Content="Mark PAID today" Click="PaidButton_Click" />
                </StackPanel>
                <Button x:Name="StatementButton" Content="Export final statement (.html)" Click="StatementButton_Click" HorizontalAlignment="Left" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="2" Spacing="8">
            <TextBlock Text="Overdue to invoice (all jobs)" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="OverdueList" SelectionMode="None" MaxHeight="160">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Draws for the selected job" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="ItemsList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
