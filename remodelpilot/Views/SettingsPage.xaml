<Page
    x:Class="RemodelPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBox x:Name="NameBox" Header="Business name (prints on change orders and statements)" />
            <TextBox x:Name="AddressBox" Header="Business address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
            <TextBox x:Name="PhoneBox" Header="Phone" />
            <TextBox x:Name="MarkupBox" Header="Default markup % for new estimate lines" />
            <TextBox x:Name="CategoriesBox" Header="Cost categories (one per line - yours, editable)" AcceptsReturn="True" TextWrapping="Wrap" Height="180" />
            <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
