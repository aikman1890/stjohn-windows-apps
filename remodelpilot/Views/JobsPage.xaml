<Page
    x:Class="RemodelPilot.Views.JobsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Job file" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="ClientBox" Header="Client name" />
                <TextBox x:Name="AddressBox" Header="Job address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <TextBox x:Name="PhoneBox" Header="Phone" />
                <TextBox x:Name="EmailBox" Header="Email" />
                <ComboBox x:Name="TypeCombo" Header="Contract type" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch" />
                <TextBlock x:Name="MoneyText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <DatePicker x:Name="StartPicker" Header="Start date" />
                <DatePicker x:Name="CompletePicker" Header="Completion date" />
                <CheckBox x:Name="CompleteCheck" Content="Job is complete (set date)" />
                <DatePicker x:Name="WarrantyPicker" Header="Warranty end date" />
                <CheckBox x:Name="WarrantyCheck" Content="Warranty period set (set end date)" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="The contract price comes from the winning estimate version (Estimates page) plus approved change orders - it is never typed here, so it can never disagree with the record." TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
