<Page
    x:Class="RemodelPilot.Views.EstimatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Estimate builder" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="JobPicker" Header="Job" HorizontalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="NewVersionButton" Content="New version" Click="NewVersionButton_Click" />
                    <ComboBox x:Name="StatusCombo" Header="Version status" Width="150" />
                </StackPanel>
                <TextBlock x:Name="TotalsText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Button x:Name="MarkWonButton" Content="Mark this version WON (becomes contract + budget)" Click="MarkWonButton_Click" HorizontalAlignment="Left" />
                <TextBox x:Name="VersionNotesBox" Header="Version notes" AcceptsReturn="True" TextWrapping="Wrap" Height="40" />
                <Button x:Name="SaveVersionButton" Content="Save version" Click="SaveVersionButton_Click" HorizontalAlignment="Left" />

                <TextBlock Text="Add a line" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ComboBox x:Name="CategoryCombo" Header="Category" HorizontalAlignment="Stretch" />
                <TextBox x:Name="DescBox" Header="Description" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="CostBox" Header="Your cost ($)" Text="0" Width="120" />
                    <TextBox x:Name="MarkupBox" Header="Markup %" Text="20" Width="100" />
                    <Button x:Name="AddLineButton" Content="Add line" Click="AddLineButton_Click" VerticalAlignment="Bottom" />
                    <Button x:Name="RemoveLineButton" Content="Remove" Click="RemoveLineButton_Click" VerticalAlignment="Bottom" />
                </StackPanel>
                <ListView x:Name="LinesList" MaxHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="Versions are preserved - renegotiate by making a new version, never by editing the one the client saw. Lines carry YOUR costs; RemodelPilot has no cost book and invents no prices." TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
