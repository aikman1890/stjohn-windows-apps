<Page
    x:Class="RemodelPilot.Views.SubsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Sub &amp; supplier ledger" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="JobPicker" Header="Job" HorizontalAlignment="Stretch" />
                <TextBox x:Name="WhoBox" Header="Sub / supplier name" />
                <TextBox x:Name="ScopeBox" Header="Scope of work" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="AgreedBox" Header="Agreed price ($)" Width="140" />
                    <TextBox x:Name="PaidBox" Header="Paid to date ($)" Width="140" />
                </StackPanel>
                <CheckBox x:Name="WaiverCheck" Content="Lien waiver received" />
                <DatePicker x:Name="WaiverPicker" Header="Waiver date" />
                <CheckBox x:Name="CertCheck" Content="Certificate / document received" />
                <DatePicker x:Name="CertPicker" Header="Certificate date" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="40" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="Waiver and certificate flags are your record of paperwork received - the trail the client or title company asks for at closing." TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
