<Page
    x:Class="RemodelPilot.Views.ChangeOrdersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Change order" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Priced, dated, and decided in writing - before the work, not after the argument. Approved COs raise the contract price automatically; declined COs stay on file." TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                <ComboBox x:Name="JobPicker" Header="Job" HorizontalAlignment="Stretch" />
                <TextBox x:Name="DescBox" Header="Description of the change" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                <ComboBox x:Name="CategoryCombo" Header="Category affected" HorizontalAlignment="Stretch" />
                <TextBox x:Name="PriceBox" Header="Price ($) - negative for a credit" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="MethodCombo" Header="Approval method" HorizontalAlignment="Stretch" />
                <TextBox x:Name="ApproverBox" Header="Approved by (name)" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="40" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ApproveButton" Content="Mark APPROVED today" Click="ApproveButton_Click" />
                    <Button x:Name="DeclineButton" Content="Mark DECLINED today" Click="DeclineButton_Click" />
                    <Button x:Name="ExportButton" Content="Print CO (.html)" Click="ExportButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubLine}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
