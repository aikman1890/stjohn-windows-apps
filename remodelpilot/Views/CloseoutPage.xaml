<Page
    x:Class="RemodelPilot.Views.CloseoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Punch list &amp; warranty" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="JobPicker" Header="Job" HorizontalAlignment="Stretch" SelectionChanged="JobPicker_SelectionChanged" />
                <TextBlock x:Name="WarrantyText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Punch items" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBox x:Name="PunchBox" Header="New punch item" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddPunchButton" Content="Add item" Click="AddPunchButton_Click" />
                    <Button x:Name="DonePunchButton" Content="Mark selected done" Click="DonePunchButton_Click" />
                    <Button x:Name="DeletePunchButton" Content="Delete" Click="DeletePunchButton_Click" />
                </StackPanel>
                <TextBlock Text="Warranty callback" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox x:Name="IssueBox" Header="Issue reported" />
                <TextBox x:Name="ResolutionBox" Header="Resolution" />
                <TextBox x:Name="CallbackCostBox" Header="Callback cost ($)" Text="0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddCallbackButton" Content="Log callback" Click="AddCallbackButton_Click" />
                    <Button x:Name="DeleteCallbackButton" Content="Delete selected" Click="DeleteCallbackButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="2" Spacing="8">
            <TextBlock Text="Punch list for the selected job" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="PunchList" MaxHeight="260">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Callback log (all jobs)" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="CallbackList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
