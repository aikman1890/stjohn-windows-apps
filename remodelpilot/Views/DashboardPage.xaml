<Page
    x:Class="RemodelPilot.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="RemodelPilot" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="BizText" Opacity="0.8" TextWrapping="Wrap" />
            <TextBlock Text="Active jobs - live margin" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListView x:Name="JobsList" SelectionMode="None" MaxHeight="280">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Change orders awaiting approval" FontWeight="SemiBold" Opacity="0.75" />
                        <TextBlock x:Name="CoText" FontSize="16" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Draws outstanding" FontWeight="SemiBold" Opacity="0.75" />
                        <TextBlock x:Name="DrawText" FontSize="16" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="Warranties expiring in 60 days" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ListView x:Name="WarrantyList" SelectionMode="None" MaxHeight="160">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
