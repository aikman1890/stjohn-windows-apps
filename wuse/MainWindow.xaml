<Window
    x:Class="Wuse.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <NavigationView x:Name="NavView"
                    IsSettingsVisible="False"
                    IsBackButtonVisible="Collapsed"
                    Loaded="NavView_Loaded"
                    ItemInvoked="NavView_ItemInvoked">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Uid="MainWindow_ChatNavItem" x:Name="ChatNavItem" Tag="chat">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Comment" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="MainWindow_Conversations" Tag="conversations">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Clock" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="MainWindow_QuickActions" Tag="actions">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="List" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <!-- Windows Ink support: Ink Notes page (added 2026-10-10; own block to avoid merge conflicts with licensing work). -->
            <NavigationViewItem x:Uid="MainWindow_InkNotes" Tag="inknotes">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Edit" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <!-- Secure login vault (added 2026-10-10; own block to avoid merge conflicts). -->
            <NavigationViewItem x:Uid="MainWindow_Vault" x:Name="VaultNavItem" Tag="vault">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Permissions" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="MainWindow_Preferences" Tag="prefs">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="MainWindow_About" Tag="about">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Help" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
