<?xml version="1.0" encoding="UTF-8"?>
<!--
  wuse MSI installer — WiX Toolset v5, per-user (no admin / no UAC).
  Installs to %LOCALAPPDATA%\Programs\St. John Pictures\wuse.

  The <ComponentGroupRef Id="AppFiles" /> below is satisfied by Files.wxs,
  which the build workflow generates from publish\wuse\\** (one component
  per file, deterministic GUIDs) so EVERY published file ships in the MSI:
  exe, dlls, Assets, resources.pri (100 languages), Assets\Voice\vd.dat
  (wuse/DayPilot), integrity.manifest, License.txt.

  Build (on Windows):
    wix build wuse.wxs Files.wxs -arch x64 -ext WixToolset.UI.wixext -o ..\..\wuse-Setup.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="wuse"
           Language="1033"
           Version="1.0.0"
           Manufacturer="St. John Pictures"
           ProductCode="10CA6608-1411-43CE-8838-A5B52B08B05E"
           UpgradeCode="299C4C4A-0869-463C-9506-7F8AFEB10C3F"
           Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of wuse is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs entries -->
    <Property Id="ARPPRODUCTICON" Value="[INSTALLFOLDER]Wuse.exe" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://aikman1890.github.io/stjohn-windows-apps/wuse.html" />

    <!-- Minimal wizard UI (welcome / progress / finish). Silent install: msiexec /i wuse-Setup.msi /quiet -->
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- Per-user install folder: %LOCALAPPDATA%\Programs\St. John Pictures\wuse -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="CompanyDir" Name="St. John Pictures">
          <Directory Id="INSTALLFOLDER" Name="wuse" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Start Menu shortcut (per-user, non-advertised) -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutsDir" Name="wuse">
        <Component Id="StartMenuShortcut" Guid="D0C4F316-E464-4DAA-9737-A9ADA51E7C00" Bitness="always64">
          <Shortcut Id="AppStartMenuShortcut"
                    Name="wuse"
                    Description="wuse — voice AI assistant"
                    Target="[INSTALLFOLDER]Wuse.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppShortcutsDir" Directory="AppShortcutsDir" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\St. John Pictures\wuse"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="wuse" Level="1">
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
</Wix>
