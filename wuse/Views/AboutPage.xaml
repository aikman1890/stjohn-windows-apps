<Page
    x:Class="Wuse.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" Padding="24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Uid="AboutPage_AboutWuse" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" Opacity="0.7" />

            <TextBlock x:Uid="AboutPage_WuseIsAFriendlyAssistant" TextWrapping="Wrap" />
            <TextBlock x:Uid="AboutPage_Runs100OnDeviceNo"
                       TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />

            <TextBlock x:Uid="AboutPage_WhatWuseCanDo" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap">
                <Run x:Uid="AboutPage_ChatWithAnOnDevice" /><LineBreak />
                <Run x:Uid="AboutPage_OpenAppsSearchTheWeb" /><LineBreak />
                <Run x:Uid="AboutPage_KeepYourConversationsOnThis" />
            </TextBlock>

            <TextBlock x:Uid="AboutPage_OnDeviceAIStatus" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.AiStatus, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" />

            <TextBlock Text="Have an idea for a new feature? That's the way to get it built — the only legitimate path to new features." Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <HyperlinkButton Content="Request a feature" NavigateUri="https://github.com/aikman1890/stjohn-windows-apps/issues/new?template=feature_request.md&amp;title=%5Bwuse%5D%20" />
            <HyperlinkButton Content="or email us instead" NavigateUri="mailto:aikman1892@gmail.com?subject=Feature%20request%20-%20wuse" />

            <TextBlock x:Uid="AboutPage_MadeByStJohnPictures" Opacity="0.7" Margin="0,24,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
