<Page
    x:Class="Wuse.Views.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:Wuse.ViewModels">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Uid="VaultPage_Vault" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="VaultPage_YourLoginsAreStoredEncrypted"
                       TextWrapping="Wrap" Opacity="0.8" />

            <TextBox x:Uid="VaultPage_SearchLogins"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock x:Uid="VaultPage_AddALogin" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Uid="VaultPage_SiteOrAppName" Grid.Row="0" Grid.Column="0"
                         Text="{x:Bind ViewModel.NewSiteName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox x:Uid="VaultPage_Username" Grid.Row="0" Grid.Column="1"
                         Text="{x:Bind ViewModel.NewUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <PasswordBox x:Uid="VaultPage_Password" x:Name="NewPasswordBox"
                             Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                             PasswordRevealMode="Hidden" />
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal" Spacing="12">
                    <CheckBox x:Uid="VaultPage_ShowPassword" x:Name="ShowPasswordCheckBox"
                              Checked="ShowPasswordCheckBox_CheckedChanged"
                              Unchecked="ShowPasswordCheckBox_CheckedChanged" />
                    <Button x:Uid="VaultPage_SaveLogin" Click="SaveButton_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>

            <TextBlock x:Uid="VaultPage_SavedLogins" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="LoginList" ItemsSource="{x:Bind ViewModel.Logins, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:VaultLoginRow">
                        <Grid ColumnSpacing="12" Padding="0,8" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Username, Mode=OneWay}" Opacity="0.7" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <Button x:Uid="VaultPage_CopyUsername" Click="CopyUsername_Click" />
                                <Button x:Uid="VaultPage_CopyPassword" Click="CopyPassword_Click" />
                                <Button x:Uid="VaultPage_Delete" Click="Delete_Click" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       TextWrapping="Wrap" FontStyle="Italic" Opacity="0.8" />
        </StackPanel>
    </ScrollViewer>
</Page>
