<Page
    x:Class="Wuse.Views.LockoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="12" MaxWidth="640">
            <TextBlock x:Name="AppNameText" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="StatusText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Your work is safe — " FontWeight="SemiBold" />
                    <Run Text="if you close now without a license, your data will be backed up to your Documents folder and the app will remove itself. Reinstall anytime and enter your key to restore." />
                </TextBlock>
            </Border>

            <TextBlock Text="Enter your license key" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox x:Name="KeyBox" Header="License key" PlaceholderText="XXXXX-XXXXX-XXXXX-XXXXX" />
            <TextBox x:Name="EmailBox" Header="Purchase email" PlaceholderText="Email used at purchase" InputScope="EmailSmtpAddress" />
            <Button Content="Activate" Click="Activate_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

            <Button x:Name="BuyButton" Click="Buy_Click" HorizontalAlignment="Left" />
            <HyperlinkButton Content="Support page" Click="Support_Click" HorizontalAlignment="Left" />

            <TextBlock Text="Restore saved work" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <TextBlock x:Name="BackupSummaryText" TextWrapping="Wrap" Opacity="0.8" />
            <Button Content="Restore saved work" Click="Restore_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="RestoreResultText" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
