<Page
    x:Class="Wuse.Views.QuickActionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Quick Actions" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Things wuse can do on this PC without any AI — and without the internet, except web search."
                       TextWrapping="Wrap" Opacity="0.8" />
            <TextBlock Text="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                       TextWrapping="Wrap" FontStyle="Italic" Opacity="0.8" />

            <TextBlock Text="Open apps" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Button Grid.Row="0" Grid.Column="0" Content="Open Calculator" Command="{x:Bind ViewModel.OpenCalculatorCommand}" HorizontalAlignment="Stretch" />
                <Button Grid.Row="0" Grid.Column="1" Content="Open Notepad" Command="{x:Bind ViewModel.OpenNotepadCommand}" HorizontalAlignment="Stretch" />
                <Button Grid.Row="1" Grid.Column="0" Content="Open Paint" Command="{x:Bind ViewModel.OpenPaintCommand}" HorizontalAlignment="Stretch" />
                <Button Grid.Row="1" Grid.Column="1" Content="Open Settings" Command="{x:Bind ViewModel.OpenSettingsCommand}" HorizontalAlignment="Stretch" />
                <Button Grid.Row="2" Grid.Column="0" Content="Open Store" Command="{x:Bind ViewModel.OpenStoreCommand}" HorizontalAlignment="Stretch" />
                <Button Grid.Row="2" Grid.Column="1" Content="Open File Explorer" Command="{x:Bind ViewModel.OpenExplorerCommand}" HorizontalAlignment="Stretch" />
                <Button Grid.Row="3" Grid.Column="0" Content="Open Terminal" Command="{x:Bind ViewModel.OpenTerminalCommand}" HorizontalAlignment="Stretch" />
                <Button Grid.Row="3" Grid.Column="1" Content="Open Browser" Command="{x:Bind ViewModel.OpenBrowserCommand}" HorizontalAlignment="Stretch" />
            </Grid>

            <TextBlock Text="Web search" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Search the web for…"
                         KeyDown="SearchBox_KeyDown" />
                <Button Grid.Column="1" Content="Search"
                        Command="{x:Bind ViewModel.WebSearchCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <TextBlock Text="Open folder" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{x:Bind ViewModel.FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="C:\Users\…"
                         KeyDown="FolderBox_KeyDown" />
                <Button Grid.Column="1" Content="Open"
                        Command="{x:Bind ViewModel.OpenFolderCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <TextBlock Text="This PC" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh info" Command="{x:Bind ViewModel.LoadMachineInfoCommand}" />
                <Button Content="Copy to clipboard" Command="{x:Bind ViewModel.CopyMachineInfoCommand}" />
            </StackPanel>
            <Border CornerRadius="8" Padding="12" BorderThickness="1">
                <TextBlock Text="{x:Bind ViewModel.MachineInfo, Mode=OneWay}"
                           FontFamily="Consolas" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
