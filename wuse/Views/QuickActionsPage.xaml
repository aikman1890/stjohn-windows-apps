<Page
    x:Class="Wuse.Views.QuickActionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Uid="QuickActionsPage_QuickActions" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="QuickActionsPage_ThingsWuseCanDoOn"
                       TextWrapping="Wrap" Opacity="0.8" />
            <TextBlock Text="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                       TextWrapping="Wrap" FontStyle="Italic" Opacity="0.8" />

            <TextBlock x:Uid="QuickActionsPage_OpenApps" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Uid="QuickActionsPage_OpenCalculator" Grid.Row="0" Grid.Column="0" Command="{x:Bind ViewModel.OpenCalculatorCommand}" HorizontalAlignment="Stretch" />
                <Button x:Uid="QuickActionsPage_OpenNotepad" Grid.Row="0" Grid.Column="1" Command="{x:Bind ViewModel.OpenNotepadCommand}" HorizontalAlignment="Stretch" />
                <Button x:Uid="QuickActionsPage_OpenPaint" Grid.Row="1" Grid.Column="0" Command="{x:Bind ViewModel.OpenPaintCommand}" HorizontalAlignment="Stretch" />
                <Button x:Uid="QuickActionsPage_OpenSettings" Grid.Row="1" Grid.Column="1" Command="{x:Bind ViewModel.OpenSettingsCommand}" HorizontalAlignment="Stretch" />
                <Button x:Uid="QuickActionsPage_OpenStore" Grid.Row="2" Grid.Column="0" Command="{x:Bind ViewModel.OpenStoreCommand}" HorizontalAlignment="Stretch" />
                <Button x:Uid="QuickActionsPage_OpenFileExplorer" Grid.Row="2" Grid.Column="1" Command="{x:Bind ViewModel.OpenExplorerCommand}" HorizontalAlignment="Stretch" />
                <Button x:Uid="QuickActionsPage_OpenTerminal" Grid.Row="3" Grid.Column="0" Command="{x:Bind ViewModel.OpenTerminalCommand}" HorizontalAlignment="Stretch" />
                <Button x:Uid="QuickActionsPage_OpenBrowser" Grid.Row="3" Grid.Column="1" Command="{x:Bind ViewModel.OpenBrowserCommand}" HorizontalAlignment="Stretch" />
            </Grid>

            <TextBlock x:Uid="QuickActionsPage_WebSearch" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Uid="QuickActionsPage_SearchTheWebFor" Grid.Column="0"
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SearchBox_KeyDown" />
                <Button x:Uid="QuickActionsPage_Search" Grid.Column="1"
                        Command="{x:Bind ViewModel.WebSearchCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <TextBlock x:Uid="QuickActionsPage_OpenFolder" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Uid="QuickActionsPage_CUsers" Grid.Column="0"
                         Text="{x:Bind ViewModel.FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="FolderBox_KeyDown" />
                <Button x:Uid="QuickActionsPage_Open" Grid.Column="1"
                        Command="{x:Bind ViewModel.OpenFolderCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <TextBlock x:Uid="QuickActionsPage_ThisPC" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="QuickActionsPage_RefreshInfo" Command="{x:Bind ViewModel.LoadMachineInfoCommand}" />
                <Button x:Uid="QuickActionsPage_CopyToClipboard" Command="{x:Bind ViewModel.CopyMachineInfoCommand}" />
            </StackPanel>
            <Border CornerRadius="8" Padding="12" BorderThickness="1">
                <TextBlock Text="{x:Bind ViewModel.MachineInfo, Mode=OneWay}"
                           FontFamily="Consolas" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
