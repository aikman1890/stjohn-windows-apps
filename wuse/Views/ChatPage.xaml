<Page
    x:Class="Wuse.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Wuse.Models"
    xmlns:converters="using:Wuse.Converters">

    <Page.Resources>
        <converters:ChatAlignmentConverter x:Key="ChatAlignmentConverter" />
        <converters:ChatBackgroundConverter x:Key="ChatBackgroundConverter" />
        <converters:ChatForegroundConverter x:Key="ChatForegroundConverter" />
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter" />
    </Page.Resources>

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton x:Uid="ChatPage_NewChat" Icon="Add" Command="{x:Bind ViewModel.NewConversationCommand}" />
            <AppBarToggleButton x:Uid="VoiceRepliesToggle" Icon="Volume" Label="Voice replies"
                                IsChecked="{x:Bind ViewModel.SpeakReplies, Mode=TwoWay}"
                                ToolTipService.ToolTip="Speak replies aloud" />
        </CommandBar>

        <InfoBar x:Uid="ChatPage_OnDeviceAIUnavailable" Grid.Row="1"
                 Message="{x:Bind ViewModel.AiStatusMessage, Mode=OneWay}"
                 Severity="Warning"
                 IsClosable="False"
                 IsOpen="{x:Bind ViewModel.IsAiUnavailable, Mode=OneWay}"
                 Margin="0,0,0,8" />

        <ListView Grid.Row="2"
                  x:Name="MessageList"
                  ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <Border HorizontalAlignment="{x:Bind Role, Converter={StaticResource ChatAlignmentConverter}, Mode=OneWay}"
                            Background="{x:Bind Role, Converter={StaticResource ChatBackgroundConverter}, Mode=OneWay}"
                            CornerRadius="12" Padding="12,8" Margin="8,4" MaxWidth="560">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                       TextWrapping="WrapWholeWords"
                                       Foreground="{x:Bind Role, Converter={StaticResource ChatForegroundConverter}, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind At, Converter={StaticResource DateTimeFormatConverter}, Mode=OneWay}"
                                       Opacity="0.6" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0"
                                       Foreground="{x:Bind Role, Converter={StaticResource ChatForegroundConverter}, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3" ColumnSpacing="8" Margin="0,8,0,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Uid="ChatPage_InputTextBox" x:Name="InputTextBox" Grid.Column="0"
                     Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="InputTextBox_KeyDown" />
            <Button x:Name="MicButton" x:Uid="MicButton" Grid.Column="1"
                    Click="MicButton_Click"
                    AutomationProperties.Name="Voice input"
                    ToolTipService.ToolTip="Speak your message">
                <SymbolIcon Symbol="Microphone" />
            </Button>
            <Button x:Uid="ChatPage_Send" Grid.Column="2"
                    Command="{x:Bind ViewModel.SendCommand}"
                    Style="{StaticResource AccentButtonStyle}" />
            <ProgressRing Grid.Column="3"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Width="28" Height="28" />
        </Grid>
    </Grid>
</Page>
