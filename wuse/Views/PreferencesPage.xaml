<Page
    x:Class="Wuse.Views.PreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="20" Padding="24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Preferences" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="8">
                <TextBlock Text="Assistant name" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="This is what wuse calls itself in chat." Opacity="0.7" TextWrapping="Wrap" />
                <TextBox Text="{x:Bind ViewModel.AssistantName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="wuse" MaxWidth="320" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                          SelectedItem="{x:Bind ViewModel.ThemeName, Mode=TwoWay}"
                          MinWidth="200" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="8">
                <ToggleSwitch Header="Remember about me"
                              IsOn="{x:Bind ViewModel.RememberAboutMe, Mode=TwoWay}" />
                <TextBlock Text="When on, the facts you add below are included in the assistant's instructions."
                           Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Things to remember" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.Facts, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,4">
                                <TextBlock Grid.Column="0" Text="{x:Bind}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Remove" Click="RemoveFactButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" x:Name="NewFactTextBox"
                             Text="{x:Bind ViewModel.NewFactText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="e.g. My dog's name is Biscuit"
                             KeyDown="NewFactTextBox_KeyDown" />
                    <Button Grid.Column="1" Content="Add"
                            Command="{x:Bind ViewModel.AddFactCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
