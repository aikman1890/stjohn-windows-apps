<Page
    x:Class="Wuse.Views.PreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="PreferencesPage_Loaded">

    <ScrollViewer>
        <StackPanel Spacing="20" Padding="24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Uid="PreferencesPage_Preferences" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="8">
                <TextBlock x:Uid="PreferencesPage_AssistantName" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Uid="PreferencesPage_ThisIsWhatWuseCalls" Opacity="0.7" TextWrapping="Wrap" />
                <TextBox x:Uid="PreferencesPage_Wuse" Text="{x:Bind ViewModel.AssistantName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxWidth="320" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="PreferencesPage_Theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                          SelectedItem="{x:Bind ViewModel.ThemeName, Mode=TwoWay}"
                          MinWidth="200" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Voice" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="The voice wuse speaks with. Changes apply right away."
                           Opacity="0.7" TextWrapping="Wrap" />
                <ComboBox ItemsSource="{x:Bind ViewModel.Voices, Mode=OneWay}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{x:Bind ViewModel.SelectedVoice, Mode=TwoWay}"
                          MinWidth="280" HorizontalAlignment="Left" />
                <ToggleSwitch Header="Speak replies aloud"
                              IsOn="{x:Bind ViewModel.SpeakReplies, Mode=TwoWay}" />
                <Button Content="Preview voice" Click="PreviewVoiceButton_Click" HorizontalAlignment="Left" />
                <TextBox Header="VoiceStudio voice profile name"
                         Text="{x:Bind ViewModel.VoiceStudioProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Shaun"
                         MaxWidth="320" HorizontalAlignment="Left" />
                <TextBlock Text="When set, wuse speaks in Shaun's VoiceStudio cloned voice. wuse installs and sets up VoiceStudio automatically on first launch — nothing for you to do. Clear this box to use the Windows voice above instead."
                           Opacity="0.7" TextWrapping="Wrap" />
                <ToggleSwitch Header="Family memory book"
                              IsOn="{x:Bind ViewModel.MemoryBookEnabled, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.IsMemoryBookAvailable, Mode=OneWay}" />
                <TextBlock Text="When on and a family memory book is installed on this PC, wuse can share Shaun's memories with the family. It speaks as wuse — never pretending to be Shaun."
                           Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Family mode" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ToggleSwitch Header="Family mode (for Shaun's family)"
                              IsOn="{x:Bind ViewModel.FamilyMode, Mode=TwoWay}" />
                <TextBlock Text="When on, Shaun AI talks only: no email, vault, files, calendar, or account actions run, and no conversation is saved. Private topics get one boundary reply. Shaun AI is an assistant named for Shaun — it speaks in his voice but never claims to be him. Family mode is a household-trust setting, not a lock: anyone who opens Preferences can switch it back off."
                           Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <ToggleSwitch x:Uid="PreferencesPage_RememberAboutMe"
                              IsOn="{x:Bind ViewModel.RememberAboutMe, Mode=TwoWay}" />
                <TextBlock x:Uid="PreferencesPage_WhenOnTheFactsYou"
                           Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="PreferencesPage_ThingsToRemember" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.Facts, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button x:Uid="PreferencesPage_Remove" Grid.Column="1" Click="RemoveFactButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Uid="PreferencesPage_NewFactTextBox" Grid.Column="0" x:Name="NewFactTextBox"
                             Text="{x:Bind ViewModel.NewFactText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="NewFactTextBox_KeyDown" />
                    <Button x:Uid="PreferencesPage_Add" Grid.Column="1"
                            Command="{x:Bind ViewModel.AddFactCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="License" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="LicenseStatusText" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBox x:Name="LicenseKeyBox" Header="License key" PlaceholderText="XXXXX-XXXXX-XXXXX-XXXXX" />
                <TextBox x:Name="LicenseEmailBox" Header="Purchase email" PlaceholderText="Email used at purchase" InputScope="EmailSmtpAddress" />
                <Button Content="Activate" Click="ActivateLicense_Click" HorizontalAlignment="Left" />
                <TextBlock x:Name="LicenseResultText" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
