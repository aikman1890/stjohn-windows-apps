<Page
    x:Class="Wuse.Views.ConversationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Wuse.Models">

    <Grid RowDefinitions="Auto,*" Padding="16">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <TextBlock Text="Conversations" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Content="New chat" Command="{x:Bind ViewModel.NewCommand}" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Conversations, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Conversation">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="8">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text='{x:Bind StartedAt.ToString("g"), Mode=OneWay}'
                                       Opacity="0.6" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Open" Click="OpenButton_Click" />
                            <Button Content="Rename" Click="RenameButton_Click" />
                            <Button Content="Delete" Click="DeleteButton_Click" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
