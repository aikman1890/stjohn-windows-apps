<Page
    x:Class="Wuse.Views.ConversationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Wuse.Models"
    xmlns:converters="using:Wuse.Converters">
    <Page.Resources>
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter" />
    </Page.Resources>

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <TextBlock x:Uid="ConversationsPage_Conversations" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:Uid="ConversationsPage_NewChat" Command="{x:Bind ViewModel.NewCommand}" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Conversations, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Conversation">
                    <Grid ColumnSpacing="12" Padding="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind StartedAt, Converter={StaticResource DateTimeFormatConverter}, Mode=OneWay}"
                                       Opacity="0.6" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Uid="ConversationsPage_Open" Click="OpenButton_Click" />
                            <Button x:Uid="ConversationsPage_Rename" Click="RenameButton_Click" />
                            <Button x:Uid="ConversationsPage_Delete" Click="DeleteButton_Click" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
