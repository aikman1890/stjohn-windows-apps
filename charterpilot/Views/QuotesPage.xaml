<Page
    x:Class="CharterPilot.Views.QuotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CharterPilot.Models">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
            <TextBlock Text="Quote log" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Every quote ever sent, with its follow-up clock. Touching a quote restarts its clock - silence is what kills them." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="QuoteList" SelectionChanged="QuoteList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Quote">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                            <Ellipse Width="12" Height="12" Fill="{x:Bind FlagBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="NewButton" Content="New quote" Click="NewButton_Click" HorizontalAlignment="Left" />
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Quote" FontSize="19" FontWeight="SemiBold" />
                <TextBlock x:Name="MarginText" FontWeight="SemiBold" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="ClientBox" Grid.Row="0" Grid.Column="0" Header="Client" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                    <CalendarDatePicker x:Name="DepartPicker" Grid.Row="0" Grid.Column="1" Header="Departure date" Margin="0,0,0,8" />
                    <TextBox x:Name="FromBox" Grid.Row="1" Grid.Column="0" Header="From" Margin="0,0,8,8" />
                    <TextBox x:Name="ToBox" Grid.Row="1" Grid.Column="1" Header="To" Margin="0,0,0,8" />
                    <ComboBox x:Name="ClassBox" Grid.Row="2" Grid.Column="0" Header="Aircraft class" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                    <ComboBox x:Name="OperatorBox" Grid.Row="2" Grid.Column="1" Header="Operator quoted" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                    <TextBox x:Name="TailBox" Grid.Row="3" Grid.Column="0" Header="Tail offered" Margin="0,0,8,8" />
                    <TextBox x:Name="CurrencyBox" Grid.Row="3" Grid.Column="1" Header="Currency" Margin="0,0,0,8" />
                    <TextBox x:Name="CostBox" Grid.Row="4" Grid.Column="0" Header="Operator cost to you" Margin="0,0,8,8" />
                    <TextBox x:Name="PriceBox" Grid.Row="4" Grid.Column="1" Header="Price quoted to client" Margin="0,0,0,8" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="PresetBox" Grid.Row="0" Grid.Column="0" Header="Follow-up clock" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                    <ComboBox x:Name="StatusBox" Grid.Row="0" Grid.Column="1" Header="Status" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                    <ComboBox x:Name="ReasonBox" Grid.Row="1" Grid.Column="0" Header="Lost / expired reason" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                    <TextBox x:Name="NotesBox" Grid.Row="1" Grid.Column="1" Header="Notes" Margin="0,0,0,8" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save quote" Click="SaveButton_Click" />
                    <Button x:Name="TouchButton" Content="Touch now (restart clock)" Click="TouchButton_Click" />
                    <Button x:Name="BookButton" Content="Book it (create trip file)" Click="BookButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
