<Page
    x:Class="CharterPilot.Views.ClientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
            <TextBlock Text="Clients" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="The moat, made searchable: preferences, bookers, and what each client is actually worth." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="ClientList" SelectionChanged="ClientList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="NewButton" Content="New client" Click="NewButton_Click" HorizontalAlignment="Left" />
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Client file" FontSize="19" FontWeight="SemiBold" />
                <TextBlock x:Name="HistoryText" TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="0" Header="Client name" Margin="0,0,8,8" />
                    <TextBox x:Name="CompanyBox" Grid.Row="0" Grid.Column="1" Header="Company / family office" Margin="0,0,0,8" />
                    <TextBox x:Name="EmailBox" Grid.Row="1" Grid.Column="0" Header="Email" Margin="0,0,8,8" />
                    <TextBox x:Name="PhoneBox" Grid.Row="1" Grid.Column="1" Header="Phone" Margin="0,0,0,8" />
                    <TextBox x:Name="BookerBox" Grid.Row="2" Grid.Column="0" Header="Booker / assistant" Margin="0,0,8,8" />
                    <TextBox x:Name="BookerContactBox" Grid.Row="2" Grid.Column="1" Header="Booker contact" Margin="0,0,0,8" />
                </Grid>
                <TextBox x:Name="PrefsBox" Header="Preferences (aircraft class, cabin, catering, FBO, ground transport)" AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="52" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save client" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
