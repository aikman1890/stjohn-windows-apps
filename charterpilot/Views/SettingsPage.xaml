<Page
    x:Class="CharterPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="660" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBox x:Name="BrokerBox" Header="Brokerage name (prints on trip summaries)" />
            <TextBox x:Name="AddressBox" Header="Address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
            <TextBox x:Name="PhoneBox" Header="Phone" />
            <TextBox x:Name="CurrencyBox" Header="Default currency (USD / EUR / GBP)" />
            <TextBlock Text="Aircraft classes (one per line)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="ClassesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="110" />
            <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="SavedText" Opacity="0.75" />
            <TextBlock Text="CharterPilot is the broker's own book of record: no flight operations, dispatch, or crew-duty tracking; no marketplace or live availability; no payments or client portals; no quoting engine. Flight operations and safety remain the operator's responsibility. Client lists and margins - the most commercially sensitive data a broker owns - never leave this machine." Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
