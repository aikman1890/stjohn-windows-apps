<Page
    x:Class="CharterPilot.Views.OperatorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CharterPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Operators &amp; tails" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Your own record of who performs: reliability, catering standard, cancellation behavior, deadhead notes. When a trip goes wrong, the record is here - not in memory." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="OperatorList" SelectionChanged="OperatorList_SelectionChanged" MaxHeight="180">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid MaxWidth="840" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="0" Header="Operator" Margin="0,0,8,8" />
                <TextBox x:Name="ContactBox" Grid.Row="0" Grid.Column="1" Header="Contact" Margin="0,0,0,8" />
                <TextBox x:Name="BaseBox" Grid.Row="1" Grid.Column="0" Header="Home base" Margin="0,0,8,8" />
                <TextBox x:Name="TypesBox" Grid.Row="1" Grid.Column="1" Header="Aircraft types" Margin="0,0,0,8" />
                <TextBox x:Name="OpNotesBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Header="Broker's notes (reliability, catering, cancellation, deadheads)" AcceptsReturn="True" TextWrapping="Wrap" Height="56" Margin="0,0,0,8" />
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveOpButton" Content="Save operator" Click="SaveOpButton_Click" />
                    <Button x:Name="NewOpButton" Content="New operator" Click="NewOpButton_Click" />
                    <Button x:Name="DeleteOpButton" Content="Delete" Click="DeleteOpButton_Click" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Tails" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ListView x:Name="TailList" SelectionMode="None" MaxHeight="160">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Tail">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="TailNumBox" Header="Tail number" Width="150" />
                <TextBox x:Name="TailTypeBox" Header="Aircraft type" Width="200" />
                <TextBox x:Name="TailBaseBox" Header="Home base" Width="150" />
                <TextBox x:Name="TailNotesBox" Header="Notes" Width="240" />
                <Button x:Name="TailButton" Content="Add tail for selected operator" Click="TailButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
