<?xml version="1.0" encoding="UTF-8"?>
<!--
  CharterPilot MSI installer - WiX Toolset v5, per-user (no admin / no UAC).
  Installs to %LOCALAPPDATA%\Programs\St. John Pictures\CharterPilot.
  The <ComponentGroupRef Id="AppFiles" /> is satisfied by Files.wxs, which
  the build workflow generates from the publish output.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="CharterPilot"
           Language="1033"
           Version="1.0.0"
           Manufacturer="St. John Pictures"
           ProductCode="4F6F9ED9-3AF6-4E50-9608-1179C21A4496"
           UpgradeCode="E5AE221D-5C4D-484C-8CC9-32AC3FA8775C"
           Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of CharterPilot is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPPRODUCTICON" Value="[INSTALLFOLDER]CharterPilot.exe" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://aikman1890.github.io/stjohn-windows-apps/" />

    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="CompanyDir" Name="St. John Pictures">
          <Directory Id="INSTALLFOLDER" Name="CharterPilot" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutsDir" Name="CharterPilot">
        <Component Id="StartMenuShortcut" Guid="8F5768EC-FD19-4D93-B736-C1AD2F8D5F98" Bitness="always64">
          <Shortcut Id="AppStartMenuShortcut"
                    Name="CharterPilot"
                    Description="CharterPilot - charter broker quote and trip book for Windows"
                    Target="[INSTALLFOLDER]CharterPilot.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppShortcutsDir" Directory="AppShortcutsDir" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\St. John Pictures\CharterPilot"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="CharterPilot" Level="1">
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
</Wix>
