<Page
    x:Class="BillPilot.Views.BillsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:BillPilot.Converters">

    <Page.Resources>
        <conv:DaysRemainingBrushConverter x:Key="DaysBrush" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Bill details" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="ProviderBox" Header="Provider / utility" />
                <TextBox x:Name="AccountBox" Header="Account label" />
                <TextBox x:Name="AmountDueBox" Header="Amount due" />
                <DatePicker x:Name="DueDatePicker" Header="Due date" />
                <TextBox x:Name="DisputedBox" Header="Amount disputed" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch" />
                <TextBox x:Name="CaseRefBox" Header="Case / reference number" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="Due dates count down by day: green while comfortable, orange within 5 days, red once past due."
                           TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubLine}" Opacity="0.75" FontSize="12" />
                        <TextBlock Text="{Binding DueText}" FontSize="12"
                                   Foreground="{Binding DaysRemaining, Converter={StaticResource DaysBrush}}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
