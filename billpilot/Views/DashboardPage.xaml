<Page
    x:Class="BillPilot.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="BillPilot" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Every bill, due date, and dispute - on this PC only." Opacity="0.75" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="32" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="TotalText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Total bills" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="DisputedText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="In dispute" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="PastDueText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Past due" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="PaidText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Paid / closed" Opacity="0.7" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Due dates, soonest first" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
            <ListView x:Name="DueList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
