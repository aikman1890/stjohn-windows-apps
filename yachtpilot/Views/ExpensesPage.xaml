<Page
    x:Class="YachtPilot.Views.ExpensesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YachtPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Owner expense ledger" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Every cost per vessel, with its currency stated - amounts are decimals with an explicit currency code, never assumed. The owner statement below is generated from this ledger." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="ExpenseList" SelectionChanged="ExpenseList_SelectionChanged" MaxHeight="260">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Expense">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid MaxWidth="880" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="VesselBox" Grid.Row="0" Grid.Column="0" Header="Vessel" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                <ComboBox x:Name="CategoryBox" Grid.Row="0" Grid.Column="1" Header="Category" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                <CalendarDatePicker x:Name="DatePicker" Grid.Row="1" Grid.Column="0" Header="Date" Margin="0,0,8,8" />
                <TextBox x:Name="NoteBox" Grid.Row="1" Grid.Column="1" Header="Note" Margin="0,0,0,8" />
                <TextBox x:Name="AmountBox" Grid.Row="2" Grid.Column="0" Header="Amount" Margin="0,0,8,8" />
                <TextBox x:Name="CurrencyBox" Grid.Row="2" Grid.Column="1" Header="Currency" Margin="0,0,0,8" />
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save expense" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="NewButton" Content="New" Click="NewButton_Click" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Owner statement" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="StmtVesselBox" Header="Vessel" Width="280" />
                <TextBox x:Name="StmtMonthBox" Header="Month (yyyy-MM)" Width="150" />
                <Button x:Name="StmtButton" Content="Export statement (HTML)" Click="StmtButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
