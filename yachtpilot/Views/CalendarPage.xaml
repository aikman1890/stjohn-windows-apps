<Page
    x:Class="YachtPilot.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YachtPilot.Models">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
            <TextBlock Text="Charter &amp; use calendar" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Overlapping bookings on the same vessel cannot be saved. A charter saved over an expired-certificate window is flagged below, never hidden." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="BookingList" SelectionChanged="BookingList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Booking">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Flags" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBlock x:Name="FlagsText" TextWrapping="Wrap" />
            <Button x:Name="NewButton" Content="New booking" Click="NewButton_Click" HorizontalAlignment="Left" />
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Booking" FontSize="19" FontWeight="SemiBold" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="VesselBox" Grid.Row="0" Grid.Column="0" Header="Vessel" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                    <ComboBox x:Name="KindBox" Grid.Row="0" Grid.Column="1" Header="Kind" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                    <CalendarDatePicker x:Name="StartPicker" Grid.Row="1" Grid.Column="0" Header="Start" Margin="0,0,8,8" />
                    <CalendarDatePicker x:Name="EndPicker" Grid.Row="1" Grid.Column="1" Header="End" Margin="0,0,0,8" />
                    <TextBox x:Name="ChartererBox" Grid.Row="2" Grid.Column="0" Header="Charterer (held locally)" Margin="0,0,8,8" />
                    <TextBox x:Name="BrokerBox" Grid.Row="2" Grid.Column="1" Header="Broker" Margin="0,0,0,8" />
                    <TextBox x:Name="RateBox" Grid.Row="3" Grid.Column="0" Header="Rate" Margin="0,0,8,8" />
                    <TextBox x:Name="CurrencyBox" Grid.Row="3" Grid.Column="1" Header="Currency (USD / EUR / GBP...)" Margin="0,0,0,8" />
                    <TextBox x:Name="ApaInBox" Grid.Row="4" Grid.Column="0" Header="APA advance received" Margin="0,0,8,8" />
                    <TextBox x:Name="ApaOutBox" Grid.Row="4" Grid.Column="1" Header="APA spent" Margin="0,0,0,8" />
                </Grid>
                <ComboBox x:Name="StatusBox" Header="Status" HorizontalAlignment="Stretch" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="52" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save booking" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
