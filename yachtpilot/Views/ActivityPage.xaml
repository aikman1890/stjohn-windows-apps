<Page
    x:Class="YachtPilot.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YachtPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Proof &amp; activity ledger" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Per vessel, the chronological record: certificates renewed, services completed, charters run, statements sent. Certificates and services log themselves from their own pages; add anything else here. This export is the answer to an owner's 'what have you actually done this quarter?'" Opacity="0.7" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="VesselBox" Header="Vessel (filter / export)" Width="300" />
                <Button x:Name="ExportButton" Content="Export ledger (HTML)" Click="ExportButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <ListView x:Name="ActivityList" MaxHeight="330">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ActivityEntry">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="KindBox" Header="Kind" Width="200" />
                <TextBox x:Name="DetailBox" Header="Detail" Width="340" />
                <TextBox x:Name="MethodBox" Header="Method / note" Width="200" />
                <Button x:Name="AddButton" Content="Add entry" Click="AddButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
