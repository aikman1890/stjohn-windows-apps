<Page
    x:Class="YachtPilot.Views.VesselsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
            <TextBlock Text="Vessels" FontSize="22" FontWeight="SemiBold" />
            <ListView x:Name="VesselList" SelectionChanged="VesselList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="NewButton" Content="New vessel" Click="NewButton_Click" HorizontalAlignment="Left" />
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Vessel file" FontSize="19" FontWeight="SemiBold" />
                <TextBlock x:Name="ReadyText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="0" Header="Vessel name" Margin="0,0,8,8" />
                    <TextBox x:Name="FlagBox" Grid.Row="0" Grid.Column="1" Header="Flag" Margin="0,0,0,8" />
                    <TextBox x:Name="BerthBox" Grid.Row="1" Grid.Column="0" Header="Berth / home port" Margin="0,0,8,8" />
                    <TextBox x:Name="DimsBox" Grid.Row="1" Grid.Column="1" Header="Dimensions / class" Margin="0,0,0,8" />
                    <TextBox x:Name="OwnerBox" Grid.Row="2" Grid.Column="0" Header="Owner" Margin="0,0,8,8" />
                    <TextBox x:Name="OwnerContactBox" Grid.Row="2" Grid.Column="1" Header="Owner contact" Margin="0,0,0,8" />
                    <CalendarDatePicker x:Name="InsPicker" Grid.Row="3" Grid.Column="0" Header="Insurance expiry (as recorded)" Margin="0,0,8,8" />
                    <CalendarDatePicker x:Name="RegPicker" Grid.Row="3" Grid.Column="1" Header="Registration expiry (as recorded)" Margin="0,0,0,8" />
                    <TextBox x:Name="HoursBox" Grid.Row="4" Grid.Column="0" Header="Current engine hours (log updates)" Margin="0,0,8,8" />
                    <TextBox x:Name="NotesBox" Grid.Row="4" Grid.Column="1" Header="Notes" Margin="0,0,0,8" />
                </Grid>
                <TextBox x:Name="OverrideBox" Header="Charter-ready override note (dated, on the record - blank means no override)" AcceptsReturn="True" TextWrapping="Wrap" Height="52" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save vessel" Click="SaveButton_Click" />
                    <Button x:Name="OverrideButton" Content="Stamp override today" Click="OverrideButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
                <TextBlock Text="Document vault (local paths)" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
                <ListView x:Name="DocList" SelectionMode="None" MaxHeight="140">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="DocKindBox" Header="Kind" Width="170" />
                    <TextBox x:Name="DocTitleBox" Header="Title" Width="220" />
                    <TextBox x:Name="DocPathBox" Header="Local path" Width="280" />
                    <Button x:Name="DocButton" Content="Add" Click="DocButton_Click" VerticalAlignment="Bottom" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
