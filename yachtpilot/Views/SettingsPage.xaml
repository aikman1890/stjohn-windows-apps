<Page
    x:Class="YachtPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBox x:Name="CompanyBox" Header="Management company name (prints on owner statements)" />
            <TextBox x:Name="AddressBox" Header="Address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
            <TextBox x:Name="PhoneBox" Header="Phone" />
            <TextBox x:Name="CurrencyBox" Header="Default currency code (USD / EUR / GBP)" />
            <TextBlock Text="Certificate types (one per line)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="TypesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="130" />
            <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="SavedText" Opacity="0.75" />
            <TextBlock Text="YachtPilot is the management company's back-office book: no live vessel tracking (AIS), no weather, no navigation, no ISM or flag-state compliance certification - it tracks the dates and documents you enter and flags expiries; certification remains the operator's responsibility. No charter marketplace, no payments, no crew payroll, no owner or crew portals. Everything is stored locally - the book works at sea, in the yard, and in the marina dead zone." Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
