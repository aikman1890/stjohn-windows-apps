<Page
    x:Class="DisputePilot.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="DisputePilot" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Every dispute, its 30-day clock, and its proof - on this PC only." Opacity="0.75" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="32" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="TotalText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Total disputes" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="AwaitingText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Awaiting validation" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="OverdueText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Overdue / violation" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="DeletedText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Deleted / settled" Opacity="0.7" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Deadlines, soonest first" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
            <ListView x:Name="DeadlineList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
