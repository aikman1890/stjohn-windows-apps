<Page
    x:Class="DisputePilot.Views.DisputesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:DisputePilot.Converters">

    <Page.Resources>
        <conv:DaysRemainingBrushConverter x:Key="DaysBrush" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="10">
            <TextBlock Text="Dispute details" FontSize="20" FontWeight="SemiBold" />
            <TextBox x:Name="CreditorBox" Header="Creditor / collector" />
            <TextBox x:Name="AccountBox" Header="Account / file reference" />
            <TextBox x:Name="AmountBox" Header="Amount claimed" />
            <DatePicker x:Name="SentDatePicker" Header="Dispute sent date" />
            <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch" />
            <TextBox x:Name="NotesBox" Header="Proof-ledger notes" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
            </StackPanel>
            <TextBlock Text="The 30-day response deadline is calculated from the sent date. Overdue deadlines turn red."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
        </StackPanel>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubLine}" Opacity="0.75" FontSize="12" />
                        <TextBlock Text="{Binding DeadlineText}" FontSize="12"
                                   Foreground="{Binding DaysRemaining, Converter={StaticResource DaysBrush}}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
