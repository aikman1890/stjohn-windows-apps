<Page
    x:Class="InvoicePilot.Views.InvoicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Invoice details" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="NumberBox" Header="Invoice / quote number" />
                <TextBox x:Name="ClientBox" Header="Client" />
                <TextBox x:Name="ContactBox" Header="Client email / contact" />
                <DatePicker x:Name="IssuePicker" Header="Issue date" />
                <DatePicker x:Name="DuePicker" Header="Due date" />
                <CheckBox x:Name="DueCheck" Content="Set a due date" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch" />
                <TextBox x:Name="TaxBox" Header="Tax % (0 if none)" Text="0" TextChanged="TaxBox_TextChanged" />

                <TextBlock Text="Line items" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RescuePresetButton" Content="Add rescue preset ($500)" Click="RescuePresetButton_Click" />
                    <Button x:Name="ConsultPresetButton" Content="Add consulting hour ($65)" Click="ConsultPresetButton_Click" />
                </StackPanel>
                <TextBox x:Name="ItemDescBox" Header="Item description" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="ItemQtyBox" Header="Qty" Text="1" Width="90" />
                    <TextBox x:Name="ItemRateBox" Header="Rate ($)" Text="0" Width="120" />
                    <Button x:Name="AddItemButton" Content="Add item" Click="AddItemButton_Click" VerticalAlignment="Bottom" />
                    <Button x:Name="RemoveItemButton" Content="Remove selected" Click="RemoveItemButton_Click" VerticalAlignment="Bottom" />
                </StackPanel>
                <ListView x:Name="ItemsEditList" Height="130" SelectionChanged="ItemsEditList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLine}" Padding="4,3" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="TotalsText" FontWeight="SemiBold" TextWrapping="Wrap" />

                <TextBox x:Name="NotesBox" Header="Notes (printed on the invoice)" AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <Button x:Name="ExportButton" Content="Export invoice (.html, printable)" Click="ExportButton_Click" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubLine}" Opacity="0.75" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
