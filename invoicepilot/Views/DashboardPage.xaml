<Page
    x:Class="InvoicePilot.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="InvoicePilot" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="BCCS invoices and quotes, generated and stored on this PC only." Opacity="0.75" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="32" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="TotalText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Total invoices" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="OutstandingText" FontSize="32" FontWeight="SemiBold" Text="$0" />
                    <TextBlock Text="Outstanding" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="PaidText" FontSize="32" FontWeight="SemiBold" Text="$0" />
                    <TextBlock Text="Paid" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="DraftText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Drafts" Opacity="0.7" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Recent invoices" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
            <ListView x:Name="RecentList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
