<Page
    x:Class="HealthPilot.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="10">
            <TextBlock Text="Log entry" FontSize="20" FontWeight="SemiBold" />
            <DatePicker x:Name="EntryDatePicker" Header="Date" />
            <ComboBox x:Name="CategoryCombo" Header="Type" HorizontalAlignment="Stretch" />
            <NumberBox x:Name="PainBox" Header="Pain level (0-10)" Minimum="0" Maximum="10" SpinButtonPlacementMode="Compact" />
            <TextBox x:Name="NotesBox" Header="Notes (CPAP hours, symptoms, what helped)" AcceptsReturn="True" TextWrapping="Wrap" Height="110" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
            </StackPanel>
            <TextBlock Text="CPAP entries: note hours used and mask issues. Pain entries: set the level 0-10."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
        </StackPanel>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubLine}" Opacity="0.75" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
