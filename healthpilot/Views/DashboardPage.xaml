<Page
    x:Class="HealthPilot.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="HealthPilot" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Medications, appointments, CPAP and pain - private, on this PC only. No cloud, no account, no network." Opacity="0.75" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="32" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="MedText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Medications" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="ApptText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Upcoming appointments" Opacity="0.7" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="LogText" FontSize="32" FontWeight="SemiBold" Text="0" />
                    <TextBlock Text="Log entries (30 days)" Opacity="0.7" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="NextApptText" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" Text="Next appointment: none scheduled" TextWrapping="Wrap" />
            <TextBlock Text="Recent log entries" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ListView x:Name="RecentList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
