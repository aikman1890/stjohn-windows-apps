<Page
    x:Class="HealthPilot.Views.MedicationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="10">
            <TextBlock Text="Medication details" FontSize="20" FontWeight="SemiBold" />
            <TextBox x:Name="NameBox" Header="Medication name" />
            <TextBox x:Name="DosageBox" Header="Dosage" />
            <TextBox x:Name="ScheduleBox" Header="Schedule (e.g. twice daily, with food)" />
            <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
            </StackPanel>
        </StackPanel>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubLine}" Opacity="0.75" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
