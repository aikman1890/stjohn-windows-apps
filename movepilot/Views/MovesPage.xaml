<Page
    x:Class="MovePilot.Views.MovesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Move file" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="CustomerBox" Header="Customer" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="PhoneBox" Header="Phone" Width="190" />
                    <TextBox x:Name="EmailBox" Header="Email" Width="190" />
                </StackPanel>
                <TextBox x:Name="OriginBox" Header="Origin" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <TextBox x:Name="DestBox" Header="Destination" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <DatePicker x:Name="MoveDatePicker" Header="Move date" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch">
                    <x:String>Lead</x:String>
                    <x:String>Surveyed</x:String>
                    <x:String>Booked</x:String>
                    <x:String>Packed</x:String>
                    <x:String>Moved</x:String>
                    <x:String>Delivered</x:String>
                    <x:String>Closed</x:String>
                    <x:String>Claim open</x:String>
                </ComboBox>
                <TextBox x:Name="AccessBox" Header="Access notes (stairs, elevator, long carry...)" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <TextBox x:Name="ValuationBox" Header="Valuation choice recorded for this move" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="CrewBox" Header="Crew" Width="90" />
                    <TextBox x:Name="TrucksBox" Header="Trucks" Width="90" />
                    <TextBox x:Name="ContractBox" Header="Contract $" Width="140" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="DepositBox" Header="Deposit $" Width="140" />
                    <TextBox x:Name="CollectedBox" Header="Collected $" Width="140" />
                </StackPanel>
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SheetButton" Content="Export job sheet (HTML)" Click="SheetButton_Click" />
                    <Button x:Name="StatementButton" Content="Export final statement" Click="StatementButton_Click" />
                </StackPanel>

                <TextBlock Text="Room-by-room inventory" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock x:Name="TotalsText" Opacity="0.85" TextWrapping="Wrap" />
                <ComboBox x:Name="PresetPicker" Header="Item preset (your own cube/weight figures)" HorizontalAlignment="Stretch" SelectionChanged="PresetPicker_SelectionChanged" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="RoomBox" Header="Room" Width="140" />
                    <TextBox x:Name="ItemBox" Header="Item" Width="200" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="QtyBox" Header="Qty" Width="70" />
                    <TextBox x:Name="CubeBox" Header="Cu ft each" Width="100" />
                    <TextBox x:Name="WeightBox" Header="Lb each" Width="100" />
                </StackPanel>
                <ComboBox x:Name="PackingCombo" Header="Packing" HorizontalAlignment="Stretch">
                    <x:String>Mover-packed</x:String>
                    <x:String>Owner-packed</x:String>
                    <x:String>Not packed</x:String>
                </ComboBox>
                <CheckBox x:Name="SpecialCheck" Content="Special item (piano, safe, pool table...)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddItemButton" Content="Add item" Click="AddItemButton_Click" />
                    <Button x:Name="RemoveItemButton" Content="Remove selected" Click="RemoveItemButton_Click" />
                </StackPanel>
                <ListView x:Name="InventoryList" MaxHeight="260">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
