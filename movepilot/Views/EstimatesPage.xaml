<Page
    x:Class="MovePilot.Views.EstimatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Estimate builder" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Your own rate table only - the app supplies no prices. Versions are preserved; approvals are logged." Opacity="0.75" TextWrapping="Wrap" />
                <ComboBox x:Name="MovePicker" Header="Move" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="TypeCombo" Header="Estimate type" HorizontalAlignment="Stretch">
                    <x:String>Hourly</x:String>
                    <x:String>Flat</x:String>
                    <x:String>Not-to-exceed</x:String>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="CrewBox" Header="Crew" Width="90" />
                    <TextBox x:Name="TrucksBox" Header="Trucks" Width="90" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="RateBox" Header="Hourly rate $" Width="150" />
                    <TextBox x:Name="HoursBox" Header="Est. hours" Width="120" />
                </StackPanel>
                <TextBox x:Name="FlatBox" Header="Flat amount $ (flat / not-to-exceed)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="TravelBox" Header="Travel fee $" Width="130" />
                    <TextBox x:Name="MaterialsBox" Header="Materials $" Width="130" />
                    <TextBox x:Name="OtherBox" Header="Other $" Width="110" />
                </StackPanel>
                <TextBlock x:Name="AmountText" FontSize="16" FontWeight="SemiBold" />
                <Button x:Name="CalcButton" Content="Recalculate" Click="CalcButton_Click" HorizontalAlignment="Left" />
                <ComboBox x:Name="TermsPicker" Header="Terms preset" HorizontalAlignment="Stretch" SelectionChanged="TermsPicker_SelectionChanged" />
                <TextBox x:Name="TermsBox" Header="Terms (your own words)" AcceptsReturn="True" TextWrapping="Wrap" Height="56" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch">
                    <x:String>Draft</x:String>
                    <x:String>Sent</x:String>
                    <x:String>Approved</x:String>
                    <x:String>Declined</x:String>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save estimate" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
                <TextBlock Text="Approval log entry (who approved, when, how)" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox x:Name="DecidedByBox" Header="Approved / declined by" />
                <TextBox x:Name="MethodBox" Header="Method (in person, email reply, phone...)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ApproveButton" Content="Log approval" Click="ApproveButton_Click" />
                    <Button x:Name="DeclineButton" Content="Log decline" Click="DeclineButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
