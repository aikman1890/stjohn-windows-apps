<Page
    x:Class="MovePilot.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Storage lot" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Billed per started 30-day month. The list on the right is the monthly billing run and aging view in one." Opacity="0.75" TextWrapping="Wrap" />
                <TextBox x:Name="CustomerBox" Header="Customer" />
                <TextBox x:Name="LotBox" Header="Lot ID" />
                <DatePicker x:Name="InPicker" Header="In date" />
                <TextBox x:Name="RateBox" Header="Monthly rate ($)" InputScope="CurrencyAmount" />
                <TextBox x:Name="PaidBox" Header="Paid to date ($)" InputScope="CurrencyAmount" />
                <CheckBox x:Name="OutCheck" Content="Lot is out (set out date)" Checked="OutCheck_Changed" Unchecked="OutCheck_Changed" />
                <DatePicker x:Name="OutPicker" Header="Out date" IsEnabled="False" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock x:Name="TotalsText" TextWrapping="Wrap" Opacity="0.85" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
