<Page
    x:Class="AgreementPilot.Views.VisitsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Service visit" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="EquipmentPicker" Header="Unit serviced" HorizontalAlignment="Stretch" />
                <DatePicker x:Name="DatePickerCtl" Header="Visit date" />
                <TextBox x:Name="WorkBox" Header="Work performed" AcceptsReturn="True" TextWrapping="Wrap" Height="56" />
                <TextBox x:Name="ReadingsBox" Header="Readings / notes" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <TextBox x:Name="RecBox" Header="Recommendation made (if any)" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <ComboBox x:Name="ResponseCombo" Header="Customer response" HorizontalAlignment="Stretch">
                    <x:String>None</x:String>
                    <x:String>Approved</x:String>
                    <x:String>Declined</x:String>
                </ComboBox>
                <TextBox x:Name="RecAmountBox" Header="Recommendation amount ($)" InputScope="CurrencyAmount" />
                <CheckBox x:Name="FollowCheck" Content="Follow-up on a declined recommendation is done" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="Declined-recommendation register" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
                <ListView x:Name="DeclinedList" SelectionMode="None" MaxHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
