<Page
    x:Class="AgreementPilot.Views.EquipmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Equipment record" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="CustomerPicker" Header="Customer / address" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="TypeCombo" Header="Type" HorizontalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="BrandBox" Header="Brand" Width="150" />
                    <TextBox x:Name="ModelBox" Header="Model" Width="150" />
                </StackPanel>
                <TextBox x:Name="SerialBox" Header="Serial number" />
                <DatePicker x:Name="InstallPicker" Header="Install date" />
                <CheckBox x:Name="InstallCheck" Content="Install date known (age computes from it)" />
                <TextBox x:Name="LocationBox" Header="Location in home (attic, garage...)" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="Service history for the selected unit" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ListView x:Name="HistoryList" SelectionMode="None" MaxHeight="240">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding FullLabel}" Foreground="{Binding AgeBrush}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
