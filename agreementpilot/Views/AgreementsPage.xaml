<Page
    x:Class="AgreementPilot.Views.AgreementsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Maintenance agreement" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="CustomerPicker" Header="Customer / address" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="PlanCombo" Header="Plan" IsEditable="True" HorizontalAlignment="Stretch" />
                <TextBox x:Name="PriceBox" Header="Price ($ per year)" InputScope="CurrencyAmount" />
                <DatePicker x:Name="StartPicker" Header="Start date" />
                <DatePicker x:Name="RenewalPicker" Header="Renewal date" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="IncludedBox" Header="Visits included" Width="140" />
                    <TextBox x:Name="DeliveredBox" Header="Visits delivered" Width="140" />
                </StackPanel>
                <TextBox x:Name="CoveredBox" Header="Covered units" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch">
                    <x:String>Active</x:String>
                    <x:String>Renewal due</x:String>
                    <x:String>Renewed</x:String>
                    <x:String>Lapsed</x:String>
                </ComboBox>
                <ComboBox x:Name="PaymentCombo" Header="Payment status" HorizontalAlignment="Stretch">
                    <x:String>Paid</x:String>
                    <x:String>Due</x:String>
                    <x:String>Past due</x:String>
                </ComboBox>
                <TextBox x:Name="DiscountsBox" Header="Discounts honored ($ to date, for the profitability view)" InputScope="CurrencyAmount" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <Button x:Name="VisitButton" Content="Log a delivered visit now" Click="VisitButton_Click" />
                <Button x:Name="RenewButton" Content="Mark renewed (new term: delivered resets, renewal +1yr)" Click="RenewButton_Click" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="2" Spacing="8">
            <TextBlock Text="Renewal pipeline - sorted by days to renewal" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="ItemsList" SelectionChanged="ItemsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" Foreground="{Binding RenewalBrush}" TextWrapping="Wrap" Padding="4,4" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
