<Page
    x:Class="AgreementPilot.Views.ProfitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Agreement profitability &amp; packets" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Operational view on your own figures: price collected vs. visits delivered and discounts honored. Not a deferred-revenue accounting ledger - the accountant's system stays the books." Opacity="0.8" TextWrapping="Wrap" />
            <TextBlock x:Name="TotalsText" FontSize="15" TextWrapping="Wrap" />
            <TextBlock Text="Per agreement" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ListView x:Name="PerAgreementList" SelectionMode="None" MaxHeight="260">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Per plan" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ListView x:Name="PerPlanList" SelectionMode="None" MaxHeight="200">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                <Button x:Name="CsvButton" Content="Export agreement book (CSV)" Click="CsvButton_Click" />
            </StackPanel>
            <TextBlock Text="Renewal packet - pick a customer, export the one-pager for the renewal conversation" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ComboBox x:Name="CustomerPicker" HorizontalAlignment="Stretch" />
            <Button x:Name="PacketButton" Content="Export renewal packet (HTML)" Click="PacketButton_Click" />
            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
