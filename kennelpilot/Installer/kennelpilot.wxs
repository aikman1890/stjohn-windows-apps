<?xml version="1.0" encoding="UTF-8"?>
<!--
  KennelPilot MSI installer - WiX Toolset v5, per-user (no admin / no UAC).
  Installs to %LOCALAPPDATA%\Programs\St. John Pictures\KennelPilot.
  The <ComponentGroupRef Id="AppFiles" /> is satisfied by Files.wxs, which
  the build workflow generates from the publish output.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="KennelPilot"
           Language="1033"
           Version="1.0.0"
           Manufacturer="St. John Pictures"
           ProductCode="9F038A04-07CD-4C54-A258-4AC20FE1E65B"
           UpgradeCode="911B610D-E362-42E9-A8C5-75814F22CDC3"
           Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of KennelPilot is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPPRODUCTICON" Value="[INSTALLFOLDER]KennelPilot.exe" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://aikman1890.github.io/stjohn-windows-apps/" />

    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="CompanyDir" Name="St. John Pictures">
          <Directory Id="INSTALLFOLDER" Name="KennelPilot" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutsDir" Name="KennelPilot">
        <Component Id="StartMenuShortcut" Guid="69BFF73C-F285-4391-9636-1CD5B8C077D3" Bitness="always64">
          <Shortcut Id="AppStartMenuShortcut"
                    Name="KennelPilot"
                    Description="KennelPilot - kennel board, pet files and vaccine gate for Windows"
                    Target="[INSTALLFOLDER]KennelPilot.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppShortcutsDir" Directory="AppShortcutsDir" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\St. John Pictures\KennelPilot"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="KennelPilot" Level="1">
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
</Wix>
