<Page
    x:Class="KennelPilot.Views.OwnersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Owner file" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="NameBox" Header="Owner name" />
                <TextBox x:Name="PhoneBox" Header="Phone" />
                <TextBox x:Name="AltPhoneBox" Header="Alternate phone" />
                <TextBox x:Name="EmailBox" Header="Email" />
                <TextBox x:Name="AddressBox" Header="Address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <TextBox x:Name="EmergencyBox" Header="Emergency contact (name)" />
                <TextBox x:Name="EmergencyPhoneBox" Header="Emergency contact phone" />
                <TextBox x:Name="VetBox" Header="Veterinarian (name)" />
                <TextBox x:Name="VetPhoneBox" Header="Veterinarian phone" />
                <TextBox x:Name="PayNoteBox" Header="Payment note (method on file - never card numbers)" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Phone}" Opacity="0.75" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
