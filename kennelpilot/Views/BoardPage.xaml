<Page
    x:Class="KennelPilot.Views.BoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Kennel board" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="CapacityText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Arriving today" FontWeight="SemiBold" Margin="0,4,0,0" />
                <ListView x:Name="ArrivalsList" MaxHeight="110" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="Departing today" FontWeight="SemiBold" />
                <ListView x:Name="DeparturesList" MaxHeight="110" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Reservation / stay" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ComboBox x:Name="PetPicker" Header="Pet" HorizontalAlignment="Stretch" SelectionChanged="PetPickerChanged" />
                <TextBox x:Name="RunBox" Header="Run / kennel label" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch" />
                <DatePicker x:Name="InPicker" Header="Check-in date" />
                <DatePicker x:Name="OutPicker" Header="Expected check-out date" />
                <TextBlock x:Name="GateText" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBox x:Name="NotesBox" Header="Stay notes" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="The vaccine gate: if the pet's records show an expiry before this stay, or no records at all, KennelPilot will not save the stay until you either fix the pet file or re-enter the dates and confirm the override - so the decision is always a person's, and typing the reason is what makes check-in day calm." TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="2" Spacing="8">
            <TextBlock Text="In the house now" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="InHouseList" MaxHeight="300" SelectionChanged="StayList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="2" Padding="4,6">
                            <TextBlock Text="{Binding PetLabel}" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" />
                            <TextBlock Text="{Binding DisplayLine}" Opacity="0.75" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Upcoming reservations" FontSize="16" FontWeight="SemiBold" />
            <ListView x:Name="UpcomingList" MaxHeight="220" SelectionChanged="StayList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
