<Page
    x:Class="KennelPilot.Views.BillingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Stay billing" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="StayPicker" Header="Create invoice from stay" HorizontalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox x:Name="BathCheck" Content="Add bath" />
                    <CheckBox x:Name="MedsCheck" Content="Meds given (per day)" />
                </StackPanel>
                <Button x:Name="CreateButton" Content="Create invoice" Click="CreateButton_Click" HorizontalAlignment="Left" />
                <TextBlock Text="Selected invoice" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Opacity="0.85" FontSize="12" />
                <ComboBox x:Name="PayStatusCombo" Header="Payment status" HorizontalAlignment="Stretch" />
                <TextBox x:Name="AmountPaidBox" Header="Amount paid ($)" Text="0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SavePayButton" Content="Save payment" Click="SavePayButton_Click" />
                    <Button x:Name="ExportButton" Content="Export invoice (.html)" Click="ExportButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                <TextBlock Text="Rates come from Settings and are always editable before you hand over the invoice. KennelPilot records payments; it never processes them - no card data ever touches this app." TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubLine}" Opacity="0.75" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
