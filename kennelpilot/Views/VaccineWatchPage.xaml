<Page
    x:Class="KennelPilot.Views.VaccineWatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="8">
            <TextBlock Text="Vaccine watch" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Built from the expiry dates on file - the renewal conversation happens weeks before the next booking, not at the door." Opacity="0.75" TextWrapping="Wrap" />
            <TextBlock Text="Expired now" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListView x:Name="ExpiredList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Expiring in 30 days" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListView x:Name="Days30List" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Expiring in 60 days" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListView x:Name="Days60List" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Expiring in 90 days" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListView x:Name="Days90List" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="No vaccination records on file" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListView x:Name="MissingList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
