<Page
    x:Class="KennelPilot.Views.PetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Pet file" FontSize="20" FontWeight="SemiBold" />
                <ComboBox x:Name="OwnerPicker" Header="Owner" HorizontalAlignment="Stretch" />
                <TextBox x:Name="NameBox" Header="Pet name" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="SpeciesCombo" Header="Species" Width="120" />
                    <TextBox x:Name="BreedBox" Header="Breed" Width="150" />
                    <TextBox x:Name="WeightBox" Header="Weight (lb)" Width="90" />
                </StackPanel>
                <TextBox x:Name="AgeBox" Header="Age / birthdate note" />
                <CheckBox x:Name="SpayCheck" Content="Spayed / neutered" />
                <TextBox x:Name="FeedingBox" Header="Feeding instructions" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <TextBox x:Name="MedsBox" Header="Medications (name, dose, schedule - as the owner wrote it)" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <TextBox x:Name="BehaviorBox" Header="Behavior notes (fence climber, dog-selective, storm anxiety...)" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="40" />
                <TextBlock Text="Vaccinations on file" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                <ListView x:Name="VaxList" MaxHeight="140" SelectionChanged="VaxList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="VaxNameBox" Header="Vaccine" Width="130" />
                    <TextBox x:Name="VaxDocBox" Header="Document ref" Width="130" />
                </StackPanel>
                <DatePicker x:Name="VaxExpiryPicker" Header="Expiry date (from the certificate)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="VaxAddButton" Content="Add vaccine" Click="VaxAddButton_Click" />
                    <Button x:Name="VaxRemoveButton" Content="Remove selected" Click="VaxRemoveButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save pet" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="Enter expiry dates exactly as printed on the owner's paperwork, and keep the document reference - KennelPilot tracks what the paperwork says, it does not judge medical sufficiency." TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding FullLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Feeding}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
