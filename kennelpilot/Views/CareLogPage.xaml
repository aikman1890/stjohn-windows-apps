<Page
    x:Class="KennelPilot.Views.CareLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Care log" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Timestamped care entries with staff initials - the record that protects the kennel. Pick a stay to see its full day sheet." TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                <ComboBox x:Name="StayPicker" Header="Stay" HorizontalAlignment="Stretch"
                          SelectionChanged="StayPicker_SelectionChanged" />
                <TextBlock x:Name="PetFileText" TextWrapping="Wrap" Opacity="0.85" FontSize="12" />
                <ComboBox x:Name="KindCombo" Header="Entry kind" HorizontalAlignment="Stretch" />
                <TextBox x:Name="DetailBox" Header="What happened" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                <TextBox x:Name="InitialsBox" Header="Your initials (sign-off)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddButton" Content="Add entry" Click="AddButton_Click" />
                    <Button x:Name="ExportButton" Content="Export day sheet (.html)" Click="ExportButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
