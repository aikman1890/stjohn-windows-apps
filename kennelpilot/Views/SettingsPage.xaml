<Page
    x:Class="KennelPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Kennel Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Your rates and capacity. They preset new invoices and the board header - every invoice stays editable, and KennelPilot ships with no one's prices but the ones you type." Opacity="0.75" TextWrapping="Wrap" />
            <TextBox x:Name="NameBox" Header="Kennel name" />
            <TextBox x:Name="AddressBox" Header="Address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
            <TextBox x:Name="PhoneBox" Header="Phone" />
            <TextBox x:Name="NightlyBox" Header="Nightly rate ($)" />
            <TextBox x:Name="SecondBox" Header="Second-pet nightly rate ($)" />
            <TextBox x:Name="BathBox" Header="Bath rate ($)" />
            <TextBox x:Name="MedsBox" Header="Medication administration ($/day)" />
            <TextBox x:Name="CapacityBox" Header="Capacity (runs)" />
            <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
