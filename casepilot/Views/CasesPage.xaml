<Page
    x:Class="CasePilot.Views.CasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CasePilot.Converters">

    <Page.Resources>
        <conv:DaysRemainingBrushConverter x:Key="DaysBrush" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Case details" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="CaseNameBox" Header="Case name / caption" />
                <TextBox x:Name="CaseNumberBox" Header="Case number" />
                <TextBox x:Name="CourtBox" Header="Court" />
                <TextBox x:Name="JudgeBox" Header="Judge" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch" />
                <TextBox x:Name="DeadlineLabelBox" Header="Deadline description" />
                <DatePicker x:Name="DeadlinePicker" Header="Next key deadline" />
                <TextBox x:Name="HearingTypeBox" Header="Hearing / conference type" />
                <DatePicker x:Name="HearingPicker" Header="Hearing / conference date" />
                <CheckBox x:Name="HearingCheck" Content="Set a hearing / conference date" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="Deadlines count down by day: green while comfortable, orange within 5 days, red once overdue."
                           TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="4,6">
                        <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubLine}" Opacity="0.75" FontSize="12" />
                        <TextBlock Text="{Binding DeadlineText}" FontSize="12"
                                   Foreground="{Binding DaysRemaining, Converter={StaticResource DaysBrush}}" />
                        <TextBlock Text="{Binding HearingText}" FontSize="12" Opacity="0.75" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
