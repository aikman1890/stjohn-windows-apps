<Page
    x:Class="GalleryPilot.Views.ConsignmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GalleryPilot.Models">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
            <TextBlock Text="Consignments" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="When a term lapses unnoticed, the gallery is storing - and insuring - work it may no longer have the right to sell. These clocks don't lapse silently." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="ConsignmentList" SelectionChanged="ConsignmentList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Consignment">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                            <Ellipse Width="12" Height="12" Fill="{x:Bind FlagBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="NewButton" Content="New consignment" Click="NewButton_Click" HorizontalAlignment="Left" />
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Consignment" FontSize="19" FontWeight="SemiBold" />
                <TextBlock x:Name="CoverText" TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="0" Header="Consignor" Margin="0,0,8,8" />
                    <ComboBox x:Name="KindBox" Grid.Row="0" Grid.Column="1" Header="Consignor kind" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                    <TextBox x:Name="ContactBox" Grid.Row="1" Grid.Column="0" Header="Contact" Margin="0,0,8,8" />
                    <TextBox x:Name="SplitBox" Grid.Row="1" Grid.Column="1" Header="Consignor split (%)" Margin="0,0,0,8" />
                    <CalendarDatePicker x:Name="StartPicker" Grid.Row="2" Grid.Column="0" Header="Term start" Margin="0,0,8,8" />
                    <CalendarDatePicker x:Name="EndPicker" Grid.Row="2" Grid.Column="1" Header="Term end" Margin="0,0,0,8" />
                    <ComboBox x:Name="StatusBox" Grid.Row="3" Grid.Column="0" Header="Status" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                    <TextBox x:Name="TermsBox" Grid.Row="3" Grid.Column="1" Header="Terms note" Margin="0,0,0,8" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save consignment" Click="SaveButton_Click" />
                    <Button x:Name="RenewButton" Content="Renew +6 months" Click="RenewButton_Click" />
                    <Button x:Name="StatementButton" Content="Export artist statement (HTML)" Click="StatementButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
