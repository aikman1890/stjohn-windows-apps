<Page
    x:Class="GalleryPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBox x:Name="GalleryBox" Header="Gallery name (prints on statements)" />
            <TextBox x:Name="AddressBox" Header="Address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
            <TextBox x:Name="PhoneBox" Header="Phone" />
            <TextBox x:Name="CurrencyBox" Header="Default currency (USD / EUR / GBP / CHF)" />
            <TextBox x:Name="TermsBox" Header="Artist payment terms after a sale (days)" />
            <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="SavedText" Opacity="0.75" />
            <TextBlock Text="GalleryPilot is the records core only: no website, no online viewing rooms, no e-commerce, no marketing email, no payments, and no accounting integration. It records provenance as the gallery enters it and offers no valuation, appraisal, or authentication opinions - records tool only. Collector identities and prices never leave this machine." Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
