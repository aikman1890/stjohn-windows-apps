<Page
    x:Class="GalleryPilot.Views.CollectorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
            <TextBlock Text="Collectors" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="This list is the business. It lives on this machine and nowhere else." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="CollectorList" SelectionChanged="CollectorList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="NewButton" Content="New collector" Click="NewButton_Click" HorizontalAlignment="Left" />
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Collector file" FontSize="19" FontWeight="SemiBold" />
                <TextBox x:Name="NameBox" Header="Name" />
                <TextBox x:Name="ContactBox" Header="Contact" />
                <TextBox x:Name="InterestsBox" Header="Interests" AcceptsReturn="True" TextWrapping="Wrap" Height="56" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="56" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Save collector" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                </StackPanel>
                <TextBlock Text="History (bought / offered / viewings)" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
                <ListView x:Name="HistoryList" SelectionMode="None" MaxHeight="180">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,3" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="KindBox" Header="Kind" Width="150" />
                    <TextBox x:Name="WorkLabelBox" Header="Work (artist - title)" Width="300" />
                    <TextBox x:Name="HistNoteBox" Header="Note" Width="240" />
                    <Button x:Name="HistButton" Content="Log" Click="HistButton_Click" VerticalAlignment="Bottom" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
