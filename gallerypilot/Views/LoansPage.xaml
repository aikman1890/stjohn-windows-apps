<Page
    x:Class="GalleryPilot.Views.LoansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GalleryPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Exhibitions &amp; loans" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="A loan closes only when both condition entries exist - out and in. That pair is the difference between a record and an argument." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="LoanList" SelectionChanged="LoanList_SelectionChanged" MaxHeight="230">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Loan">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid MaxWidth="860" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="WorkBox" Grid.Row="0" Grid.Column="0" Header="Work" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                <TextBox x:Name="BorrowerBox" Grid.Row="0" Grid.Column="1" Header="Borrower" Margin="0,0,0,8" />
                <TextBox x:Name="VenueBox" Grid.Row="1" Grid.Column="0" Header="Venue" Margin="0,0,8,8" />
                <CalendarDatePicker x:Name="StartPicker" Grid.Row="1" Grid.Column="1" Header="Loan start" Margin="0,0,0,8" />
                <CalendarDatePicker x:Name="DuePicker" Grid.Row="2" Grid.Column="0" Header="Return due" Margin="0,0,8,8" />
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                    <CheckBox x:Name="CondOutCheck" Content="Condition-out entry logged" />
                    <CheckBox x:Name="CondInCheck" Content="Condition-in entry logged" />
                </StackPanel>
                <TextBox x:Name="LoanNotesBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Header="Notes" Margin="0,0,0,8" />
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveLoanButton" Content="Save loan" Click="SaveLoanButton_Click" />
                    <Button x:Name="CloseLoanButton" Content="Mark returned &amp; close" Click="CloseLoanButton_Click" />
                    <Button x:Name="NewLoanButton" Content="New loan" Click="NewLoanButton_Click" />
                    <Button x:Name="DeleteLoanButton" Content="Delete" Click="DeleteLoanButton_Click" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Exhibitions" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,0" />
            <ListView x:Name="ExhibitionList" SelectionMode="None" MaxHeight="150">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Exhibition">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="ExTitleBox" Header="Exhibition title" Width="240" />
                <TextBox x:Name="ExVenueBox" Header="Venue" Width="180" />
                <TextBox x:Name="ExWorksBox" Header="Works included (note)" Width="280" />
                <Button x:Name="ExButton" Content="Add (6 weeks)" Click="ExButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
