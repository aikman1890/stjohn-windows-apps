<Page
    x:Class="GalleryPilot.Views.SalesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GalleryPilot.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Sales &amp; artist payables" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Recording a sale snapshots the consignment's split and starts the artist's payment clock. The artist's share is computed - never typed - so the payable can't be wrong in the gallery's favor by accident." Opacity="0.7" TextWrapping="Wrap" />
            <ListView x:Name="SaleList" SelectionChanged="SaleList_SelectionChanged" MaxHeight="280">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Sale">
                        <TextBlock Text="{x:Bind DisplayLine}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid MaxWidth="860" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="WorkBox" Grid.Row="0" Grid.Column="0" Header="Work sold" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                <ComboBox x:Name="CollectorBox" Grid.Row="0" Grid.Column="1" Header="Collector" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                <TextBox x:Name="PriceBox" Grid.Row="1" Grid.Column="0" Header="Sale price" Margin="0,0,8,8" />
                <TextBox x:Name="CurrencyBox" Grid.Row="1" Grid.Column="1" Header="Currency" Margin="0,0,0,8" />
                <CalendarDatePicker x:Name="DatePicker" Grid.Row="2" Grid.Column="0" Header="Sale date" Margin="0,0,8,8" />
                <TextBox x:Name="NoteBox" Grid.Row="2" Grid.Column="1" Header="Note" Margin="0,0,0,8" />
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RecordButton" Content="Record sale (creates the payable)" Click="RecordButton_Click" />
                    <Button x:Name="PayButton" Content="Mark selected paid today" Click="PayButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete selected" Click="DeleteButton_Click" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="OwedText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
