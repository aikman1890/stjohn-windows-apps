<Page
    x:Class="BizPilot.Views.ExpensesPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BizPilot.Models"
    xmlns:views="using:BizPilot.Views">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="1100">
            <TextBlock Text="Expenses" Style="{ThemeResource TitleTextBlockStyle}" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Add expense" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DatePicker Header="Date" Date="{x:Bind ViewModel.NewDate, Mode=TwoWay}" />
                        <ComboBox Grid.Column="1" Header="Category" IsEditable="True" Text="{x:Bind ViewModel.NewCategory, Mode=TwoWay}">
                            <x:String>General</x:String>
                            <x:String>Supplies</x:String>
                            <x:String>Travel</x:String>
                            <x:String>Meals</x:String>
                            <x:String>Software</x:String>
                            <x:String>Marketing</x:String>
                            <x:String>Utilities</x:String>
                            <x:String>Rent</x:String>
                            <x:String>Other</x:String>
                        </ComboBox>
                        <NumberBox Grid.Column="2" Header="Amount" Value="{x:Bind ViewModel.NewAmount, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline" />

                        <TextBox Grid.Row="1" Grid.ColumnSpan="2" Header="Description" Text="{x:Bind ViewModel.NewDescription, Mode=TwoWay}" PlaceholderText="What was this expense for?" />
                        <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom" Spacing="8">
                            <Button Content="Attach Receipt" Command="{x:Bind ViewModel.AttachReceiptCommand}" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{x:Bind ViewModel.ReceiptFileName, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <Button Content="Add Expense" Command="{x:Bind ViewModel.AddExpenseCommand}" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox Header="Month" ItemsSource="{x:Bind ViewModel.MonthNames, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedMonthIndex, Mode=TwoWay}" MinWidth="140" />
                <ComboBox Grid.Column="1" Header="Year" ItemsSource="{x:Bind ViewModel.Years, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.FilterYear, Mode=TwoWay}" MinWidth="110" />
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock Text="Month total" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock Text="{x:Bind ViewModel.MonthTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Spending by category" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <views:CategoryChart Items="{x:Bind ViewModel.CategoryTotals, Mode=OneWay}" />

            <TextBlock Text="Expenses" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.Expenses, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Expense">
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Date, Mode=OneWay, Converter={StaticResource DateConverter}}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Category}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Description}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Amount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <Button Grid.Column="4" Content="Delete" Command="{Binding DataContext.DeleteExpenseCommand, ElementName=RootPage}" CommandParameter="{Binding}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
