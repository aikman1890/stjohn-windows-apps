<Page
    x:Class="BizPilot.Views.ExpensesPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BizPilot.Models"
    xmlns:views="using:BizPilot.Views">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="1100">
            <TextBlock x:Uid="ExpensesPage_Expenses" Style="{ThemeResource TitleTextBlockStyle}" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="ExpensesPage_AddExpense" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DatePicker x:Uid="ExpensesPage_Date" Date="{x:Bind ViewModel.NewDate, Mode=TwoWay}" />
                        <ComboBox x:Uid="ExpensesPage_Category" Grid.Column="1" IsEditable="True" Text="{x:Bind ViewModel.NewCategory, Mode=TwoWay}">
                            <x:String x:Uid="ExpensesPage_General">General</x:String>
                            <x:String x:Uid="ExpensesPage_Supplies">Supplies</x:String>
                            <x:String x:Uid="ExpensesPage_Travel">Travel</x:String>
                            <x:String x:Uid="ExpensesPage_Meals">Meals</x:String>
                            <x:String x:Uid="ExpensesPage_Software">Software</x:String>
                            <x:String x:Uid="ExpensesPage_Marketing">Marketing</x:String>
                            <x:String x:Uid="ExpensesPage_Utilities">Utilities</x:String>
                            <x:String x:Uid="ExpensesPage_Rent">Rent</x:String>
                            <x:String x:Uid="ExpensesPage_Other">Other</x:String>
                        </ComboBox>
                        <NumberBox x:Uid="ExpensesPage_Amount" Grid.Column="2" Value="{x:Bind ViewModel.NewAmount, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline" />

                        <TextBox x:Uid="ExpensesPage_Description" Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.NewDescription, Mode=TwoWay}" />
                        <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom" Spacing="8">
                            <Button x:Uid="ExpensesPage_AttachReceipt" Command="{x:Bind ViewModel.AttachReceiptCommand}" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{x:Bind ViewModel.ReceiptFileName, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <Button x:Uid="ExpensesPage_AddExpense_2" Command="{x:Bind ViewModel.AddExpenseCommand}" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Uid="ExpensesPage_Month" ItemsSource="{x:Bind ViewModel.MonthNames, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedMonthIndex, Mode=TwoWay}" MinWidth="140" />
                <ComboBox x:Uid="ExpensesPage_Year" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Years, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.FilterYear, Mode=TwoWay}" MinWidth="110" />
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock x:Uid="ExpensesPage_MonthTotal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock Text="{x:Bind ViewModel.MonthTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <TextBlock x:Uid="ExpensesPage_SpendingByCategory" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <views:CategoryChart Items="{x:Bind ViewModel.CategoryTotals, Mode=OneWay}" />

            <TextBlock x:Uid="ExpensesPage_Expenses_2" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.Expenses, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Expense">
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Date, Mode=OneWay, Converter={StaticResource DateConverter}}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Category}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Description}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Amount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <Button x:Uid="ExpensesPage_Delete" Grid.Column="4" Command="{Binding DataContext.DeleteExpenseCommand, ElementName=RootPage}" CommandParameter="{Binding}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
