<Page
    x:Class="BizPilot.Views.InvoicesPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BizPilot.Models">

    <Grid Padding="24" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="InvoicesPage_Invoices" Style="{ThemeResource TitleTextBlockStyle}" />
        <Button x:Uid="InvoicesPage_NewInvoice" Grid.Column="1" Command="{x:Bind ViewModel.NewInvoiceCommand}" HorizontalAlignment="Right" />

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Invoices, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedInvoice, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Invoice">
                    <Grid Padding="8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind Number}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ClientName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Total, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind Status}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollViewer
            Grid.Row="1"
            Grid.Column="1"
            Visibility="{x:Bind ViewModel.SelectedInvoice, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel Spacing="12" MaxWidth="760">
                <ComboBox x:Uid="InvoicesPage_Client"
                    ItemsSource="{x:Bind ViewModel.Clients, Mode=OneWay}"
                    DisplayMemberPath="Name"
                    SelectedValuePath="Id"
                    SelectedValue="{x:Bind ViewModel.SelectedInvoice.ClientId, Mode=TwoWay}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Uid="InvoicesPage_InvoiceNumber" Text="{x:Bind ViewModel.SelectedInvoice.Number, Mode=TwoWay}" />
                    <ComboBox x:Uid="InvoicesPage_Status" Grid.Column="1" SelectedItem="{x:Bind ViewModel.SelectedInvoice.Status, Mode=TwoWay}">
                        <x:String x:Uid="InvoicesPage_Unpaid">Unpaid</x:String>
                        <x:String x:Uid="InvoicesPage_Paid">Paid</x:String>
                    </ComboBox>
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Uid="InvoicesPage_IssueDate" Date="{x:Bind ViewModel.SelectedInvoice.IssueDate, Mode=TwoWay}" />
                    <DatePicker x:Uid="InvoicesPage_DueDate" Grid.Column="1" Date="{x:Bind ViewModel.SelectedInvoice.DueDate, Mode=TwoWay}" />
                    <NumberBox x:Uid="InvoicesPage_TaxRate" Grid.Column="2" Value="{x:Bind ViewModel.SelectedInvoice.TaxRate, Mode=TwoWay}" Minimum="0" Maximum="1" SmallChange="0.0025" LargeChange="0.01" SpinButtonPlacementMode="Inline" />
                </Grid>

                <TextBox x:Uid="InvoicesPage_Notes" Text="{x:Bind ViewModel.SelectedInvoice.Notes, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="InvoicesPage_LineItems" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Button x:Uid="InvoicesPage_AddLine" Grid.Column="1" Command="{x:Bind ViewModel.AddLineCommand}" />
                </Grid>

                <ListView ItemsSource="{x:Bind ViewModel.SelectedInvoice.Lines, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:InvoiceLine">
                            <Grid Padding="4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="InvoicesPage_Description" Text="{x:Bind Description, Mode=TwoWay}" />
                                <NumberBox x:Uid="InvoicesPage_Qty" Grid.Column="1" Value="{x:Bind Qty, Mode=TwoWay}" Minimum="0" />
                                <NumberBox x:Uid="InvoicesPage_UnitPrice" Grid.Column="2" Value="{x:Bind UnitPrice, Mode=TwoWay}" Minimum="0" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Amount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <Button x:Uid="InvoicesPage_Remove" Grid.Column="4" Command="{Binding DataContext.RemoveLineCommand, ElementName=RootPage}" CommandParameter="{Binding}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid HorizontalAlignment="Right" ColumnSpacing="16" RowSpacing="4" MinWidth="280">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="InvoicesPage_Subtotal" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedInvoice.Subtotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" />
                    <TextBlock x:Uid="InvoicesPage_Tax" Grid.Row="1" HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedInvoice.Tax, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" />
                    <TextBlock x:Uid="InvoicesPage_Total" Grid.Row="2" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedInvoice.Total, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Uid="InvoicesPage_SaveInvoice" Command="{x:Bind ViewModel.SaveInvoiceCommand}" Style="{ThemeResource AccentButtonStyle}" />
                    <Button x:Uid="InvoicesPage_MarkPaid" Command="{x:Bind ViewModel.MarkPaidCommand}" />
                    <Button x:Uid="InvoicesPage_MarkUnpaid" Command="{x:Bind ViewModel.MarkUnpaidCommand}" />
                    <Button x:Uid="InvoicesPage_ExportPDF" Command="{x:Bind ViewModel.ExportPdfCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
