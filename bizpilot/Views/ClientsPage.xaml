<Page
    x:Class="BizPilot.Views.ClientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BizPilot.Models">

    <Grid Padding="24" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Clients" Style="{ThemeResource TitleTextBlockStyle}" />
        <Button Grid.Column="1" Content="New Client" Command="{x:Bind ViewModel.NewClientCommand}" HorizontalAlignment="Right" />

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Clients, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedClient, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Client">
                    <StackPanel Padding="8">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Company}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollViewer
            Grid.Row="1"
            Grid.Column="1"
            Visibility="{x:Bind ViewModel.SelectedClient, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel Spacing="12" MaxWidth="520">
                <TextBox Header="Name" Text="{x:Bind ViewModel.SelectedClient.Name, Mode=TwoWay}" PlaceholderText="Full name" />
                <TextBox Header="Company" Text="{x:Bind ViewModel.SelectedClient.Company, Mode=TwoWay}" PlaceholderText="Company (optional)" />
                <TextBox Header="Email" Text="{x:Bind ViewModel.SelectedClient.Email, Mode=TwoWay}" PlaceholderText="name@example.com" InputScope="EmailSmtpAddress" />
                <TextBox Header="Phone" Text="{x:Bind ViewModel.SelectedClient.Phone, Mode=TwoWay}" PlaceholderText="(555) 000-0000" InputScope="TelephoneNumber" />
                <TextBox Header="Notes" Text="{x:Bind ViewModel.SelectedClient.Notes, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save Client" Command="{x:Bind ViewModel.SaveClientCommand}" Style="{ThemeResource AccentButtonStyle}" />
                    <Button Content="Delete" Command="{x:Bind ViewModel.DeleteClientCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
