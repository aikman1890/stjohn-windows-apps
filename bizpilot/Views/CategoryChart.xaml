<UserControl
    x:Class="BizPilot.Views.CategoryChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:BizPilot.ViewModels">

    <ItemsControl ItemsSource="{x:Bind Items, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="viewmodels:CategoryTotal">
                <Grid Margin="0,5" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Category}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border
                        Grid.Column="1"
                        Height="18"
                        CornerRadius="4"
                        HorizontalAlignment="Left"
                        Width="{x:Bind BarWidth, Mode=OneWay}"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind Total, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
