<Page
    x:Class="BizPilot.Views.AiToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="800">
            <TextBlock x:Uid="AiToolsPage_AITools" Style="{ThemeResource TitleTextBlockStyle}" />
            <InfoBar IsOpen="True" Severity="Informational" Message="{x:Bind ViewModel.AiStatusMessage, Mode=OneWay}" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="AiToolsPage_ClientEmailDrafter" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="AiToolsPage_EnterTheKeyPointsAnd" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <TextBox x:Uid="AiToolsPage_KeyPointsOnePerLine" Text="{x:Bind ViewModel.EmailBullets, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
                    <ComboBox x:Uid="AiToolsPage_Tone" ItemsSource="{x:Bind ViewModel.Tones, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.EmailTone, Mode=TwoWay}" MinWidth="200" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Uid="AiToolsPage_GenerateEmail"
                            Command="{x:Bind ViewModel.GenerateEmailCommand}"
                            IsEnabled="{x:Bind ViewModel.IsAiAvailable, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.AiStatusMessage, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" />
                    </StackPanel>
                    <TextBox x:Uid="AiToolsPage_Draft" Text="{x:Bind ViewModel.GeneratedEmail, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="AiToolsPage_MeetingNotesSummarizer" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="AiToolsPage_PasteRawMeetingNotesThe" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <TextBox x:Uid="AiToolsPage_MeetingNotes" Text="{x:Bind ViewModel.MeetingNotes, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Uid="AiToolsPage_Summarize"
                            Command="{x:Bind ViewModel.SummarizeCommand}"
                            IsEnabled="{x:Bind ViewModel.IsAiAvailable, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.AiStatusMessage, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" />
                    </StackPanel>
                    <TextBox x:Uid="AiToolsPage_Summary" Text="{x:Bind ViewModel.MeetingSummary, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
