<Page
    x:Class="BizPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="640">
            <TextBlock x:Uid="SettingsPage_Settings" Style="{ThemeResource TitleTextBlockStyle}" />

            <TextBlock x:Uid="SettingsPage_BusinessProfile" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock x:Uid="SettingsPage_ThisInformationAppearsOnEver" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />

            <TextBox x:Uid="SettingsPage_BusinessName" Text="{x:Bind ViewModel.BusinessName, Mode=TwoWay}" />
            <TextBox x:Uid="SettingsPage_Address" Text="{x:Bind ViewModel.Address, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />
            <TextBox x:Uid="SettingsPage_Email" Text="{x:Bind ViewModel.Email, Mode=TwoWay}" InputScope="EmailSmtpAddress" />
            <TextBox x:Uid="SettingsPage_Phone" Text="{x:Bind ViewModel.Phone, Mode=TwoWay}" InputScope="TelephoneNumber" />
            <NumberBox x:Uid="SettingsPage_DefaultTaxRate" Value="{x:Bind ViewModel.TaxRate, Mode=TwoWay}" Minimum="0" Maximum="1" SmallChange="0.0025" LargeChange="0.01" SpinButtonPlacementMode="Inline" />
            <Button x:Uid="SettingsPage_SaveProfile" Command="{x:Bind ViewModel.SaveProfileCommand}" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left" />

            <TextBlock x:Uid="SettingsPage_OnDeviceAI" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <TextBlock Text="{x:Bind ViewModel.AiStatus, Mode=OneWay}" TextWrapping="Wrap" />
            <Button x:Uid="SettingsPage_CheckAIStatus" Command="{x:Bind ViewModel.RefreshAiCommand}" HorizontalAlignment="Left" />

            <TextBlock Text="License" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <TextBlock x:Name="LicenseStatusText" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBox x:Name="LicenseKeyBox" Header="License key" PlaceholderText="XXXXX-XXXXX-XXXXX-XXXXX" />
            <TextBox x:Name="LicenseEmailBox" Header="Purchase email" PlaceholderText="you@example.com" InputScope="EmailSmtpAddress" />
            <Button Content="Activate" Click="ActivateLicense_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="LicenseResultText" TextWrapping="Wrap" />

            <TextBlock Text="Have an idea for a new feature? That's the way to get it built — the only legitimate path to new features." Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" TextWrapping="Wrap" />
            <HyperlinkButton Content="Request a feature" NavigateUri="https://github.com/aikman1890/stjohn-windows-apps/issues/new?template=feature_request.md&amp;title=%5BBizPilot%5D%20" />
            <HyperlinkButton Content="or email us instead" NavigateUri="mailto:aikman1892@gmail.com?subject=Feature%20request%20-%20BizPilot" />
        </StackPanel>
    </ScrollViewer>
</Page>
