<?xml version="1.0" encoding="UTF-8"?>
<!--
  BizPilot MSI installer — WiX Toolset v5, per-user (no admin / no UAC).
  Installs to %LOCALAPPDATA%\Programs\St. John Pictures\BizPilot.

  The <ComponentGroupRef Id="AppFiles" /> below is satisfied by Files.wxs,
  which the build workflow generates from publish\bizpilot\\** (one component
  per file, deterministic GUIDs) so EVERY published file ships in the MSI:
  exe, dlls, Assets, resources.pri (100 languages), Assets\Voice\vd.dat
  (wuse/DayPilot), integrity.manifest, License.txt.

  Build (on Windows):
    wix build bizpilot.wxs Files.wxs -arch x64 -ext WixToolset.UI.wixext -o ..\..\bizpilot-Setup.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="BizPilot"
           Language="1033"
           Version="1.0.0"
           Manufacturer="St. John Pictures"
           ProductCode="E4B1BE2E-854D-4567-8148-C44D4A9D830D"
           UpgradeCode="AD32C7F2-F4DF-4073-A5F8-2BBF9FB8130F"
           Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of BizPilot is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs entries -->
    <Property Id="ARPPRODUCTICON" Value="[INSTALLFOLDER]BizPilot.exe" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://aikman1890.github.io/stjohn-windows-apps/bizpilot.html" />

    <!-- Minimal wizard UI (welcome / progress / finish). Silent install: msiexec /i bizpilot-Setup.msi /quiet -->
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- Per-user install folder: %LOCALAPPDATA%\Programs\St. John Pictures\BizPilot -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="CompanyDir" Name="St. John Pictures">
          <Directory Id="INSTALLFOLDER" Name="BizPilot" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Start Menu shortcut (per-user, non-advertised) -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutsDir" Name="BizPilot">
        <Component Id="StartMenuShortcut" Guid="95F4763F-2E00-4028-84C5-C95C4D11BC47" Bitness="always64">
          <Shortcut Id="AppStartMenuShortcut"
                    Name="BizPilot"
                    Description="BizPilot — AI business copilot"
                    Target="[INSTALLFOLDER]BizPilot.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppShortcutsDir" Directory="AppShortcutsDir" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\St. John Pictures\BizPilot"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="BizPilot" Level="1">
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
</Wix>
