<Page
    x:Class="VenuePilot.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Season reports" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" FontSize="15" TextWrapping="Wrap" />
            <TextBlock Text="Revenue by month (contracted + completed, package value)" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListView x:Name="MonthList" SelectionMode="None" MaxHeight="260">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Events by type" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListView x:Name="TypeList" SelectionMode="None" MaxHeight="220">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Inquiry pipeline" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" />
            <TextBlock x:Name="FunnelText" TextWrapping="Wrap" />
            <ListView x:Name="InquiryList" SelectionMode="None" MaxHeight="280">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLine}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
