<Page
    x:Class="VenuePilot.Views.DateBookPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10">
            <TextBlock Text="Date book" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="One calendar for every space - the version three family members can't fork. Contracted dates own their space; holds show their expiry." Opacity="0.8" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <DatePicker x:Name="MonthPicker" Header="Jump to month" DateChanged="MonthPicker_DateChanged" />
                <Button x:Name="PrevButton" Content="Previous month" Click="PrevButton_Click" VerticalAlignment="Bottom" />
                <Button x:Name="NextButton" Content="Next month" Click="NextButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="MonthText" FontSize="18" FontWeight="SemiBold" />
            <ListView x:Name="BookList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" Padding="4,3" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
