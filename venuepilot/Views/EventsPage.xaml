<Page
    x:Class="VenuePilot.Views.EventsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="Event file" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="ClientBox" Header="Client names" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="PhoneBox" Header="Phone" Width="180" />
                    <TextBox x:Name="EmailBox" Header="Email" Width="200" />
                </StackPanel>
                <ComboBox x:Name="SpacePicker" Header="Space" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="TypeCombo" Header="Event type" IsEditable="True" HorizontalAlignment="Stretch" />
                <DatePicker x:Name="DatePickerCtl" Header="Event date" />
                <ComboBox x:Name="StatusCombo" Header="Status" HorizontalAlignment="Stretch">
                    <x:String>Inquiry</x:String>
                    <x:String>Hold</x:String>
                    <x:String>Contracted</x:String>
                    <x:String>Completed</x:String>
                    <x:String>Cancelled</x:String>
                </ComboBox>
                <DatePicker x:Name="HoldPicker" Header="Hold expiry (for holds)" />
                <ComboBox x:Name="PackagePicker" Header="Package (rate card)" HorizontalAlignment="Stretch" SelectionChanged="PackagePicker_SelectionChanged" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="PriceBox" Header="Package price $" Width="160" />
                    <TextBox x:Name="GuestsBox" Header="Guests" Width="100" />
                </StackPanel>
                <DatePicker x:Name="BalancePicker" Header="Balance due date" />
                <CheckBox x:Name="BalanceCheck" Content="Balance due date set" Checked="BalanceCheck_Changed" Unchecked="BalanceCheck_Changed" />
                <TextBox x:Name="SourceBox" Header="Inquiry source (referral, drive-by, social...)" />
                <TextBox x:Name="LoadBox" Header="Load-in / load-out (e.g. Fri 4 PM / Sun 11 AM)" />
                <TextBox x:Name="TimelineBox" Header="Timeline notes (ceremony, reception...)" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                <TextBox x:Name="CancelBox" Header="Cancellation reason (if cancelled)" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="Add / Save" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock x:Name="GuardText" TextWrapping="Wrap" FontWeight="SemiBold" />

                <TextBlock Text="Payments" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="PayAmountBox" Header="Amount $" Width="130" />
                    <ComboBox x:Name="PayKindCombo" Header="Kind" Width="150">
                        <x:String>Deposit</x:String>
                        <x:String>Milestone</x:String>
                        <x:String>Final</x:String>
                        <x:String>Refund</x:String>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PayButton" Content="Record payment today" Click="PayButton_Click" />
                    <Button x:Name="DaySheetButton" Content="Export day-of sheet" Click="DaySheetButton_Click" />
                </StackPanel>
                <ListView x:Name="PaymentsList" SelectionMode="None" MaxHeight="160">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="MoneyText" TextWrapping="Wrap" Opacity="0.85" />

                <TextBlock Text="Vendors" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="VendorRoleBox" Header="Role" Width="130" />
                    <TextBox x:Name="VendorNameBox" Header="Name" Width="180" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="VendorPhoneBox" Header="Phone" Width="160" />
                    <TextBox x:Name="VendorArrivalBox" Header="Arrival" Width="120" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="VendorButton" Content="Add vendor" Click="VendorButton_Click" />
                    <Button x:Name="VendorDelButton" Content="Remove selected" Click="VendorDelButton_Click" />
                </StackPanel>
                <ListView x:Name="VendorsList" MaxHeight="180">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" Padding="2,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <ListView x:Name="ItemsList" Grid.Column="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" Padding="4,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
