<Page
    x:Class="VenuePilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBox x:Name="VenueBox" Header="Venue name (prints on day-of sheets)" />
            <TextBox x:Name="AddressBox" Header="Venue address" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
            <TextBox x:Name="PhoneBox" Header="Venue phone" />
            <TextBlock Text="Bookable spaces (one per line - all included, no per-space fees, ever)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="SpacesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
            <TextBlock Text="Rate card - one per line: Package|Price|Season note (quotes stay consistent whoever answers the phone)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="PackagesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
            <TextBlock Text="Event types (one per line)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="TypesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
            <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="SavedText" Opacity="0.75" />
            <TextBlock Text="Everything is stored locally in this app's folder - no account, no cloud, no telemetry. Works fully offline, including on rural internet." Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
